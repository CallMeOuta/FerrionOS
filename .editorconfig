# Conventions the tree already follows. Patch files are exempt.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# make requires tabs in recipe lines
[{Makefile,*.mk}]
indent_style = tab

[*.nix]
indent_size = 2

# Trailing spaces can be a Markdown line break
[*.md]
trim_trailing_whitespace = false

# Patches against third-party sources are byte-exact: context lines keep
# their trailing whitespace, tabs and line endings.
[*.patch]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
