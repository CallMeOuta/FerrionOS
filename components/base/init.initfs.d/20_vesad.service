[unit]
description = "Bootloader framebuffer handler"
requires_weak = ["10_inputd.service"]

[service]
cmd = "vesad"
inherit_envs = [
    "FRAMEBUFFER_ADDR",
    "FRAMEBUFFER_WIDTH",
    "FRAMEBUFFER_HEIGHT",
    "FRAMEBUFFER_STRIDE",
]
type = "notify"
# Maps the bootloader's framebuffer from physical memory.
hardware = true
