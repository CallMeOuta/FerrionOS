index 0000000..204fd95
--- /dev/null
+++ b/tests/tar.rs
@@ -0,0 +1,40 @@
+extern crate assert_cmd;
+extern crate tempfile;
+
+use assert_cmd::Command;
+use std::fs;
+use tempfile::tempdir;
+
+#[test]
+fn gzip_round_trip_with_directory_and_relative_archive() {
+    let work = tempdir().unwrap();
+    let root = work.path();
+    fs::create_dir_all(root.join("input/empty")).unwrap();
+    fs::create_dir(root.join("output")).unwrap();
+    fs::write(root.join("input/message"), b"archive payload\n").unwrap();
+    fs::write(root.join("second"), b"second payload\n").unwrap();
+    Command::cargo_bin("tar").unwrap().current_dir(root)
+        .args(&["-czf", "bundle.tar.gz", "-C", "input", ".", "-C", "..", "second"])
+        .assert().success();
+    let archive = fs::read(root.join("bundle.tar.gz")).unwrap();
+    assert_eq!(&archive[..2], &[0x1f, 0x8b]);
+    Command::cargo_bin("tar").unwrap().current_dir(root)
+        .args(&["-xzf", "bundle.tar.gz", "-C", "output"])
+        .assert().success();
+    assert_eq!(fs::read(root.join("output/message")).unwrap(), b"archive payload\n");
+    assert_eq!(fs::read(root.join("output/second")).unwrap(), b"second payload\n");
+    assert!(root.join("output/empty").is_dir());
+}
+
+#[test]
+fn gzip_standard_streams_and_legacy_flags() {
+    let work = tempdir().unwrap();
+    fs::write(work.path().join("message"), b"stream payload\n").unwrap();
+    let output = Command::cargo_bin("tar").unwrap().current_dir(work.path())
+        .args(&["czf", "-", "message"]).output().unwrap();
+    assert!(output.status.success());
+    assert_eq!(&output.stdout[..2], &[0x1f, 0x8b]);
+    Command::cargo_bin("tar").unwrap()
+        .args(&["-tzf", "-"]).write_stdin(output.stdout)
+        .assert().success().stdout("message\n");
+}
