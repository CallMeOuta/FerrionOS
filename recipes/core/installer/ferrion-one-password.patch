diff -ruN '--exclude=.git' '--exclude=*.orig' a/src/config/general.rs b/src/config/general.rs
--- a/src/config/general.rs
+++ b/src/config/general.rs
@@ -1,3 +1,78 @@
+use anyhow::{bail, Result};
+
+const MAX_ACCOUNT_LEN: usize = 32;
+
+pub fn valid_account_name(name: &str) -> bool {
+    !name.is_empty()
+        && name != "root"
+        && name.len() <= MAX_ACCOUNT_LEN
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-_.".contains(&b))
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub enum DiskEncryption {
+    #[default]
+    Off,
+    Password {
+        secret: String,
+        unlock_account: Option<String>,
+    },
+}
+
+impl DiskEncryption {
+    pub fn is_on(&self) -> bool {
+        matches!(self, DiskEncryption::Password { .. })
+    }
+
+    pub fn secret(&self) -> Option<&str> {
+        match self {
+            DiskEncryption::Off => None,
+            DiskEncryption::Password { secret, .. } => Some(secret.as_str()),
+        }
+    }
+
+    pub fn unlock_account(&self) -> Option<&str> {
+        match self {
+            DiskEncryption::Off => None,
+            DiskEncryption::Password { unlock_account, .. } => unlock_account.as_deref(),
+        }
+    }
+}
+
+impl TryFrom<&GeneralConfig> for DiskEncryption {
+    type Error = anyhow::Error;
+
+    fn try_from(general: &GeneralConfig) -> Result<Self> {
+        match (
+            general.encrypt_disk.as_deref(),
+            general.unlock_account.as_deref(),
+            general.install_unencrypted,
+        ) {
+            (Some(""), _, _) => bail!("encrypt_disk must not be empty"),
+            (Some(_), _, Some(true)) => {
+                bail!("encrypt_disk cannot be combined with install_unencrypted = true")
+            }
+            (None, Some(_), _) => bail!("unlock_account requires encrypt_disk"),
+            (None, None, _) => Ok(DiskEncryption::Off),
+            (Some(secret), Some(account), _) => {
+                if !valid_account_name(account) {
+                    bail!("invalid unlock_account '{account}'");
+                }
+                Ok(DiskEncryption::Password {
+                    secret: secret.to_string(),
+                    unlock_account: Some(account.to_string()),
+                })
+            }
+            (Some(secret), None, _) => Ok(DiskEncryption::Password {
+                secret: secret.to_string(),
+                unlock_account: None,
+            }),
+        }
+    }
+}
+
