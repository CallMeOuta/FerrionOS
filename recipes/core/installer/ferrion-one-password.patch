+pub const UNLOCK_SLOTS_FILE: &str = "/etc/unlock-slots";
+
 impl Config {
     /// Serialize the installed configuration without the disk-unlock secret.
     /// Explicit host configuration exports use the ordinary serializer instead.
+    pub fn disk_encryption(&self) -> Result<general::DiskEncryption> {
+        let encryption = general::DiskEncryption::try_from(&self.general)?;
+        if let general::DiskEncryption::Password {
+            unlock_account: Some(account),
+            ..
+        } = &encryption
+        {
+            assert!(
+                self.users.contains_key(account),
+                "unlock_account '{account}' is not a configured user"
+            );
+        }
+        Ok(encryption)
+    }
+
+    pub fn set_disk_encryption(&mut self, encryption: &general::DiskEncryption) {
+        match encryption {
+            general::DiskEncryption::Off => {
+                self.general.encrypt_disk = None;
+                self.general.unlock_account = None;
+            }
+            general::DiskEncryption::Password {
+                secret,
+                unlock_account,
+            } => {
+                assert!(!secret.is_empty());
+                self.general.encrypt_disk = Some(secret.clone());
+                self.general.unlock_account = unlock_account.clone();
+                if let Some(account) = unlock_account {
+                    assert!(general::valid_account_name(account));
+                    self.users.entry(account.clone()).or_default().password = Some(secret.clone());
+                    assert!(self.users.contains_key(account));
+                }
+            }
+        }
+    }
+
     pub fn filesystem_toml(&mut self) -> Result<String> {
-        let password = self.general.encrypt_disk.take();
-        let result = toml::to_string_pretty(self);
-        self.general.encrypt_disk = password;
-        Ok(result?)
+        let mut installed = self.clone();
+        let unlock_account = installed.general.unlock_account.take();
+        let had_secret = installed.general.encrypt_disk.take().is_some();
+        if had_secret {
+            if let Some(account) = unlock_account.as_deref() {
+                if let Some(user) = installed.users.get_mut(account) {
+                    user.password = None;
+                }
+            }
+        }
+        Ok(toml::to_string_pretty(&installed)?)
+    }
+
+    pub fn one_password(&mut self, account: &str, password: &str) {
+        self.set_disk_encryption(&general::DiskEncryption::Password {
+            secret: password.to_string(),
+            unlock_account: Some(account.to_string()),
+        });
+    }
+
+    pub fn unlock_slots_file(&self) -> Result<Option<file::FileConfig>> {
+        match self.disk_encryption()? {
+            general::DiskEncryption::Password {
+                unlock_account: Some(account),
+                ..
+            } => {
+                assert!(self.users.contains_key(&account));
+                let mut file = file::FileConfig::new_file(
+                    UNLOCK_SLOTS_FILE.to_string(),
+                    format!("0 {account}\n"),
+                );
+                file.with_mod(0o600, 0, 0);
+                Ok(Some(file))
+            }
+            _ => Ok(None),
+        }
     }
 
     /// Load installer config from a TOML path
