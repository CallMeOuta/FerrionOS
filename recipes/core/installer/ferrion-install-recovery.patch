+/// FerrionOS: add a recovery key in its own slot once the target is closed, and show it once.
+fn finish<F: FnMut(Message)>(
+    f: &mut F,
+    disk_path: &str,
+    password_opt: Option<&str>,
+    description: String,
+) {
+    let Some(password) = password_opt else {
+        f(Message::Success(description));
+        return;
+    };
+    match add_recovery_key(disk_path, password) {
+        Ok(key) => f(Message::Recovery(key, description)),
+        Err(err) => f(Message::Error(format!(
+            "Recovery key creation failed; installation is not complete: {err:#}"
+        ))),
+    }
+}
+
+fn add_recovery_key(disk_path: &str, password: &str) -> anyhow::Result<String> {
+    let mut child = std::process::Command::new("redoxfs-key")
+        .args(["add", "--recovery", "--key-file", "-", disk_path])
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .map_err(|err| format_err!("could not start redoxfs-key: {err}"))?;
+    // Taking and dropping the pipe closes stdin even if writing fails.
+    let sent = child.stdin.take().unwrap().write_all(password.as_bytes());
+    let output = child.wait_with_output()?;
+    sent?;
+    if !output.status.success() {
+        return Err(format_err!("redoxfs-key exited with {}", output.status));
+    }
+    String::from_utf8(output.stdout)?
+        .lines()
+        .find_map(|line| line.split_once("): ").map(|(_, key)| key.to_string()))
+        .ok_or_else(|| format_err!("redoxfs-key printed no recovery key"))
+}
