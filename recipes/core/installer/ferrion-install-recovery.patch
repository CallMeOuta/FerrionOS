+fn encryption_password(config: &Config) -> Result<Option<String>> {
+    if config.general.install_unencrypted == Some(true) {
+        eprintln!("Disk encryption is disabled by the installation configuration.");
+        return Ok(None);
+    }
+
+    loop {
+        eprint!("Encrypt this disk? [Y/n]: ");
+        io::stderr().flush()?;
+        let mut answer = String::new();
+        if io::stdin().read_line(&mut answer)? == 0 {
+            bail!("Installation cancelled: end of input");
+        }
+        match answer.trim().to_ascii_lowercase().as_str() {
+            "" | "y" | "yes" => break,
+            "n" | "no" => {
+                eprintln!("Anyone with this disk will be able to read its files.");
+                return Ok(None);
+            }
+            _ => eprintln!("Enter yes or no."),
+        }
+    }
+
+    redox_installer::require_seeded_random()?;
+    let password = redox_installer::prompt_password("Disk passphrase: ", "Confirm passphrase: ")?
+        .context("A nonempty passphrase is required for disk encryption")?;
+    eprintln!();
+    Ok(Some(password))
+}
+
+fn add_recovery_key(disk_path: &Path, password: &[u8]) -> Result<()> {
+    eprintln!("Save the recovery key below somewhere other than this disk.");
+    eprintln!("It will be shown once. To unlock at startup, type all 48 digits without spaces.");
+    io::stderr().flush()?;
+    let mut child = process::Command::new("redoxfs-key")
+        .args(["add", "--recovery", "--key-file", "-"])
+        .arg(disk_path)
+        .stdin(process::Stdio::piped())
+        .spawn()
+        .context("Could not start redoxfs-key to create the recovery key")?;
+    // Taking and dropping the pipe closes stdin even if writing fails.
+    let sent = child.stdin.take().unwrap().write_all(password);
+    let status = child.wait().context("Could not wait for redoxfs-key")?;
+    sent.context("Could not send the disk passphrase to redoxfs-key")?;
+    if !status.success() {
+        bail!("Recovery key creation failed; installation is not complete");
+    }
+    loop {
+        eprint!("Type SAVED after saving your recovery key: ");
+        io::stderr().flush()?;
+        let mut answer = String::new();
+        if io::stdin().read_line(&mut answer)? == 0 {
+            bail!("Recovery key was not acknowledged; do not reboot until you have saved it");
+        }
+        if answer.trim() == "SAVED" {
+            return Ok(());
+        }
+    }
+}
