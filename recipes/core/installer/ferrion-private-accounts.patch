+fn hash_stdin_password() -> anyhow::Result<()> {
+    const MAX_PASSWORD_BYTES: usize = 4096;
+    let stdin = io::stdin();
+    if stdin.is_terminal() {
+        anyhow::bail!("--hash-password requires non-terminal stdin");
+    }
+    let mut bytes = [0u8; MAX_PASSWORD_BYTES + 1];
+    let mut input = stdin.lock().take(bytes.len() as u64);
+    let mut length = 0;
+    while length < bytes.len() {
+        match input.read(&mut bytes[length..]) {
+            Ok(0) => break,
+            Ok(count) => length += count,
+            Err(_) => anyhow::bail!("Could not read password from stdin"),
+        }
+    }
+    if length == 0 || length > MAX_PASSWORD_BYTES {
+        anyhow::bail!("Password must contain 1 to 4096 UTF-8 bytes");
+    }
+    let password = std::str::from_utf8(&bytes[..length])
+        .map_err(|_| anyhow::anyhow!("Password must be UTF-8"))?;
+    let hash = redox_installer::hash_password(password)
+        .map_err(|_| anyhow::anyhow!("Could not hash password"))?;
+    println!("{hash}");
+    Ok(())
+}
+
 fn main() {
+    if env::args_os().any(|arg| arg == "--hash-password") {
+        if env::args_os().len() != 2 {
+            eprintln!("installer: --hash-password must be used alone");
+            process::exit(1);
+        }
+        if let Err(err) = hash_stdin_password() {
+            eprintln!("installer: {err}");
+            process::exit(1);
+        }
+        return;
+    }
     let mut parser = ArgParser::new(4)
         .add_opt("b", "cookbook")
         .add_opt("", "config-name")
