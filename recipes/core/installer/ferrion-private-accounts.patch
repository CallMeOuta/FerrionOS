+impl UserConfig {
+    pub(crate) fn validate_password(&self) -> anyhow::Result<()> {
+        const MAX_ENCODED_HASH_BYTES: usize = 512;
+        const MAX_MEMORY_KIB: u32 = 262144;
+        const MAX_TIME_COST: u32 = 10;
+        const MAX_PARALLELISM: u32 = 16;
+        if self.password.is_some() && self.password_hash.is_some() {
+            anyhow::bail!("password and password_hash are mutually exclusive");
+        }
+        if let Some(encoded) = &self.password_hash {
+            let invalid = || anyhow::anyhow!("invalid or unsupported Argon2 password_hash");
+            if encoded.is_empty() || encoded.len() > MAX_ENCODED_HASH_BYTES {
+                return Err(invalid());
+            }
+            let hash = password_hash::PasswordHash::new(encoded).map_err(|_| invalid())?;
+            if !matches!(hash.algorithm.as_str(), "argon2d" | "argon2i" | "argon2id")
+                || !matches!(hash.version, None | Some(16) | Some(19))
+                || !hash.params.iter().map(|(name, _)| name.as_str()).eq(["m", "t", "p"])
+            {
+                return Err(invalid());
+            }
+            let memory = hash.params.get_decimal("m").ok_or_else(invalid)?;
+            let time = hash.params.get_decimal("t").ok_or_else(invalid)?;
+            let lanes = hash.params.get_decimal("p").ok_or_else(invalid)?;
+            if !(1..=MAX_PARALLELISM).contains(&lanes)
+                || !(8 * lanes..=MAX_MEMORY_KIB).contains(&memory)
+                || !(1..=MAX_TIME_COST).contains(&time)
+            {
+                return Err(invalid());
+            }
+            let mut salt = [0u8; 64];
+            let salt = hash.salt.ok_or_else(invalid)?
+                .decode_b64(&mut salt).map_err(|_| invalid())?;
+            if salt.len() < 8 || hash.hash.as_ref().is_none_or(|output| output.len() < 16) {
+                return Err(invalid());
+            }
+        }
+        Ok(())
+    }
 }
 
