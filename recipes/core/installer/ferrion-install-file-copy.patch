+/// Ends the mount `with_redoxfs_mount` made in this process. `redoxfs::unmount_path` removes
+/// `/scheme/<name>` through the mounted scheme itself, which this redoxfs answers with
+/// EOPNOTSUPP on FerrionOS. Instead the mount loop is told to stop, and the scheme leaves this
+/// process's namespace through the namespace manager: closing the namespace's handle on the
+/// scheme wakes the loop, which then flushes the filesystem and returns.
+#[cfg(target_os = "redox")]
+fn unmount_redoxfs(mount_path: &str) -> Result<()> {
+    use std::sync::atomic::Ordering;
+    use syscall::CallFlags;
+    // StdFsCallKind::Unlinkat. redox_syscall 0.9.5 names it; the 0.9.4 that the graphical
+    // installer's Cargo.lock pins keeps the number without a name.
+    const UNLINKAT: u64 = 10;
+
+    redoxfs::IS_UMT.store(1, Ordering::SeqCst);
+    let namespace = libredox::call::getns()?;
+    let path = format!("/scheme/{mount_path}");
+    libredox::call::call_wo(
+        namespace,
+        path.as_bytes(),
+        CallFlags::STD_FS | CallFlags::WRITE,
+        &[UNLINKAT, 0, 0],
+    )?;
+    Ok(())
+}
 
