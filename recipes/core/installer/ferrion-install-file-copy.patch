+struct Mounted {
+    join: thread::JoinHandle<()>,
+    path: PathBuf,
+}
+
+impl Mounted {
+    fn finish<T>(self, res: Result<T>) -> Result<T> {
+        let unmount_res = unmount_redoxfs(self.path.as_os_str().to_str().unwrap());
+        if unmount_res.is_ok() {
+            self.join.join().unwrap();
+            #[cfg(target_os = "redox")]
+            redoxfs::IS_UMT.store(0, std::sync::atomic::Ordering::SeqCst);
+            #[cfg(not(target_os = "redox"))]
+            if let Err(err) = fs::remove_dir_all(&self.path) {
+                return match res {
+                    Err(install_err) => {
+                        Err(anyhow::anyhow!("{install_err:#}; cleanup failed: {err}"))
+                    }
+                    Ok(_) => Err(err.into()),
+                };
+            }
+        }
+        match (res, unmount_res) {
+            (Err(install_err), Ok(())) => Err(install_err),
+            (Err(install_err), Err(unmount_err)) => {
+                Err(anyhow::anyhow!("{install_err:#}; unmount failed: {unmount_err:#}"))
+            }
+            (Ok(_), Err(unmount_err)) => Err(unmount_err),
+            (Ok(value), Ok(())) => Ok(value),
+        }
+    }
+}
