--- a/src/installer.rs
+++ b/src/installer.rs
@@ -442,6 +442,42 @@
         }
     }
 
+    let schemas_dir = output_dir.join("usr/share/glib-2.0/schemas");
+    if schemas_dir.is_dir() {
+        const MAX_SCHEMA_ENTRIES: usize = 4096;
+        let mut schema_count = 0usize;
+        let mut entry_count = 0usize;
+        for entry in fs::read_dir(&schemas_dir)? {
+            entry_count += 1;
+            if entry_count > MAX_SCHEMA_ENTRIES {
+                bail!("GSettings schema directory exceeds limit of {MAX_SCHEMA_ENTRIES} entries");
+            }
+            let name = entry?.file_name();
+            if name.to_string_lossy().ends_with(".gschema.xml") {
+                schema_count += 1;
+            }
+        }
+        if schema_count > 0 {
+            println!("Compiling {schema_count} GSettings schema file(s)");
+            let compiler = std::env::var_os("GLIB_COMPILE_SCHEMAS")
+                .unwrap_or_else(|| "glib-compile-schemas".into());
+            let status = std::process::Command::new(compiler)
+                .arg("--strict")
+                .arg(fs::canonicalize(&schemas_dir)?)
+                .status()
+                .context("Compiling GSettings schemas requires glib-compile-schemas")?;
+            if !status.success() {
+                bail!("glib-compile-schemas failed while compiling the image's schemas: {status}");
+            }
+            let compiled = schemas_dir.join("gschemas.compiled");
+            let metadata = fs::metadata(&compiled)
+                .context("glib-compile-schemas did not create gschemas.compiled")?;
+            if metadata.len() == 0 {
+                bail!("glib-compile-schemas produced an empty gschemas.compiled");
+            }
+        }
+    }
+
     Ok(())
 }
 
