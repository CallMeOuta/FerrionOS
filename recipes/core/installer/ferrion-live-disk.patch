@@ -40,8 +40,8 @@ pub fn disk_paths() -> Result<Vec<(String, bool, u64)>, String> {
                     if let Ok(path_str) = path.into_os_string().into_string() {
                         let scheme = path_str.trim_start_matches("/scheme/").trim_matches('/');
                         if scheme.starts_with("disk") {
-                            if scheme == "disk/live" {
-                                // Skip live disks
+                            if scheme == "disk.live" {
+                                // Skip live disks (FerrionOS: lived names its scheme disk.live)
                                 continue;
                             }
 
