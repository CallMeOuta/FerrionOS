+fn read_password_from_stdin() -> std::result::Result<WipedString, String> {
+    let mut buf = Vec::with_capacity(64);
+    let mut saw_newline = false;
+    for _ in 0..=MAX_STDIN_PASSWORD_BYTES {
+        let mut byte = [0_u8; 1];
+        let mut read_count = None;
+        for _ in 0..MAX_EINTR_RETRIES {
+            match libredox::call::read(0, &mut byte) {
+                Ok(n) => {
+                    read_count = Some(n);
+                    break;
+                }
+                Err(err) if err.errno() == EINTR => continue,
+                Err(err) => {
+                    wipe_bytes(&mut buf);
+                    return Err(format!("cannot read password from standard input: {err}"));
+                }
+            }
+        }
+        let Some(n) = read_count else {
+            wipe_bytes(&mut buf);
+            return Err(format!(
+                "reading password from standard input interrupted more than {MAX_EINTR_RETRIES} times"
+            ));
+        };
+        if n == 0 {
+            break;
+        }
+        if byte[0] == b'\n' {
+            saw_newline = true;
+            break;
+        }
+        if buf.len() == MAX_STDIN_PASSWORD_BYTES {
+            wipe_bytes(&mut buf);
+            return Err(format!(
+                "password on standard input exceeds {MAX_STDIN_PASSWORD_BYTES} bytes"
+            ));
+        }
+        buf.push(byte[0]);
+        assert!(buf.len() <= MAX_STDIN_PASSWORD_BYTES);
+    }
+    if !saw_newline && buf.is_empty() {
+        return Err("no password provided on standard input".to_string());
+    }
+    if buf.last() == Some(&b'\r') {
+        buf.pop();
+    }
+    match String::from_utf8(buf) {
+        Ok(password) => Ok(WipedString(password)),
+        Err(err) => {
+            let mut raw = err.into_bytes();
+            wipe_bytes(&mut raw);
+            Err("password on standard input is not valid UTF-8".to_string())
+        }
+    }
+}
