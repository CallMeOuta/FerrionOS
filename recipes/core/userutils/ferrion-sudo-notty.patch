+/// Hands `password` to the sudo daemon: true when it accepts it, false when it is wrong. Exits
+/// when the caller may not use sudo at all or the daemon fails.
+fn authenticate(file: &libredox::Fd, password: &str, user: &str) -> bool {
+    match file.write(password.as_bytes()) {
+        Ok(_) => true,
+        Err(err) if err.errno() == EPERM => false,
+        Err(err) if err.errno() == EACCES => {
+            eprintln!("sudo: {user} is not in the sudo group");
+            exit(1);
+        }
+        Err(err) => {
+            eprintln!("sudo: the sudo daemon refused the request: {err}");
+            exit(1);
+        }
+    }
+}
+
+/// Reads a line from the terminal on standard input without echoing it.
+fn read_password_from_terminal() -> io::Result<Option<String>> {
+    // Raw mode is set on standard input's own terminal, so the prompt works whatever standard
+    // output and standard error point at.
+    let mut terminal = File::from(io::stdin().as_fd().try_clone_to_owned()?);
+    io::stdin().read_passwd(&mut terminal)
+}
