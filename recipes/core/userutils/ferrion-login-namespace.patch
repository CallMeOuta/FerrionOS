+++ b/src/bin/login.rs
@@ -117,6 +117,31 @@ fn load_config_schemes(user: &User<redox_users::auth::Full>) -> Option<Vec<Strin
         .map(|cfg| cfg.schemes.clone())
 }
 
+/// Prints the message of the day, then runs the user's shell inside the namespace
+/// `/etc/login_schemes.toml` gives the user, and returns to the previous namespace
+/// once the shell exits. Every successful login goes through here.
+fn login_session(
+    user: &User<redox_users::auth::Full>,
+    stdout: &mut io::Stdout,
+    stderr: &mut io::Stderr,
+) {
+    if let Ok(mut motd) = File::open(MOTD_FILE) {
+        io::copy(&mut motd, stdout).r#try(stderr);
+        stdout.flush().r#try(stderr);
+    }
+
+    let before_ns_fd = apply_login_schemes(user, &DEFAULT_SCHEMES).unwrap_or_exit(1);
+
+    let _ = libredox::call::fcntl(
+        before_ns_fd.raw(),
+        libredox::flag::F_SETFD as usize,
+        libredox::flag::O_CLOEXEC as usize,
+    );
+    spawn_shell(user).unwrap_or_exit(1);
+    let _ = libredox::call::fcntl(before_ns_fd.raw(), libredox::flag::F_SETFD as usize, 0);
+    let _ = libredox::call::close(libredox::call::setns(before_ns_fd.into_raw()).unwrap_or_exit(1));
+}
+
