+use std::process::exit;
+
+fn main() {
+    if std::env::args().len() != 1 {
+        eprintln!("usage: unlock-session");
+        exit(2);
+    }
+    match userutils::unlock::claim_unlocked_session(None) {
+        Some(account) => println!("{account}"),
+        None => exit(1),
+    }
+}
