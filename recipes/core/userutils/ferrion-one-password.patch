diff -ruN '--exclude=.git' a/src/unlock.rs b/src/unlock.rs
--- a/src/unlock.rs
+++ b/src/unlock.rs
@@ -0,0 +1,401 @@
+use std::fs;
+use std::io::{self, Read, Write};
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt};
+use std::process::{Command, Output, Stdio};
+
+pub const UNLOCK_SLOTS_FILE: &str = "/etc/unlock-slots";
+const UNLOCK_SLOTS_TMP: &str = "/etc/.unlock-slots.tmp";
+const BOOT_ENV_FILE: &str = "/scheme/sys/env";
+const CLAIM_DIR: &str = "/var/run/unlock-session";
+const CLAIM_FILE: &str = "/var/run/unlock-session/claimed";
+const MAX_UNLOCK_SLOTS: usize = 64;
+const MAX_ACCOUNT_LEN: usize = 32;
+const MAX_PASSPHRASE_BYTES: usize = 4096;
+const MAX_UNLOCK_SLOTS_BYTES: usize = 8192;
+
+pub struct WipedString(pub String);
+
+impl Drop for WipedString {
+    fn drop(&mut self) {
+        wipe_bytes(unsafe { self.0.as_bytes_mut() });
+    }
+}
+
+pub fn wipe_bytes(bytes: &mut [u8]) {
+    for byte in bytes {
+        unsafe { std::ptr::write_volatile(byte, 0) };
+    }
+}
+
+pub enum RewrapError {
+    IncorrectPassphrase,
+    Other(String),
+}
+
+pub fn valid_account_name(name: &str) -> bool {
+    !name.is_empty()
+        && name != "root"
+        && name.len() <= MAX_ACCOUNT_LEN
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-_.".contains(&b))
+}
+
+fn read_unlock_slots_checked() -> Result<Vec<(usize, String)>, String> {
+    let file = match fs::File::open(UNLOCK_SLOTS_FILE) {
+        Ok(file) => file,
+        Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(err) => return Err(format!("could not open {UNLOCK_SLOTS_FILE}: {err}")),
+    };
+    let metadata = file
+        .metadata()
+        .map_err(|err| format!("could not stat {UNLOCK_SLOTS_FILE}: {err}"))?;
+    if metadata.uid() != 0 || metadata.mode() & 0o077 != 0 || !metadata.is_file() {
+        return Err(format!(
+            "{UNLOCK_SLOTS_FILE} has unexpected owner, mode or type"
+        ));
+    }
+    if metadata.len() > MAX_UNLOCK_SLOTS_BYTES as u64 {
+        return Err(format!(
+            "{UNLOCK_SLOTS_FILE} exceeds {MAX_UNLOCK_SLOTS_BYTES} bytes"
+        ));
+    }
+    let mut text = String::new();
+    file.take(MAX_UNLOCK_SLOTS_BYTES as u64)
+        .read_to_string(&mut text)
+        .map_err(|err| format!("could not read {UNLOCK_SLOTS_FILE}: {err}"))?;
+    let mut entries = Vec::new();
+    for line in text.lines() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() {
+            continue;
+        }
+        let Some((slot_str, account)) = trimmed.split_once(' ') else {
+            return Err(format!("malformed line in {UNLOCK_SLOTS_FILE}"));
+        };
+        let slot = slot_str
+            .parse::<usize>()
+            .map_err(|_| format!("invalid slot number in {UNLOCK_SLOTS_FILE}"))?;
+        let account = account.trim();
+        if slot >= MAX_UNLOCK_SLOTS || account.is_empty() || entries.len() >= MAX_UNLOCK_SLOTS {
+            return Err(format!("invalid entry in {UNLOCK_SLOTS_FILE}"));
+        }
+        entries.push((slot, account.to_string()));
+    }
+    Ok(entries)
+}
+
+fn unlock_slots() -> Vec<(usize, String)> {
+    read_unlock_slots_checked().unwrap_or_default()
+}
+
+fn write_unlock_slots(entries: &[(usize, String)]) -> Result<(), String> {
+    assert!(entries.len() <= MAX_UNLOCK_SLOTS);
+    let mut content = String::new();
+    for (slot, account) in entries {
+        assert!(*slot < MAX_UNLOCK_SLOTS);
+        assert!(!account.is_empty() && !account.contains('\n'));
+        content.push_str(&format!("{slot} {account}\n"));
+    }
+    let tmp_path = format!("{UNLOCK_SLOTS_TMP}.{}", std::process::id());
+    let mut file = fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&tmp_path)
+        .map_err(|err| format!("could not create {tmp_path}: {err}"))?;
+    let result = (|| -> io::Result<()> {
+        file.set_permissions(fs::Permissions::from_mode(0o600))?;
+        file.write_all(content.as_bytes())?;
+        file.sync_all()?;
+        Ok(())
+    })();
+    drop(file);
+    if let Err(err) = result {
+        let _ = fs::remove_file(&tmp_path);
+        return Err(format!("could not write {tmp_path}: {err}"));
+    }
+    if let Err(err) = fs::rename(&tmp_path, UNLOCK_SLOTS_FILE) {
+        let _ = fs::remove_file(&tmp_path);
+        return Err(format!("could not install {UNLOCK_SLOTS_FILE}: {err}"));
+    }
+    Ok(())
+}
+
+pub fn account_slot(account: &str) -> Option<usize> {
+    unlock_slots()
+        .into_iter()
+        .find(|(_, name)| name == account)
+        .map(|(slot, _)| slot)
+}
+
+fn unlocked_account() -> Option<String> {
+    let env = fs::read_to_string(BOOT_ENV_FILE).ok()?;
+    let mut slot = None;
+    let mut kind = None;
+    for line in env.lines() {
+        if let Some(value) = line.strip_prefix("REDOXFS_UNLOCK_SLOT=") {
+            if slot.replace(value.parse::<usize>().ok()?).is_some() {
+                return None;
+            }
+        } else if let Some(value) = line.strip_prefix("REDOXFS_UNLOCK_KIND=") {
+            if kind.replace(value).is_some() {
+                return None;
+            }
+        }
+    }
+    if kind? != "passphrase" {
+        return None;
+    }
+    let slot = slot?;
+    unlock_slots()
+        .into_iter()
+        .find(|(record, _)| *record == slot)
+        .map(|(_, account)| account)
+}
+
+pub enum UnlockState {
+    NotUnlocked,
+    Unclaimed { account: String },
+    Claimed,
+}
+
+fn claim_dir_metadata() -> Option<fs::Metadata> {
+    let metadata = fs::symlink_metadata(CLAIM_DIR).ok()?;
+    if !metadata.is_dir() || metadata.uid() != 0 || metadata.mode() & 0o077 != 0 {
+        return None;
+    }
+    Some(metadata)
+}
+
+pub fn unlock_state() -> UnlockState {
+    let Some(account) = unlocked_account() else {
+        return UnlockState::NotUnlocked;
+    };
+    if claim_dir_metadata().is_none() || fs::symlink_metadata(CLAIM_FILE).is_ok() {
+        return UnlockState::Claimed;
+    }
+    UnlockState::Unclaimed { account }
+}
+
+pub fn claim(state: UnlockState, expected: Option<&str>) -> (UnlockState, Option<String>) {
+    match state {
+        UnlockState::NotUnlocked => (UnlockState::NotUnlocked, None),
+        UnlockState::Claimed => (UnlockState::Claimed, None),
+        UnlockState::Unclaimed { account } => {
+            if expected.is_some_and(|name| name != account) {
+                return (UnlockState::Unclaimed { account }, None);
+            }
+            let Some(metadata) = claim_dir_metadata() else {
+                return (UnlockState::Claimed, None);
+            };
+            assert!(metadata.is_dir() && metadata.uid() == 0 && metadata.mode() & 0o077 == 0);
+            match fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(CLAIM_FILE)
+            {
+                Ok(_) => (UnlockState::Claimed, Some(account)),
+                Err(_) => (UnlockState::Claimed, None),
+            }
+        }
+    }
+}
+
+pub fn claim_unlocked_session(account: Option<&str>) -> Option<String> {
+    if redox_users::get_uid().ok()? != 0 {
+        return None;
+    }
+    let (_, claimed) = claim(unlock_state(), account);
+    claimed
+}
+
+fn run_redoxfs_key(args: &[&str], stdin_payload: &mut [u8]) -> Result<Output, String> {
+    let mut child = match Command::new("redoxfs-key")
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+    {
+        Ok(child) => child,
+        Err(err) => {
+            wipe_bytes(stdin_payload);
+            return Err(format!("could not start redoxfs-key: {err}"));
+        }
+    };
+    let sent = child.stdin.take().unwrap().write_all(stdin_payload);
+    wipe_bytes(stdin_payload);
+    let output = child
+        .wait_with_output()
+        .map_err(|err| format!("could not wait for redoxfs-key: {err}"))?;
+    if output.status.success() {
+        sent.map_err(|err| format!("could not send the passwords to redoxfs-key: {err}"))?;
+    }
+    Ok(output)
+}
+
+fn build_pair_payload(first: &str, second: &str) -> Result<Vec<u8>, String> {
+    if first.is_empty()
+        || second.is_empty()
+        || first.contains('\0')
+        || second.contains('\0')
+        || first.len().saturating_add(second.len()).saturating_add(1) > MAX_PASSPHRASE_BYTES
+    {
+        return Err(format!(
+            "passphrases must be non-empty, contain no NUL bytes and fit in {MAX_PASSPHRASE_BYTES} bytes"
+        ));
+    }
+    let mut payload = Vec::with_capacity(first.len() + second.len() + 1);
+    payload.extend_from_slice(first.as_bytes());
+    payload.push(0);
+    payload.extend_from_slice(second.as_bytes());
+    Ok(payload)
+}
+
+fn parse_updated_slot(stdout: &str) -> Option<usize> {
+    for line in stdout.lines() {
+        let Some(rest) = line.trim().strip_prefix("slot ") else {
+            continue;
+        };
+        let Some((number, _)) = rest.split_once(": updated") else {
+            continue;
+        };
+        let slot = number.parse::<usize>().ok()?;
+        if slot < MAX_UNLOCK_SLOTS {
+            return Some(slot);
+        }
+    }
+    None
+}
+
+fn remove_raw_slot(slot: usize, disk_secret: &str) -> Result<(), String> {
+    assert!(slot < MAX_UNLOCK_SLOTS);
+    if disk_secret.is_empty() || disk_secret.len() > MAX_PASSPHRASE_BYTES {
+        return Err(format!(
+            "disk password must contain 1 to {MAX_PASSPHRASE_BYTES} bytes"
+        ));
+    }
+    let mut payload = disk_secret.as_bytes().to_vec();
+    let slot_arg = slot.to_string();
+    let output = run_redoxfs_key(
+        &["remove", "--key-file", "-", "--slot", &slot_arg, "/"],
+        &mut payload,
+    )?;
+    if !output.status.success() {
+        return Err(format!(
+            "the disk slot {slot} was not removed: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    Ok(())
+}
+
+pub fn rewrap_account_slot(account: &str, old: &str, new: &str) -> Result<bool, RewrapError> {
+    let Some(slot) = account_slot(account) else {
+        return Ok(false);
+    };
+    if new.is_empty() || new.contains('\0') || new.len() >= MAX_PASSPHRASE_BYTES {
+        return Err(RewrapError::Other(
+            "a disk password must be non-empty and contain no NUL bytes".to_string(),
+        ));
+    }
+    if old.is_empty() || old.contains('\0') {
+        return Err(RewrapError::IncorrectPassphrase);
+    }
+    let mut payload = build_pair_payload(old, new).map_err(RewrapError::Other)?;
+    let slot_arg = slot.to_string();
+    let output = run_redoxfs_key(
+        &[
+            "change",
+            "--key-file",
+            "-",
+            "--new-key-file",
+            "-",
+            "--slot",
+            &slot_arg,
+            "/",
+        ],
+        &mut payload,
+    )
+    .map_err(RewrapError::Other)?;
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        if stderr.contains("incorrect passphrase") {
+            return Err(RewrapError::IncorrectPassphrase);
+        }
+        return Err(RewrapError::Other(format!(
+            "the disk slot {slot} of '{account}' was not changed: {}",
+            stderr.trim()
+        )));
+    }
+    Ok(true)
+}
+
+pub fn enroll_account_slot(
+    account: &str,
+    disk_secret: &str,
+    account_password: &str,
+) -> Result<usize, String> {
+    if !valid_account_name(account) {
+        return Err(format!("invalid account name '{account}'"));
+    }
+    let mut entries = read_unlock_slots_checked()?;
+    if let Some((slot, _)) = entries.iter().find(|(_, name)| name == account) {
+        return Err(format!(
+            "'{account}' is already enrolled in disk slot {slot}"
+        ));
+    }
+    if entries.len() >= MAX_UNLOCK_SLOTS {
+        return Err(format!(
+            "{UNLOCK_SLOTS_FILE} already holds {MAX_UNLOCK_SLOTS} entries"
+        ));
+    }
+    let mut payload = build_pair_payload(disk_secret, account_password)?;
+    let output = run_redoxfs_key(
+        &["add", "--key-file", "-", "--new-key-file", "-", "/"],
+        &mut payload,
+    )?;
+    if !output.status.success() {
+        return Err(format!(
+            "could not add a disk slot for '{account}': {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let slot = parse_updated_slot(&stdout).ok_or_else(|| {
+        format!(
+            "redoxfs-key did not report the added slot: {}",
+            stdout.trim()
+        )
+    })?;
+    if entries.iter().any(|(existing, _)| *existing == slot) {
+        let _ = remove_raw_slot(slot, disk_secret);
+        return Err(format!(
+            "disk slot {slot} is already recorded in {UNLOCK_SLOTS_FILE}"
+        ));
+    }
+    entries.push((slot, account.to_string()));
+    if let Err(err) = write_unlock_slots(&entries) {
+        return match remove_raw_slot(slot, disk_secret) {
+            Ok(()) => Err(format!("could not record disk slot {slot}: {err}")),
+            Err(rb_err) => Err(format!(
+                "could not record disk slot {slot}: {err}; rollback also failed: {rb_err}"
+            )),
+        };
+    }
+    Ok(slot)
+}
+
+pub fn revoke_account_slot(account: &str, disk_secret: &str) -> Result<Option<usize>, String> {
+    let mut entries = read_unlock_slots_checked()?;
+    let Some(pos) = entries.iter().position(|(_, name)| name == account) else {
+        return Ok(None);
+    };
+    let slot = entries[pos].0;
+    remove_raw_slot(slot, disk_secret)?;
+    entries.remove(pos);
+    write_unlock_slots(&entries)?;
+    Ok(Some(slot))
+}
