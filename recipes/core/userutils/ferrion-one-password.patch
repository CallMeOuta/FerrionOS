diff -r a/src/unlock.rs b/src/unlock.rs
--- a/src/unlock.rs
+++ b/src/unlock.rs
@@ -0,0 +1,113 @@
+use std::fs;
+use std::io::{self, Write};
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::process::{Command, Stdio};
+
+pub const UNLOCK_SLOTS_FILE: &str = "/etc/unlock-slots";
+const BOOT_ENV_FILE: &str = "/scheme/sys/env";
+const CLAIM_FILE: &str = "/tmp/.unlock-session-claimed";
+
+fn unlock_slots() -> Vec<(usize, String)> {
+    let Ok(file) = fs::File::open(UNLOCK_SLOTS_FILE) else {
+        return Vec::new();
+    };
+    let Ok(metadata) = file.metadata() else {
+        return Vec::new();
+    };
+    if metadata.uid() != 0 || metadata.mode() & 0o077 != 0 || !metadata.is_file() {
+        return Vec::new();
+    }
+    let Ok(text) = io::read_to_string(file) else {
+        return Vec::new();
+    };
+    text.lines()
+        .filter_map(|line| {
+            let (slot, account) = line.trim().split_once(' ')?;
+            Some((slot.parse().ok()?, account.trim().to_string()))
+        })
+        .filter(|(slot, account): &(usize, String)| *slot < 64 && !account.is_empty())
+        .collect()
+}
+
+pub fn account_slot(account: &str) -> Option<usize> {
+    unlock_slots()
+        .into_iter()
+        .find(|(_, name)| name == account)
+        .map(|(slot, _)| slot)
+}
+
+fn unlocked_account() -> Option<String> {
+    let env = fs::read_to_string(BOOT_ENV_FILE).ok()?;
+    let mut slot = None;
+    let mut kind = None;
+    for line in env.lines() {
+        if let Some(value) = line.strip_prefix("REDOXFS_UNLOCK_SLOT=") {
+            if slot.replace(value.parse::<usize>().ok()?).is_some() {
+                return None;
+            }
+        } else if let Some(value) = line.strip_prefix("REDOXFS_UNLOCK_KIND=") {
+            if kind.replace(value).is_some() {
+                return None;
+            }
+        }
+    }
+    if kind? != "passphrase" {
+        return None;
+    }
+    let slot = slot?;
+    unlock_slots()
+        .into_iter()
+        .find(|(record, _)| *record == slot)
+        .map(|(_, account)| account)
+}
+
+pub fn claim_unlocked_session(account: Option<&str>) -> Option<String> {
+    if redox_users::get_uid().ok()? != 0 {
+        return None;
+    }
+    let unlocked = unlocked_account()?;
+    if account.is_some_and(|account| account != unlocked) {
+        return None;
+    }
+    fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(CLAIM_FILE)
+        .ok()?;
+    Some(unlocked)
+}
+
+pub fn rewrap_account_slot(account: &str, old: &str, new: &str) -> Result<bool, String> {
+    let Some(slot) = account_slot(account) else {
+        return Ok(false);
+    };
+    let mut child = Command::new("redoxfs-key")
+        .args(["change", "--key-file", "-", "--new-key-file", "-", "--slot"])
+        .arg(slot.to_string())
+        .arg("/")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|err| format!("could not start redoxfs-key: {err}"))?;
+    let mut payload = Vec::with_capacity(old.len() + new.len() + 1);
+    payload.extend_from_slice(old.as_bytes());
+    payload.push(0);
+    payload.extend_from_slice(new.as_bytes());
+    let sent = child.stdin.take().unwrap().write_all(&payload);
+    for byte in payload.iter_mut() {
+        unsafe { std::ptr::write_volatile(byte, 0) };
+    }
+    let output = child
+        .wait_with_output()
+        .map_err(|err| format!("could not wait for redoxfs-key: {err}"))?;
+    sent.map_err(|err| format!("could not send the passwords to redoxfs-key: {err}"))?;
+    if !output.status.success() {
+        return Err(format!(
+            "the disk slot {slot} of '{account}' was not changed: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    Ok(true)
+}
