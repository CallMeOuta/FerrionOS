+fn wake_futex(key: FutexKey, val: usize, token: &mut CleanLockToken) -> usize {
+    let mut woken = 0;
+    let mut futexes_map = FUTEXES.lock(token.token());
+    let (futexes_map, mut token) = futexes_map.token_split();
