FerrionOS change to the Redox kernel (MIT licence, kept), made against upstream commit e7f1d4231d0f4b55fbef229d9cd9459302c101f4:
- with QUIET=1 in the boot environment, graphical_debug::init leaves the screen alone instead of drawing the kernel log on it; the log still goes to the serial port.

diff --git a/src/devices/graphical_debug/mod.rs b/src/devices/graphical_debug/mod.rs
index b701c9a8..2757bd06 100644
--- a/src/devices/graphical_debug/mod.rs
+++ b/src/devices/graphical_debug/mod.rs
@@ -18,6 +18,7 @@ pub fn init(env: &[u8]) {
     let mut width = 0;
     let mut height = 0;
     let mut stride = 0;
+    let mut quiet = false;
 
     //TODO: should errors be reported?
     for line in str::from_utf8(env).unwrap_or("").lines() {
@@ -44,6 +45,10 @@ pub fn init(env: &[u8]) {
         if name == "FRAMEBUFFER_STRIDE" {
             stride = usize::from_str_radix(value, 16).unwrap_or(0);
         }
+
+        if name == "QUIET" {
+            quiet = value == "1";
+        }
     }
 
     *FRAMEBUFFER.lock() = (phys, virt, stride * height * 4);
@@ -58,6 +63,12 @@ pub fn init(env: &[u8]) {
         width, height, stride, phys, virt
     );
 
+    // A quiet boot keeps the screen for the boot splash; the log still goes to the serial port
+    if quiet {
+        println!("Quiet boot: graphical debug stays off");
+        return;
+    }
+
     let debug_display = DebugDisplay::new(width, height, stride, virt as *mut u32);
     *DEBUG_DISPLAY.lock() = Some(debug_display);
 }
