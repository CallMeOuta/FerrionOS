+        assert_eq!(wire.len(), 8 + 32 + 17);
+        // At an odd address: every field is read by value.
+        let mut shifted = vec![0u8; wire.len() + 1];
+        shifted[1..].copy_from_slice(&wire);
+        VirtgpuContextInit::with(&shifted[1..], |data| {
+            assert_eq!(data.num_params(), 2);
+            let got: Vec<_> = data.params().map(|p| (p.param, p.value)).collect();
+            assert_eq!(got, [(1, 4), (2, 64)]);
+            assert_eq!(data.name(), b"gpu-probe-context");
+            Ok(0)
+        })
+        .unwrap();
+    }
+
+    #[test]
+    fn context_name_is_cut_and_bounded() {
+        let long = [b'x'; 100];
+        let wire = VirtgpuContextInit::wire(0, &[], &long);
+        assert_eq!(wire.len(), 8 + CONTEXT_NAME_MAX);
+        let mut over = wire.clone();
+        over.push(b'x');
+        assert!(VirtgpuContextInit::with(&over, |_| Ok(0)).is_err());
+        let mut huge = wire;
+        huge[..4].copy_from_slice(&u32::MAX.to_ne_bytes());
+        assert!(VirtgpuContextInit::with(&huge, |_| Ok(0)).is_err());
+    }
 }
