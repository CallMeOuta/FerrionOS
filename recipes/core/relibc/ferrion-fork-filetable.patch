+                            tv_nsec: FORK_REAP_SLEEP_NS,
+                        };
+                        let mut rem = syscall::TimeSpec::default();
+                        let _ = syscall::nanosleep(&req, &mut rem);
+                    }
+                    Err(_) => break,
+                }
+            }
