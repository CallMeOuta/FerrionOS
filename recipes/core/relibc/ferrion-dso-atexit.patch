+/// Registers `func` for `exit`, as `atexit` does.
+pub(crate) fn atexit(func: extern "C" fn()) -> c_int {
+    register(ExitFunc {
+        callback: ExitCallback::Plain(func),
+        dso: 0,
+    })
+}
