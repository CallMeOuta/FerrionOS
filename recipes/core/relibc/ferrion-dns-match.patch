+        assert!(matches(&reply(0x1234, 0x8183, b"HOST.TEST", 1)));
+        // Wrong ID, not a response, another opcode, another name or type.
+        assert!(!matches(&reply(0x1235, 0x8180, b"host.test", 1)));
+        assert!(!matches(&reply(0x1234, 0x0100, b"host.test", 1)));
+        assert!(!matches(&reply(0x1234, 0x8980, b"host.test", 1)));
+        assert!(!matches(&reply(0x1234, 0x8180, b"other.test", 1)));
+        assert!(!matches(&reply(0x1234, 0x8180, b"host.test", 28)));
+        let answer = Dns::parse(&reply(0x1234, 0x8180, b"host.test", 1)).unwrap();
+        assert_eq!(answer.answers[0].name, "host.test");
+        assert_eq!(answer.answers[0].data, [192, 0, 2, 7]);
+    }
