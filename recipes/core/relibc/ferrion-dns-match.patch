+    /// A reply with ID `id`, flags `flags` and one question for `name` of type
+    /// `q_type`, answered with 192.0.2.7.
+    fn reply(id: u16, flags: u16, name: &[u8], q_type: u16) -> alloc::vec::Vec<u8> {
+        let mut data = alloc::vec::Vec::new();
+        for word in [id, flags, 1, 1, 0, 0] {
+            data.extend_from_slice(&word.to_be_bytes());
+        }
+        for label in name.split(|byte| *byte == b'.') {
+            data.push(label.len() as u8);
+            data.extend_from_slice(label);
+        }
+        data.push(0);
+        data.extend_from_slice(&q_type.to_be_bytes());
+        data.extend_from_slice(&1u16.to_be_bytes());
+        // The answer names the question by a pointer to offset 12.
+        data.extend_from_slice(&[0xc0, 12, 0, 1, 0, 1, 0, 0, 0, 60, 0, 4, 192, 0, 2, 7]);
+        data
+    }
+
