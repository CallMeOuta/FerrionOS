FerrionOS change to relibc (MIT license, kept), made against upstream commit 74b5e7e315043a21b599f271d5692727aa54f64d with the patches before it in the recipe's list applied:
- `sendmsg` with `SCM_RIGHTS` passes copies of the descriptors (`CallFlags::FD_CLONE`) and leaves the sender's own descriptors open, as POSIX requires. It moved them out of the sender's file table, so a sender that then closed its copy, as Firefox's IPC does, closed whatever descriptor had reused the number.

diff --git a/src/platform/redox/socket.rs b/src/platform/redox/socket.rs
index a237b97f..3ed0dd2f 100644
--- a/src/platform/redox/socket.rs
+++ b/src/platform/redox/socket.rs
@@ -299,7 +299,13 @@ unsafe fn serialize_ancillary_data_to_stream(
                             fd_count * mem::size_of::<usize>(),
                         )
                     };
-                    redox_rt::sys::sys_call_wo(socket as usize, fds_slice, CallFlags::FD, &[])?;
+                    // SCM_RIGHTS passes copies: the sender keeps its descriptors.
+                    redox_rt::sys::sys_call_wo(
+                        socket as usize,
+                        fds_slice,
+                        CallFlags::FD | CallFlags::FD_CLONE,
+                        &[],
+                    )?;
                 }
 
                 // Serialize to ancillary_data_stream.
