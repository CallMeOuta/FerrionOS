+#[cfg(test)]
+mod tests {
+    use alloc::vec;
+    use core::{ptr, slice};
+
+    use crate::{
+        IoctlData,
+        drm::{DrmModeMapDumb, DrmModeObjGetProperties, drm_version},
+    };
+
+    /// `len` bytes at `offset` from an 8-aligned base.
+    fn bytes_at(backing: &mut [u64], offset: usize, len: usize) -> &mut [u8] {
+        let all = unsafe {
+            slice::from_raw_parts_mut(backing.as_mut_ptr().cast::<u8>(), backing.len() * 8)
+        };
+        &mut all[offset..offset + len]
+    }
+
+    #[test]
+    fn an_array_out_of_alignment_is_read_and_written_back() {
+        // 12 fixed bytes, then 2 property numbers, then 2 values at offset 20.
+        let mut backing = vec![0u64; 5];
+        let payload = bytes_at(&mut backing, 0, 36);
+        payload[..4].copy_from_slice(&2u32.to_ne_bytes());
+        payload[20..28].copy_from_slice(&11u64.to_ne_bytes());
+        DrmModeObjGetProperties::with(payload, |mut data| {
+            assert_eq!(data.prop_values_ptr(), &[11, 0]);
+            data.set_props_ptr(&[1, 2]);
+            data.set_prop_values_ptr(&[7, 9]);
+            Ok(0)
+        })
+        .unwrap();
+        let payload = bytes_at(&mut backing, 0, 36);
+        assert_eq!(payload[12..20], [1, 0, 0, 0, 2, 0, 0, 0]);
+        assert_eq!(payload[20..28], 7u64.to_ne_bytes());
+        assert_eq!(payload[28..36], 9u64.to_ne_bytes());
+    }
+
+    #[test]
+    fn a_payload_at_an_odd_address_is_read_and_written_back() {
+        let mut backing = vec![0u64; 3];
+        let payload = bytes_at(&mut backing, 1, 16);
+        payload[..4].copy_from_slice(&3u32.to_ne_bytes());
+        DrmModeMapDumb::with(payload, |mut data| {
+            assert_eq!(data.handle(), 3);
+            data.set_offset(0x1000_0000);
+            Ok(0)
+        })
+        .unwrap();
+        let payload = bytes_at(&mut backing, 1, 16);
+        assert_eq!(payload[8..16], 0x1000_0000u64.to_ne_bytes());
+    }
+
+    #[test]
+    fn padding_is_sent_as_zeros() {
+        // drm_version's fixed part has 4 bytes of padding after its three numbers.
+        let version = drm_version {
+            version_major: -1,
+            version_minor: -1,
+            version_patchlevel: -1,
+            name_len: 0,
+            name: ptr::null_mut(),
+            date_len: 0,
+            date: ptr::null_mut(),
+            desc_len: 0,
+            desc: ptr::null_mut(),
+        };
+        let wire = unsafe { version.write() };
+        assert_eq!(wire.len(), 40);
+        assert_eq!(wire[..12], [0xFF; 12]);
+        assert_eq!(wire[12..16], [0; 4]);
+    }
+
+    #[test]
+    fn an_array_written_in_place_keeps_its_count() {
+        use crate::virtgpu::{VIRTGPU_DRM_CAPSET_VENUS, VirtgpuGetCaps, drm_virtgpu_get_caps};
+
+        let mut capset = [0u8; 160];
+        let mut caps = drm_virtgpu_get_caps {
+            cap_set_id: VIRTGPU_DRM_CAPSET_VENUS,
+            size: 160,
+            addr: capset.as_mut_ptr() as u64,
+            ..Default::default()
+        };
+        let mut wire = unsafe { caps.write() };
+        let len = wire.len();
+        let mut backing = vec![0u64; len.div_ceil(8)];
+        let payload = bytes_at(&mut backing, 0, len);
+        payload.copy_from_slice(&wire);
+        // The host's capset is shorter than the buffer: Linux copies what it has
+        // and leaves `size` as the caller sent it.
+        VirtgpuGetCaps::with(payload, |mut data| {
+            data.addr_mut()[..4].copy_from_slice(&[1, 2, 3, 4]);
+            Ok(0)
+        })
+        .unwrap();
+        wire.copy_from_slice(bytes_at(&mut backing, 0, len));
+        unsafe { caps.read_from(&wire) };
+        assert_eq!(caps.size, 160);
+        assert_eq!(capset[..5], [1, 2, 3, 4, 0]);
+    }
+
+    // A payload the caller sent with a write-only call is mapped read-only into
+    // the scheme. These two live in read-only memory: a view that wrote to them
+    // would fault.
+    static READ_ONLY_CAP: [u64; 2] = [0x299f_c90c, 1];
+    #[repr(C, align(8))]
+    struct Aligned8([u32; 9]);
+    static READ_ONLY_PROPS: Aligned8 = Aligned8([2, 0, 0, 1, 2, 7, 0, 9, 0]);
+
+    /// The bytes at `ptr` as the scheme sees a read-only payload: as `&mut`.
+    unsafe fn read_only(ptr: *const u8, len: usize) -> &'static mut [u8] {
+        unsafe { slice::from_raw_parts_mut(ptr.cast_mut(), len) }
+    }
+
+    #[test]
+    fn a_payload_that_is_only_read_is_not_written() {
+        let cap = unsafe { read_only(READ_ONLY_CAP.as_ptr().cast::<u8>(), 16) };
+        crate::drm::DrmSetClientCap::with(cap, |data| {
+            assert_eq!((data.capability(), data.value()), (0x299f_c90c, 1));
+            Ok(0)
+        })
+        .unwrap();
+
+        // 12 fixed bytes, 2 property numbers, then 2 values at offset 20, out of
+        // alignment for u64, so they are copied out.
+        let props = unsafe { read_only(READ_ONLY_PROPS.0.as_ptr().cast::<u8>(), 36) };
+        DrmModeObjGetProperties::with(props, |data| {
+            assert_eq!(data.props_ptr(), &[1, 2]);
+            assert_eq!(data.prop_values_ptr(), &[7, 9]);
+            Ok(0)
+        })
+        .unwrap();
+    }
+
+    #[test]
+    fn counts_beyond_the_payload_are_refused() {
+        let mut backing = vec![0u64; 2];
+        let payload = bytes_at(&mut backing, 0, 12);
+        payload[..4].copy_from_slice(&u32::MAX.to_ne_bytes());
+        assert!(DrmModeObjGetProperties::with(payload, |_| Ok(0)).is_err());
+    }
+}
