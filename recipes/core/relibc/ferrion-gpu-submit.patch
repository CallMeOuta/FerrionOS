+    #[test]
+    fn wait_round_trips() {
+        let mut req = drm_virtgpu_3d_wait {
+            handle: 42,
+            flags: VIRTGPU_WAIT_NOWAIT,
+        };
+        let wire = unsafe { req.write() };
+        assert_eq!(wire.len(), 8);
+        let mut backing = aligned(&wire);
+        let len = wire.len();
+        let payload = unsafe { slice::from_raw_parts_mut(backing.as_mut_ptr().cast::<u8>(), len) };
+        VirtgpuWait::with(payload, |data| {
+            assert_eq!(data.handle(), 42);
+            assert_eq!(data.flags(), VIRTGPU_WAIT_NOWAIT);
+            Ok(0)
+        })
+        .unwrap();
+        unsafe { req.read_from(payload) };
+        assert_eq!(req.handle, 42);
+        assert_eq!(req.flags, VIRTGPU_WAIT_NOWAIT);
+    }
