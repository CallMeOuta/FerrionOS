 }
+
+pub const WAIT_VBLANK: u64 = 0x3A;
+
+const _: () = assert!(mem::size_of::<drm_wait_vblank>() == 24);
+const _: () = assert!(mem::size_of::<drm_mode_crtc_page_flip_target>() == 24);
+
+impl crate::ioctl_data::IoctlData for drm_wait_vblank {
+    unsafe fn write(&self) -> Vec<u8> {
+        let req = unsafe { self.request };
+        let mut data = Vec::with_capacity(24);
+        data.extend_from_slice(&req.type_.to_ne_bytes());
+        data.extend_from_slice(&req.sequence.to_ne_bytes());
+        data.extend_from_slice(&(req.signal as u64).to_ne_bytes());
+        data.extend_from_slice(&0u64.to_ne_bytes());
+        data
+    }
+
+    unsafe fn read_from(&mut self, buf: &[u8]) {
+        assert_eq!(buf.len(), 24);
+        let type_ = u32::from_ne_bytes(buf[0..4].try_into().unwrap());
+        let sequence = u32::from_ne_bytes(buf[4..8].try_into().unwrap());
+        let tval_sec = i64::from_ne_bytes(buf[8..16].try_into().unwrap());
+        let tval_usec = i64::from_ne_bytes(buf[16..24].try_into().unwrap());
+        self.reply = drm_wait_vblank_reply {
+            type_,
+            sequence,
+            tval_sec: tval_sec as c_long,
+            tval_usec: tval_usec as c_long,
+        };
+    }
+}
+
+pub struct DrmWaitVblank<'a> {
+    req_type: u32,
+    req_sequence: u32,
+    req_signal: u64,
+    reply_type: u32,
+    reply_sequence: u32,
+    reply_tval_sec: i64,
+    reply_tval_usec: i64,
+    bytes: &'a mut [u8],
+    written: bool,
+}
+
+impl Drop for DrmWaitVblank<'_> {
+    fn drop(&mut self) {
+        if !self.written {
+            return;
+        }
+        self.bytes[0..4].copy_from_slice(&self.reply_type.to_ne_bytes());
+        self.bytes[4..8].copy_from_slice(&self.reply_sequence.to_ne_bytes());
+        self.bytes[8..16].copy_from_slice(&self.reply_tval_sec.to_ne_bytes());
+        self.bytes[16..24].copy_from_slice(&self.reply_tval_usec.to_ne_bytes());
+    }
+}
+
+impl<'a> DrmWaitVblank<'a> {
+    pub fn with(
+        buf: &'a mut [u8],
+        f: impl FnOnce(DrmWaitVblank<'a>) -> syscall::Result<usize>,
+    ) -> syscall::Result<usize> {
+        if buf.len() != 24 {
+            return Err(syscall::Error::new(syscall::EINVAL));
+        }
+        let req_type = u32::from_ne_bytes(buf[0..4].try_into().unwrap());
+        let req_sequence = u32::from_ne_bytes(buf[4..8].try_into().unwrap());
+        let req_signal = u64::from_ne_bytes(buf[8..16].try_into().unwrap());
+        f(Self {
+            req_type,
+            req_sequence,
+            req_signal,
+            reply_type: 0,
+            reply_sequence: 0,
+            reply_tval_sec: 0,
+            reply_tval_usec: 0,
+            bytes: buf,
+            written: false,
+        })
+    }
+
+    pub fn request_type(&self) -> u32 {
+        self.req_type
+    }
+
+    pub fn request_sequence(&self) -> u32 {
+        self.req_sequence
+    }
+
+    pub fn request_signal(&self) -> u64 {
+        self.req_signal
+    }
+
+    pub fn set_reply_type(&mut self, value: u32) {
+        self.reply_type = value;
+        self.written = true;
+    }
+
+    pub fn set_reply_sequence(&mut self, value: u32) {
+        self.reply_sequence = value;
+        self.written = true;
+    }
+
+    pub fn set_reply_tval_sec(&mut self, value: i64) {
+        self.reply_tval_sec = value;
+        self.written = true;
+    }
+
+    pub fn set_reply_tval_usec(&mut self, value: i64) {
+        self.reply_tval_usec = value;
+        self.written = true;
+    }
+}
