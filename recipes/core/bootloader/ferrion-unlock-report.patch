+pub fn esp_unlock_accounts() -> Vec<String> {
+    let Ok(loaded_image) = LoadedImage::handle_protocol(std::handle()) else {
+        return Vec::new();
+    };
+    let Ok(mut esp_fs) = FileSystem::handle_protocol(loaded_image.0.DeviceHandle) else {
+        return Vec::new();
+    };
+    let Ok(mut root) = esp_fs.root() else {
+        return Vec::new();
+    };
+    let mut name: Vec<u16> = "EFI\\BOOT\\UNLOCK.TXT".encode_utf16().collect();
+    name.push(0);
+    let Ok(mut file) = root.open(&name) else {
+        return Vec::new();
+    };
+    let mut data = Vec::new();
+    if file.read_to_end(&mut data).is_err() || data.len() > 4096 {
+        return Vec::new();
+    }
+    core::str::from_utf8(&data)
+        .unwrap_or("")
+        .lines()
+        .map(str::trim)
+        .filter(|line| {
+            !line.is_empty()
+                && line.len() <= 32
+                && line
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"-_.".contains(&b))
+        })
+        .take(8)
+        .map(String::from)
+        .collect()
+}
