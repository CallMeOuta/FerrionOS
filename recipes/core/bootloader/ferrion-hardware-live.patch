 /// kernel so that the OS stays quiet too.
 pub static QUIET: AtomicBool = AtomicBool::new(false);
 
+static HARDWARE_LIVE: AtomicBool = AtomicBool::new(false);
+const HARDWARE_POLICY: &[u8] = b"FERRION_HW_LIVE=1\nSTORAGE=off\nQUIET=0\n";
+
+fn hardware_live<D: Disk>(fs: &mut redoxfs::FileSystem<D>) -> bool {
+    if !cfg!(feature = "live") || verify::enabled() {
+        return false;
+    }
+    fs.tx(|tx| {
+        let node = match tx.find_node(redoxfs::TreePtr::root(), "hw-live") {
+            Ok(node) => node,
+            Err(error) if error.errno == syscall::ENOENT => return Ok(false),
+            Err(error) => return Err(error),
+        };
+        assert_eq!(node.data().size(), HARDWARE_POLICY.len() as u64);
+        let mut policy = [0_u8; HARDWARE_POLICY.len()];
+        assert_eq!(tx.read_node_inner(&node, 0, &mut policy)?, policy.len());
+        assert_eq!(policy.as_slice(), HARDWARE_POLICY);
+        Ok(true)
+    })
+    .expect("Failed to read first-boot policy")
+}
+
 /// The color a quiet boot fills the screen with, as 0xRRGGBB: FerrionOS's ground. The kernel
 /// environment carries it as `BOOT_BACKGROUND`, so that the OS draws on the same color.
 const BACKGROUND_COLOR: u32 = 0x0f0e0c;
