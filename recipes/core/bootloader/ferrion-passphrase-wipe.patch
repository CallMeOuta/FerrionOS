FerrionOS change to the upstream bootloader (MIT license, kept), applied after ferrion-measured-boot.patch, made against upstream commit f3d9261b5fc81418c259c5059f46ee7087e86ed8:
- every buffer that held the RedoxFS passphrase typed at the prompt, those of wrong attempts included, is overwritten with zeros before it is freed, and the buffer grows by hand so that no reallocation leaves a copy behind. The page that hands the passphrase to redoxfs stays reserved; redoxfs overwrites it with zeros after reading (recipes/core/redoxfs/ferrion-passphrase-wipe.patch).

diff --git a/src/main.rs b/src/main.rs
index 2222f7b..cd8f550 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -346,6 +346,22 @@ fn select_mode(
     mode_opt
 }
 
+/// Overwrites a buffer that held a passphrase with zeros. The writes are volatile so the compiler
+/// keeps them although nothing reads the buffer afterwards.
+fn wipe(buf: &mut [u8]) {
+    for byte in buf.iter_mut() {
+        unsafe { ptr::write_volatile(byte, 0) };
+    }
+    core::sync::atomic::compiler_fence(Ordering::SeqCst);
+}
+
+/// Overwrites a passphrase's whole allocation with zeros, then drops it.
+fn wipe_password(mut password: String) {
+    let buf = unsafe { password.as_mut_vec() };
+    let capacity = buf.capacity();
+    wipe(unsafe { slice::from_raw_parts_mut(buf.as_mut_ptr(), capacity) });
+}
