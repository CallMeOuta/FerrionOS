FerrionOS change to the upstream bootloader (MIT license, kept), applied after ferrion-hardware-live.patch, made against upstream commit f3d9261b5fc81418c259c5059f46ee7087e86ed8:
- decode EDID 1.4 base blocks, CTA-861 DTDs, and DisplayID 1.x/2.0 Type I and Type VII detailed timings directly in a self-contained no_std MIT module (src/edid.rs), validating each 128-byte block checksum, rejecting lengths other than 128 * (1 + n), capping extension blocks at MAX_EDID_EXTENSION_BLOCKS (8) while keeping the base block and first 8 extensions, and skipping bad extension blocks with a warning;
- on UEFI, fall back from EFI_EDID_ACTIVE_PROTOCOL to EFI_EDID_DISCOVERED_PROTOCOL before falling back to the firmware's current GOP mode, and cap GOP mode scans at MAX_GOP_MODES (256);
- select the GOP mode matching the preferred timing exactly, else the largest GOP mode with the panel's aspect ratio, else the largest GOP mode, logging both preferred timing/source and chosen mode/reason.

diff -ruN '--exclude=*.orig' step3-bootloader-orig/src/edid.rs step3-bootloader-work/src/edid.rs
--- a/src/edid.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/src/edid.rs	2026-11-23 22:31:28.911856570 -0800
@@ -0,0 +1,228 @@
+pub const EDID_BLOCK_SIZE: usize = 128;
+pub const MAX_EDID_EXTENSION_BLOCKS: usize = 8;
+pub const MAX_EDID_TOTAL_BLOCKS: usize = 256;
+pub const MAX_CTA_DTDS: usize = 6;
+pub const MAX_DISPLAYID_BLOCKS: usize = 32;
+pub const MAX_DISPLAYID_TIMINGS: usize = 6;
+
+const EDID_HEADER: [u8; 8] = [0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00];
+const EXT_TAG_CTA: u8 = 0x02;
+const EXT_TAG_DISPLAYID: u8 = 0x70;
+const DISPLAYID_TAG_TYPE_I: u8 = 0x03;
+const DISPLAYID_TAG_TYPE_VII: u8 = 0x22;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Timing {
+    pub width: u32,
+    pub height: u32,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum EdidError {
+    InvalidLength,
+    BadHeader,
+    BadBaseChecksum,
+    NoTiming,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct DecodedEdid {
+    pub preferred: Timing,
+    pub extensions_truncated: bool,
+    pub bad_extension_blocks: usize,
+}
+
+fn valid_checksum(block: &[u8]) -> bool {
+    if block.len() != EDID_BLOCK_SIZE {
+        return false;
+    }
+    block
+        .iter()
+        .fold(0u8, |acc, &byte| acc.wrapping_add(byte))
+        == 0
+}
+
+fn parse_dtd(desc: &[u8]) -> Option<Timing> {
+    if desc.len() < 18 {
+        return None;
+    }
+    let pixel_clock = u16::from_le_bytes([desc[0], desc[1]]);
+    if pixel_clock == 0 {
+        return None;
+    }
+    let width = (desc[2] as u32) | (((desc[4] as u32) & 0xF0) << 4);
+    let height = (desc[5] as u32) | (((desc[7] as u32) & 0xF0) << 4);
+    if width == 0 || height == 0 {
+        return None;
+    }
+    Some(Timing { width, height })
+}
+
+fn parse_base_dtd(base: &[u8]) -> Option<Timing> {
+    assert_eq!(base.len(), EDID_BLOCK_SIZE);
+    for slot in 0..4usize {
+        let offset = 54 + slot * 18;
+        if let Some(timing) = parse_dtd(&base[offset..offset + 18]) {
+            return Some(timing);
+        }
+    }
+    None
+}
+
+fn parse_cta_extension(block: &[u8]) -> Option<Timing> {
+    assert_eq!(block.len(), EDID_BLOCK_SIZE);
+    let dtd_offset = block[2] as usize;
+    if dtd_offset < 4 || dtd_offset >= 127 {
+        return None;
+    }
+    let mut offset = dtd_offset;
+    for _ in 0..MAX_CTA_DTDS {
+        if offset + 18 > 127 {
+            break;
+        }
+        if let Some(timing) = parse_dtd(&block[offset..offset + 18]) {
+            return Some(timing);
+        }
+        offset += 18;
+    }
+    None
+}
+
+fn parse_displayid_extension(block: &[u8]) -> (Option<Timing>, Option<Timing>) {
+    assert_eq!(block.len(), EDID_BLOCK_SIZE);
+    let payload_len = block[2] as usize;
+    let section_end = 5 + payload_len;
+    if section_end > 126 {
+        return (None, None);
+    }
+    let checksum = block[1..=section_end]
+        .iter()
+        .fold(0u8, |acc, &byte| acc.wrapping_add(byte));
+    if checksum != 0 {
+        return (None, None);
+    }
+
+    let mut preferred = None;
+    let mut first_any = None;
+    let mut pos = 5usize;
+    for _ in 0..MAX_DISPLAYID_BLOCKS {
+        if pos + 3 > section_end {
+            break;
+        }
+        let tag = block[pos];
+        let len = block[pos + 2] as usize;
+        let data_start = pos + 3;
+        let data_end = data_start + len;
+        if data_end > section_end {
+            break;
+        }
+        if tag == DISPLAYID_TAG_TYPE_I || tag == DISPLAYID_TAG_TYPE_VII {
+            let count = (len / 20).min(MAX_DISPLAYID_TIMINGS);
+            for i in 0..count {
+                let d = &block[data_start + i * 20..data_start + (i + 1) * 20];
+                let flags = d[3];
+                let width = u16::from_le_bytes([d[4], d[5]]) as u32 + 1;
+                let height = u16::from_le_bytes([d[12], d[13]]) as u32 + 1;
+                let timing = Timing { width, height };
+                if first_any.is_none() {
+                    first_any = Some(timing);
+                }
+                if (flags & 0x80) != 0 && preferred.is_none() {
+                    preferred = Some(timing);
+                }
+            }
+        }
+        pos = data_end;
+    }
+    (preferred, first_any)
+}
+
+#[allow(dead_code)]
+pub fn decode_base_only(edid: &[u8]) -> Result<Timing, EdidError> {
+    if edid.len() < EDID_BLOCK_SIZE {
+        return Err(EdidError::InvalidLength);
+    }
+    let base = &edid[..EDID_BLOCK_SIZE];
+    if base[..8] != EDID_HEADER {
+        return Err(EdidError::BadHeader);
+    }
+    if !valid_checksum(base) {
+        return Err(EdidError::BadBaseChecksum);
+    }
+    parse_base_dtd(base).ok_or(EdidError::NoTiming)
+}
+
+#[allow(dead_code)]
+pub fn decode_preferred(edid: &[u8]) -> Result<DecodedEdid, EdidError> {
+    if edid.len() < EDID_BLOCK_SIZE
+        || edid.len() % EDID_BLOCK_SIZE != 0
+        || edid.len() > MAX_EDID_TOTAL_BLOCKS * EDID_BLOCK_SIZE
+    {
+        return Err(EdidError::InvalidLength);
+    }
+    let base = &edid[..EDID_BLOCK_SIZE];
+    if base[..8] != EDID_HEADER {
+        return Err(EdidError::BadHeader);
+    }
+    if !valid_checksum(base) {
+        return Err(EdidError::BadBaseChecksum);
+    }
+
+    let declared_ext = base[126] as usize;
+    let expected_len = match declared_ext
+        .checked_add(1)
+        .and_then(|blocks| blocks.checked_mul(EDID_BLOCK_SIZE))
+    {
+        Some(len) => len,
+        None => return Err(EdidError::InvalidLength),
+    };
+    if edid.len() != expected_len {
+        return Err(EdidError::InvalidLength);
+    }
+
+    let extensions_truncated = declared_ext > MAX_EDID_EXTENSION_BLOCKS;
+    let ext_to_walk = declared_ext.min(MAX_EDID_EXTENSION_BLOCKS);
+    let base_dtd = parse_base_dtd(base);
+    let mut displayid_preferred = None;
+    let mut displayid_any = None;
+    let mut cta_dtd = None;
+    let mut bad_extension_blocks = 0usize;
+
+    for ext_idx in 0..ext_to_walk {
+        let start = (1 + ext_idx) * EDID_BLOCK_SIZE;
+        let block = &edid[start..start + EDID_BLOCK_SIZE];
+        if !valid_checksum(block) {
+            bad_extension_blocks += 1;
+            continue;
+        }
+        match block[0] {
+            EXT_TAG_DISPLAYID => {
+                let (pref, any) = parse_displayid_extension(block);
+                if displayid_preferred.is_none() {
+                    displayid_preferred = pref;
+                }
+                if displayid_any.is_none() {
+                    displayid_any = any;
+                }
+            }
+            EXT_TAG_CTA => {
+                if cta_dtd.is_none() {
+                    cta_dtd = parse_cta_extension(block);
+                }
+            }
+            _ => (),
+        }
+    }
+
+    let preferred = displayid_preferred
+        .or(base_dtd)
+        .or(displayid_any)
+        .or(cta_dtd)
+        .ok_or(EdidError::NoTiming)?;
+
+    Ok(DecodedEdid {
+        preferred,
+        extensions_truncated,
+        bad_extension_blocks,
+    })
+}
