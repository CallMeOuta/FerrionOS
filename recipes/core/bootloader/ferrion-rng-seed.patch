+//! A random seed from the firmware (FerrionOS). Through EFI_RNG_PROTOCOL, when the firmware has
+//! it, the bootloader asks for 32 bytes with the firmware's default algorithm and leaves them in a
+//! reserved page of their own. The kernel gets only the page's address and the seed's size, as
+//! `RNG_SEED_ADDR` and `RNG_SEED_SIZE`, after the measured part of the environment; init hands the
+//! two to randd alone, which mixes the bytes into its key and overwrites the page with zeros.
+//! Without the protocol (OVMF offers it only with RDRAND or a virtio-rng device) nothing is
+//! passed and randd relies on its other sources.
+
+use std::proto::Protocol;
+use uefi::guid::{Guid, RNG_PROTOCOL_GUID};
+use uefi::status::Status;
+
+use crate::os::Os;
+
+/// The size of the seed: the key size of randd's ChaCha20 generator.
+pub const SEED_SIZE: usize = 32;
+
+#[allow(non_snake_case)]
+#[repr(C)]
+pub struct RngProtocol {
+    GetInfo: usize,
+    GetRNG: extern "efiapi" fn(
+        This: *mut RngProtocol,
+        RNGAlgorithm: *const Guid,
+        RNGValueLength: usize,
+        RNGValue: *mut u8,
+    ) -> Status,
+}
+
+struct Rng(&'static mut RngProtocol);
+
+impl Protocol<RngProtocol> for Rng {
+    fn guid() -> Guid {
+        RNG_PROTOCOL_GUID
+    }
+
+    fn new(inner: &'static mut RngProtocol) -> Self {
+        Rng(inner)
+    }
+}
+
+/// The seed, written by the firmware straight into a reserved page, or None without the protocol.
+pub fn seed<O: Os>(os: &O) -> Option<&'static [u8]> {
+    let rng = Rng::locate_protocol().ok()?;
+    let page = os.alloc_zeroed_page_aligned(SEED_SIZE);
+    if page.is_null() {
+        return None;
+    }
+    let this: *mut RngProtocol = rng.0;
+    let status = (rng.0.GetRNG)(this, core::ptr::null(), SEED_SIZE, page);
+    if !status.is_success() {
+        unsafe { core::ptr::write_bytes(page, 0, SEED_SIZE) };
+        log::warn!("EFI_RNG_PROTOCOL returned {:?}; passing no seed", status);
+        return None;
+    }
+    Some(unsafe { core::slice::from_raw_parts(page, SEED_SIZE) })
+}
