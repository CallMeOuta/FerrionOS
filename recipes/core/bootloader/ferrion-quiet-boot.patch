+/// How long a boot waits, on a blank screen, for a key that asks for the mode menu and the
+/// status text instead of a quiet boot.
+const MENU_KEY_WINDOW_MS: u64 = 1000;
+
+/// Whether a key arrives within `timeout_ms`; the key itself is dropped.
+fn key_pressed_within(st: &SystemTable, timeout_ms: u64) -> bool {
+    // Poll rather than wait on a timer event: the uefi crate does not expose SetTimer, and a
+    // 10 ms poll costs nothing at this point
+    let mut key = TextInputKey {
+        ScanCode: 0,
+        UnicodeChar: 0,
+    };
+    for _ in 0..timeout_ms.div_ceil(10) {
+        if (st.ConsoleIn.ReadKeyStroke)(st.ConsoleIn, &mut key).is_success() {
+            return true;
+        }
+        let _ = (st.BootServices.Stall)(10_000);
+    }
+    false
+}
+
