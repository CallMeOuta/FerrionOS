+// A quiet boot (`crate::QUIET`) keeps the bootloader's status text off the screen. These two
+// shadow uefi_std's `print!` and `println!` in the rest of the crate, which sees them after
+// `mod os`; errors, panics and prompts print through `loud_print!` and `loud_println!`.
+macro_rules! print {
+    ($($arg:tt)*) => {
+        if !$crate::QUIET.load(core::sync::atomic::Ordering::Relaxed) {
+            std::io::_print(format_args!($($arg)*));
+        }
+    };
+}
+
+macro_rules! println {
+    () => (print!("\n"));
+    ($($arg:tt)*) => ({
+        print!($($arg)*);
+        print!("\n");
+    });
+}
+
+macro_rules! loud_print {
+    ($($arg:tt)*) => (std::io::_print(format_args!($($arg)*)));
+}
+
+macro_rules! loud_println {
+    () => (loud_print!("\n"));
+    ($($arg:tt)*) => ({
+        loud_print!($($arg)*);
+        loud_print!("\n");
+    });
+}
