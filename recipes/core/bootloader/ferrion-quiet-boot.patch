+/// Paints a whole framebuffer in the background color, so that a quiet boot shows nothing until
+/// the OS draws. The framebuffer has 32-bit pixels, as the kernel and the display drivers expect.
+fn fill_background(mode: &OsVideoMode) {
+    if mode.base == 0 {
+        return;
+    }
+    let pixels = unsafe {
+        slice::from_raw_parts_mut(mode.base as *mut u32, (mode.stride * mode.height) as usize)
+    };
+    pixels.fill(BACKGROUND_COLOR);
+}
