+
+    fn get_key_timeout(&self, timeout_ms: u64) -> Option<OsKey> {
+        // Poll rather than wait on a timer event: the uefi crate does not
+        // expose SetTimer, and a 10 ms poll costs nothing at this point.
+        let mut key = TextInputKey {
+            ScanCode: 0,
+            UnicodeChar: 0,
+        };
+        for _ in 0..timeout_ms.div_ceil(10) {
+            match status_to_result((self.st.ConsoleIn.ReadKeyStroke)(
+                self.st.ConsoleIn,
+                &mut key,
+            )) {
+                Ok(_) => return Some(key_to_os(&key)),
+                Err(_) => {
+                    let _ = (self.st.BootServices.Stall)(10_000);
+                }
+            }
         }
+        None
     }
 
