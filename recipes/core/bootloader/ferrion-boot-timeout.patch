+fn key_to_os(key: &TextInputKey) -> OsKey {
+    match key.ScanCode {
+        0 => match key.UnicodeChar {
+            8 => OsKey::Backspace,
+            13 => OsKey::Enter,
+            w => match char::from_u32(w as u32) {
+                Some(c) => OsKey::Char(c),
+                None => OsKey::Other,
+            },
+        },
+        1 => OsKey::Up,
+        2 => OsKey::Down,
+        3 => OsKey::Right,
+        4 => OsKey::Left,
+        8 => OsKey::Delete,
+        _ => OsKey::Other,
+    }
+}
