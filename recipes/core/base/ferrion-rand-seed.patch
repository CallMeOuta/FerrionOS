+impl Seeder {
+    fn new() -> Self {
+        let mut digest = Sha256::new();
+        digest.input(b"FerrionOS randd seed v1");
+        Seeder {
+            digest,
+            sources: Vec::new(),
+            strong: false,
+        }
+    }
