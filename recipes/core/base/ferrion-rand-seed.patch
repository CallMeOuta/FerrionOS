+/// A cycle or tick counter for timing jitter.
+#[cfg(target_arch = "x86_64")]
+fn counter() -> u64 {
+    let (low, high): (u32, u32);
+    unsafe { asm!("rdtsc", out("eax") low, out("edx") high, options(nomem, nostack)) };
+    (u64::from(high) << 32) | u64::from(low)
