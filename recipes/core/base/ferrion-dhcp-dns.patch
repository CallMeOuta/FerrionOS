+fn first_dns_server(data: &[u8]) -> Option<[u8; 4]> {
+    // Option 6 contains one or more IPv4 addresses in preference order.
+    if data.is_empty() || data.len() % 4 != 0 {
+        return None;
+    }
+    Some([data[0], data[1], data[2], data[3]])
+}
