     device.transport.finalize_features();
 
     // Queue for sending control commands.
@@ -573,6 +588,7 @@ fn daemon(daemon: daemon::Daemon, mut pcid_handle: PciFunctionHandle) -> anyhow:
         cursor_queue.clone(),
         device.transport.clone(),
         has_edid,
+        features,
         frame_waker,
