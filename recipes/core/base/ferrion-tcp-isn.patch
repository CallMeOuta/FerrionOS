index 00000000..859b8c3e
--- /dev/null
+++ b/netstack/src/isn.rs
@@ -0,0 +1,150 @@
+//! TCP initial sequence numbers as RFC 6528 describes them: a clock that ticks every 4
+//! microseconds plus a keyed hash (SipHash-2-4) of the connection's addresses and ports.
+//! Numbers of one connection tell nothing about those of another, and a connection reopened
+//! with the same addresses and ports starts further along than before.
+
+use std::io;
+use std::sync::OnceLock;
+
+use smoltcp::time::Instant;
+use smoltcp::wire::{IpAddress, IpEndpoint};
+
+static KEY: OnceLock<[u64; 2]> = OnceLock::new();
+
+/// Reads the hash key from the random scheme; call before the interface opens a connection.
+pub fn init() -> io::Result<()> {
+    let key = [crate::random::u64()?, crate::random::u64()?];
+    KEY.set(key)
+        .map_err(|_| io::Error::other("the sequence number key is already set"))
+}
+
+/// The generator the interface calls for each connection it opens or accepts.
+pub fn initial_seq_no(local: IpEndpoint, remote: IpEndpoint, now: Instant) -> u32 {
+    let key = KEY
+        .get()
+        .expect("isn::init runs before the interface is built");
+    seq_no(*key, local, remote, now)
+}
+
+fn seq_no(key: [u64; 2], local: IpEndpoint, remote: IpEndpoint, now: Instant) -> u32 {
+    let mut tuple = Vec::with_capacity(36);
+    for endpoint in [local, remote] {
+        match endpoint.addr {
+            IpAddress::Ipv4(addr) => tuple.extend_from_slice(&addr.octets()),
+        }
+        tuple.extend_from_slice(&endpoint.port.to_be_bytes());
+    }
+    let ticks = (now.total_micros() / 4) as u32;
+    ticks.wrapping_add(siphash24(key, &tuple) as u32)
+}
+
+fn siphash24(key: [u64; 2], data: &[u8]) -> u64 {
+    let mut v = [
+        key[0] ^ 0x736f_6d65_7073_6575,
+        key[1] ^ 0x646f_7261_6e64_6f6d,
+        key[0] ^ 0x6c79_6765_6e65_7261,
+        key[1] ^ 0x7465_6462_7974_6573,
+    ];
+    let round = |v: &mut [u64; 4]| {
+        v[0] = v[0].wrapping_add(v[1]);
+        v[1] = v[1].rotate_left(13) ^ v[0];
+        v[0] = v[0].rotate_left(32);
+        v[2] = v[2].wrapping_add(v[3]);
+        v[3] = v[3].rotate_left(16) ^ v[2];
+        v[0] = v[0].wrapping_add(v[3]);
+        v[3] = v[3].rotate_left(21) ^ v[0];
+        v[2] = v[2].wrapping_add(v[1]);
+        v[1] = v[1].rotate_left(17) ^ v[2];
+        v[2] = v[2].rotate_left(32);
+    };
+    let mut compress = |m: u64| {
+        v[3] ^= m;
+        round(&mut v);
+        round(&mut v);
+        v[0] ^= m;
+    };
+    let words = data.chunks_exact(8);
+    let mut last = (data.len() as u64) << 56;
+    for (i, byte) in words.remainder().iter().enumerate() {
+        last |= u64::from(*byte) << (8 * i);
+    }
+    for word in words {
+        compress(u64::from_le_bytes(word.try_into().unwrap()));
+    }
+    compress(last);
+    v[2] ^= 0xff;
+    for _ in 0..4 {
+        round(&mut v);
+    }
+    v[0] ^ v[1] ^ v[2] ^ v[3]
+}
+
+#[cfg(test)]
+mod tests {
+    use smoltcp::wire::Ipv4Address;
+
+    use super::*;
+
+    const KEY: [u64; 2] = [0x0706_0504_0302_0100, 0x0f0e_0d0c_0b0a_0908];
+
+    fn endpoint(last: u8, port: u16) -> IpEndpoint {
+        IpEndpoint::new(IpAddress::Ipv4(Ipv4Address::new(10, 0, 2, last)), port)
+    }
+
+    #[test]
+    fn siphash_reference_vectors() {
+        // The SipHash paper's appendix A, and the first and last entries of its vectors.h.
+        let message: Vec<u8> = (0..15).collect();
+        assert_eq!(siphash24(KEY, &message), 0xa129_ca61_49be_45e5);
+        assert_eq!(siphash24(KEY, &[]), 0x726f_db47_dd0e_0e31);
+        let message: Vec<u8> = (0..63).collect();
+        assert_eq!(siphash24(KEY, &message), 0x958a_324c_eb06_4572);
+    }
+
+    #[test]
+    #[allow(deprecated)] // std's SipHasher is SipHash-2-4, kept only to check this one
+    fn siphash_matches_std() {
+        use std::hash::{Hasher, SipHasher};
+        let data: Vec<u8> = (0..40u8).map(|n| n.wrapping_mul(37)).collect();
+        for len in 0..=data.len() {
+            let mut std_hash = SipHasher::new_with_keys(KEY[0], KEY[1]);
+            std_hash.write(&data[..len]);
+            assert_eq!(
+                siphash24(KEY, &data[..len]),
+                std_hash.finish(),
+                "length {len}"
+            );
+        }
+    }
+
+    #[test]
+    fn same_connection_moves_with_the_clock() {
+        let (local, remote) = (endpoint(15, 50_000), endpoint(2, 80));
+        let first = seq_no(KEY, local, remote, Instant::from_micros(1_000));
+        let later = seq_no(KEY, local, remote, Instant::from_micros(1_000 + 4 * 1234));
+        assert_eq!(later.wrapping_sub(first), 1234);
+    }
+
+    #[test]
+    fn other_ports_and_keys_give_unrelated_numbers() {
+        let now = Instant::from_micros(0);
+        let remote = endpoint(2, 80);
+        let numbers: Vec<u32> = (50_000..50_020)
+            .map(|port| seq_no(KEY, endpoint(15, port), remote, now))
+            .collect();
+        let steps: Vec<u32> = numbers
+            .windows(2)
+            .map(|w| w[1].wrapping_sub(w[0]))
+            .collect();
+        assert!(steps.windows(2).all(|w| w[0] != w[1]), "{numbers:?}");
+        let other_key = [KEY[0] ^ 1, KEY[1]];
+        assert_ne!(
+            seq_no(KEY, endpoint(15, 50_000), remote, now),
+            seq_no(other_key, endpoint(15, 50_000), remote, now)
+        );
+        assert_ne!(
+            seq_no(KEY, endpoint(15, 50_000), remote, now),
+            seq_no(KEY, remote, endpoint(15, 50_000), now)
+        );
+    }
+}
