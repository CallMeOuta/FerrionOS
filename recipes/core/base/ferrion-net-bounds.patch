--- /dev/null
+++ b/netstack/src/scheme/recvmsg.rs
@@ -0,0 +1,103 @@
+//! The buffer of a RecvMsg call. The caller writes three sizes at its start: the room it
+//! has for the sender's name, for the payload and for ancillary data. The reply replaces
+//! them with the name's length and bytes, then the payload's length and bytes. Each length
+//! is a little-endian `usize`.
+
+use syscall::{Error, Result, EINVAL};
+
+const WORD: usize = size_of::<usize>();
+
+pub struct Request {
+    pub name_len: usize,
+    pub payload_len: usize,
+}
+
+impl Request {
+    /// EINVAL when the buffer is shorter than the three sizes or than they add up to.
+    pub fn parse(buf: &[u8]) -> Result<Self> {
+        let word = |index: usize| {
+            buf.get(index * WORD..(index + 1) * WORD)
+                .map(|bytes| usize::from_le_bytes(bytes.try_into().unwrap()))
+                .ok_or(Error::new(EINVAL))
+        };
+        let (name_len, payload_len, control_len) = (word(0)?, word(1)?, word(2)?);
+        let total = [name_len, payload_len, control_len]
+            .into_iter()
+            .try_fold(3 * WORD, usize::checked_add);
+        match total {
+            Some(total) if total <= buf.len() => Ok(Self {
+                name_len,
+                payload_len,
+            }),
+            _ => Err(Error::new(EINVAL)),
+        }
+    }
+}
+
+/// Writes the name's length and bytes and returns where a payload of `payload_len` bytes
+/// starts. EINVAL, with nothing written, when the reply would not fit in the buffer.
+pub fn write_name(buf: &mut [u8], name: &[u8], payload_len: usize) -> Result<usize> {
+    let start = 2 * WORD + name.len();
+    if start
+        .checked_add(payload_len)
+        .is_none_or(|end| end > buf.len())
+    {
+        return Err(Error::new(EINVAL));
+    }
+    buf[..WORD].copy_from_slice(&name.len().to_le_bytes());
+    buf[WORD..WORD + name.len()].copy_from_slice(name);
+    Ok(start)
+}
+
+/// Writes the payload's length in front of the payload that starts at `start`, as returned
+/// by [`write_name`].
+pub fn write_payload_len(buf: &mut [u8], start: usize, payload_len: usize) {
+    buf[start - WORD..start].copy_from_slice(&payload_len.to_le_bytes());
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn request(sizes: [usize; 3], len: usize) -> Vec<u8> {
+        let mut buf = vec![0; len];
+        for (index, size) in sizes.iter().enumerate() {
+            buf[index * WORD..(index + 1) * WORD].copy_from_slice(&size.to_le_bytes());
+        }
+        buf
+    }
+
+    #[test]
+    fn short_or_overflowing_requests_are_refused() {
+        for len in 0..3 * WORD {
+            assert!(Request::parse(&vec![0; len]).is_err(), "length {len}");
+        }
+        assert!(Request::parse(&request([1, 0, 0], 3 * WORD)).is_err());
+        assert!(Request::parse(&request([0, 100, 0], 3 * WORD + 99)).is_err());
+        // Sizes whose sum wraps around to a small number.
+        assert!(Request::parse(&request([usize::MAX - 8, 16, 0], 3 * WORD)).is_err());
+        assert!(Request::parse(&request([usize::MAX, usize::MAX, usize::MAX], 64)).is_err());
+    }
+
+    #[test]
+    fn a_request_that_fits_is_read() {
+        let parsed = Request::parse(&request([16, 100, 8], 3 * WORD + 124)).unwrap();
+        assert_eq!((parsed.name_len, parsed.payload_len), (16, 100));
+    }
+
+    #[test]
+    fn a_reply_is_written_only_when_it_fits() {
+        let name = b"/scheme/udp/127.0.0.1:50000";
+        let mut buf = request([0, 0, 0], 2 * WORD + name.len() + 9);
+        assert!(write_name(&mut buf, name, 10).is_err());
+        assert!(write_name(&mut buf, name, usize::MAX).is_err());
+        assert_eq!(&buf[..WORD], &0usize.to_le_bytes(), "nothing written");
+
+        let start = write_name(&mut buf, name, 9).unwrap();
+        assert_eq!(start, 2 * WORD + name.len());
+        write_payload_len(&mut buf, start, 9);
+        assert_eq!(&buf[..WORD], &name.len().to_le_bytes());
+        assert_eq!(&buf[WORD..WORD + name.len()], name);
+        assert_eq!(&buf[start - WORD..start], &9usize.to_le_bytes());
+    }
+}
