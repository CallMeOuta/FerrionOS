diff --git a/netstack/src/scheme/tests.rs b/netstack/src/scheme/tests.rs
new file mode 100644
index 00000000..e6c7868b
--- /dev/null
+++ b/netstack/src/scheme/tests.rs
@@ -0,0 +1,204 @@
+//! Calls a program can make on a `tcp` or `udp` socket with data waiting, over smoltcp's
+//! loopback device: each one either works or fails with an error, and the socket keeps
+//! working afterwards.
+
+use smoltcp::iface::{Config, Interface, SocketHandle};
+use smoltcp::phy::{Loopback, Medium};
+use smoltcp::socket::tcp::{Socket as TcpSocket, SocketBuffer as TcpSocketBuffer};
+use smoltcp::socket::udp::{
+    PacketBuffer as UdpSocketBuffer, PacketMetadata as UdpPacketMetadata, Socket as UdpSocket,
+};
+use smoltcp::time::Instant;
+use smoltcp::wire::{HardwareAddress, IpAddress, IpCidr, IpEndpoint, IpListenEndpoint};
+use syscall::{EINVAL, EMSGSIZE};
+
+use super::socket::{SchemeFile, SchemeSocket, SocketFile};
+use super::SocketSet;
+
+const WORD: usize = size_of::<usize>();
+const LOCALHOST: IpAddress = IpAddress::v4(127, 0, 0, 1);
+
+struct Loop {
+    device: Loopback,
+    iface: Interface,
+    sockets: SocketSet,
+}
+
+impl Loop {
+    fn new() -> Self {
+        let mut device = Loopback::new(Medium::Ip);
+        let mut iface =
+            Interface::new(Config::new(HardwareAddress::Ip), &mut device, Instant::ZERO);
+        iface.update_ip_addrs(|addrs| addrs.push(IpCidr::new(LOCALHOST, 8)).unwrap());
+        Loop {
+            device,
+            iface,
+            sockets: SocketSet::new(vec![]),
+        }
+    }
+
+    fn poll(&mut self) {
+        for _ in 0..8 {
+            self.iface
+                .poll(Instant::ZERO, &mut self.device, &mut self.sockets);
+        }
+    }
+
+    fn udp(&mut self, port: u16) -> SocketHandle {
+        let buffer = || UdpSocketBuffer::new(vec![UdpPacketMetadata::EMPTY; 4], vec![0; 4096]);
+        let mut socket = UdpSocket::new(buffer(), buffer());
+        socket.bind(port).unwrap();
+        self.sockets.add(socket)
+    }
+
+    /// A UDP socket on port 5000 holding one datagram of `len` bytes from port 5001.
+    fn udp_with_datagram(len: usize) -> (Self, SocketHandle) {
+        let mut net = Loop::new();
+        let (receiver, sender) = (net.udp(5000), net.udp(5001));
+        net.sockets
+            .get_mut::<UdpSocket>(sender)
+            .send_slice(&vec![7; len], IpEndpoint::new(LOCALHOST, 5000))
+            .unwrap();
+        net.poll();
+        (net, receiver)
+    }
+
+    /// The accepted end of a TCP connection over loopback, holding `len` bytes.
+    fn tcp_with_data(len: usize) -> (Self, SocketHandle) {
+        let mut net = Loop::new();
+        let new_socket = || {
+            TcpSocket::new(
+                TcpSocketBuffer::new(vec![0; 4096]),
+                TcpSocketBuffer::new(vec![0; 4096]),
+            )
+        };
+        let mut server = new_socket();
+        server.listen(5000).unwrap();
+        let server = net.sockets.add(server);
+        let client = net.sockets.add(new_socket());
+        net.sockets
+            .get_mut::<TcpSocket>(client)
+            .connect(net.iface.context(), IpEndpoint::new(LOCALHOST, 5000), 5001)
+            .unwrap();
+        net.poll();
+        net.sockets
+            .get_mut::<TcpSocket>(client)
+            .send_slice(&vec![7; len])
+            .unwrap();
+        net.poll();
+        (net, server)
+    }
+}
+
+/// A RecvMsg buffer of `len` bytes that starts with the three sizes.
+fn request(sizes: [usize; 3], len: usize) -> Vec<u8> {
+    let mut buf = vec![0; len.max(3 * WORD)];
+    for (index, size) in sizes.iter().enumerate() {
+        buf[index * WORD..(index + 1) * WORD].copy_from_slice(&size.to_le_bytes());
+    }
+    buf.truncate(len);
+    buf
+}
+
+fn errno<T: std::fmt::Debug>(result: syscall::Result<T>) -> i32 {
+    result.unwrap_err().errno
+}
+
+#[test]
+fn udp_recvmsg_refuses_short_and_overflowing_buffers() {
+    let (mut net, receiver) = Loop::udp_with_datagram(100);
+    let socket = net.sockets.get_mut::<UdpSocket>(receiver);
+    let mut file = SchemeFile::Socket(SocketFile::new_with_data(
+        receiver,
+        IpListenEndpoint::default(),
+    ));
+
+    for len in [0, 8, 3 * WORD - 1] {
+        let mut how = vec![0; len];
+        assert_eq!(
+            errno(socket.handle_recvmsg(&mut file, &mut how, 0)),
+            EINVAL,
+            "{len} bytes"
+        );
+    }
+    // Sizes that add up past usize::MAX to fewer bytes than the buffer holds.
+    let mut how = request([usize::MAX - 8, 16, 0], 3 * WORD);
+    assert_eq!(errno(socket.handle_recvmsg(&mut file, &mut how, 0)), EINVAL);
+    // Room for a 1-byte name, but the sender's path is longer.
+    let mut how = request([1, 100, 0], 3 * WORD + 101);
+    assert_eq!(errno(socket.handle_recvmsg(&mut file, &mut how, 0)), EINVAL);
+
+    // The datagram is still there for a call that fits, which takes 10 bytes of it.
+    let mut how = request([64, 10, 0], 3 * WORD + 74);
+    let name = b"/scheme/udp/127.0.0.1:5001";
+    let reply = socket.handle_recvmsg(&mut file, &mut how, 0).unwrap();
+    assert_eq!(reply, 2 * WORD + name.len() + 10);
+    assert_eq!(&how[..WORD], &name.len().to_le_bytes());
+    assert_eq!(&how[WORD..WORD + name.len()], name);
+    assert_eq!(
+        &how[WORD + name.len()..2 * WORD + name.len()],
+        &10usize.to_le_bytes()
+    );
+    assert_eq!(&how[2 * WORD + name.len()..reply], &[7; 10]);
+    assert!(
+        !UdpSocket::can_recv(socket),
+        "the rest of the datagram is dropped"
+    );
+}
+
+#[test]
+fn udp_read_cuts_a_long_datagram() {
+    let (mut net, receiver) = Loop::udp_with_datagram(100);
+    let socket = net.sockets.get_mut::<UdpSocket>(receiver);
+    let mut file = SocketFile::new_with_data(receiver, IpListenEndpoint::default());
+    let mut buf = [0; 1];
+    assert_eq!(socket.read_buf(&mut file, &mut buf).unwrap(), 1);
+    assert_eq!(buf, [7]);
+    assert!(!UdpSocket::can_recv(socket));
+}
+
+#[test]
+fn udp_write_refuses_the_unspecified_address_and_oversized_datagrams() {
+    let mut net = Loop::new();
+    let sender = net.udp(5001);
+    let socket = net.sockets.get_mut::<UdpSocket>(sender);
+    let unspecified = IpListenEndpoint::from((IpAddress::v4(0, 0, 0, 0), 5000));
+    let mut file = SocketFile::new_with_data(sender, unspecified);
+    assert_eq!(errno(socket.write_buf(&mut file, &[1; 10])), EINVAL);
+
+    let mut file = SocketFile::new_with_data(sender, IpListenEndpoint::from((LOCALHOST, 5000)));
+    assert_eq!(errno(socket.write_buf(&mut file, &[1; 5000])), EMSGSIZE);
+    assert_eq!(socket.write_buf(&mut file, &[1; 10]).unwrap(), 10);
+}
+
+#[test]
+fn tcp_recvmsg_refuses_a_reply_that_does_not_fit() {
+    let (mut net, server) = Loop::tcp_with_data(100);
+    let socket = net.sockets.get_mut::<TcpSocket>(server);
+    assert!(
+        TcpSocket::can_recv(socket),
+        "the loopback connection carries the data"
+    );
+    let mut file = SchemeFile::Socket(SocketFile::new_with_data(server, None));
+
+    for len in [0, 8, 3 * WORD - 1] {
+        let mut how = vec![0; len];
+        assert_eq!(
+            errno(socket.handle_recvmsg(&mut file, &mut how, 0)),
+            EINVAL,
+            "{len} bytes"
+        );
+    }
+    // No room asked for, so the peer's path does not fit.
+    let mut how = request([0, 0, 0], 3 * WORD);
+    assert_eq!(errno(socket.handle_recvmsg(&mut file, &mut how, 0)), EINVAL);
+    let mut how = request([0, usize::MAX - 8, 16], 3 * WORD);
+    assert_eq!(errno(socket.handle_recvmsg(&mut file, &mut how, 0)), EINVAL);
+
+    let mut how = request([64, 100, 0], 3 * WORD + 164);
+    let name = b"/scheme/tcp/127.0.0.1:5001";
+    let reply = socket.handle_recvmsg(&mut file, &mut how, 0).unwrap();
+    assert_eq!(reply, 2 * WORD + name.len() + 100);
+    assert_eq!(&how[WORD..WORD + name.len()], name);
+    assert_eq!(&how[2 * WORD + name.len()..reply], &[7; 100]);
+}
