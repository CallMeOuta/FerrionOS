FerrionOS change to base (MIT license, kept), made against upstream commit 20f7573b4dc011ea5267189185edc0b2f12bab0f with every patch listed before it in recipes/core/base/recipe.toml applied. It touches drivers/ only.
- virtio-gpud leaves the initfs: the initfs pcid-spawner no longer claims 1af4:1050, and the root file system's pcid-spawner starts /usr/lib/drivers/virtio-gpud from /usr/lib/pcid.d/virtio-gpud.toml. A filesystem config can then put another driver on the device by writing /etc/pcid.d/virtio-gpud.toml, which pcid-spawner reads in place of the file of the same name in /usr/lib/pcid.d; FerrionOS's driver host (ADR 0046) uses this.
- Until the root file system is mounted and its pcid-spawner has started virtio-gpud, the screen is the firmware's framebuffer as vesad drives it, showing fbbootlogd's boot splash or log, as it does before virtio-gpud's start today; virtio-gpud then takes the display over through inputd, a few seconds later in the boot than from the initfs.

--- a/Makefile
+++ b/Makefile
@@ -15,10 +15,10 @@
 INITFS_BINS = ipcd init logd ramfs randd udsd zerod \
 	acpid fbbootlogd hwd inputd lived \
 	pcid pcid-spawner rtcd vesad
-INITFS_DRIVERS_BINS = nvmed virtio-blkd virtio-gpud
+INITFS_DRIVERS_BINS = nvmed virtio-blkd
 BASE_BINS = fbcond getty inputd pcid pcid-spawner redoxerd audiod dhcpd ptyd netstack nbdd
 DRIVERS_BINS = e1000d ihdad ihdgd ixgbed rtl8139d rtl8168d \
-	usbctl usbhidd usbhubd usbscsid virtio-netd xhcid
+	usbctl usbhidd usbhubd usbscsid virtio-gpud virtio-netd xhcid
 SELFTEST_DIRS := $(patsubst selftests/%/Cargo.toml,%,$(wildcard selftests/*/Cargo.toml))
 TEST_BINS := $(addsuffix -selftest,$(SELFTEST_DIRS))
 
--- a/drivers/initfs.toml
+++ b/drivers/initfs.toml
@@ -47,10 +47,3 @@
 vendor = 0x1AF4
 device = 0x1042
 command = ["/scheme/initfs/lib/drivers/virtio-blkd"]
-
-[[drivers]]
-name = "virtio-gpu"
-class = 3
-vendor = 0x1AF4
-device = 0x1050
-command = ["/scheme/initfs/lib/drivers/virtio-gpud"]
--- /dev/null
+++ b/drivers/graphics/virtio-gpud/config.toml
@@ -0,0 +1,6 @@
+[[drivers]]
+name = "virtio-gpu"
+class = 3
+vendor = 0x1AF4
+device = 0x1050
+command = ["virtio-gpud"]
