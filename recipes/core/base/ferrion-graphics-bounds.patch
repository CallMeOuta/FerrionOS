+/// The error a program gets when the device refuses a resource command.
+fn refused(ty: CommandTy) -> Error {
+    let errno = if ty == CommandTy::RespErrOutOfMemory {
+        ENOMEM
+    } else {
+        EINVAL
+    };
+    Error::SyscallError(libredox::error::Error::new(errno))
+}
