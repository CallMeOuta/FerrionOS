FerrionOS change to upstream RedoxFS (MIT license, kept), made against upstream commit 5ba45a6887374ab425326656a276bb3b62eba7dc.

Unchanged transactions must not trigger periodic allocator GC on a read-only boot disk. Explicit squash remains a writing operation; the next changed transaction at the threshold still compacts the log.

diff --git a/src/transaction.rs b/src/transaction.rs
index d0931e5..7ffb84e 100644
--- a/src/transaction.rs
+++ b/src/transaction.rs
@@ -266,6 +266,15 @@ impl<'a, D: Disk> Transaction<'a, D> {
 
     /// Write all changes cached in this [`Transaction`] to disk.
     pub fn sync(&mut self, force_squash: bool) -> Result<bool> {
+        if !force_squash
+            && !self.header_changed
+            && self.write_cache.is_empty()
+            && self.allocator_log.is_empty()
+            && self.deallocate.is_empty()
+        {
+            return Ok(false);
+        }
+
         // Make sure alloc is synced
         self.sync_allocator(force_squash)?;
 
diff --git a/examples/boot_gc_generation.rs b/examples/boot_gc_generation.rs
new file mode 100644
--- /dev/null
+++ b/examples/boot_gc_generation.rs
@@ -0,0 +1,18 @@
+use redoxfs::{ALLOC_GC_THRESHOLD, Disk, DiskFile, FileSystem, HEADER_RING};
+
+fn main() {
+    let path = std::env::args_os().nth(1).expect("usage: boot_gc_generation IMAGE");
+    let mut fs = FileSystem::open(DiskFile::open(path).unwrap(), None, None, false).unwrap();
+    assert!(!fs.header.encrypted(), "the fixture requires an unencrypted image");
+    let previous = fs.header.generation();
+    let generation = (previous / ALLOC_GC_THRESHOLD + 1) * ALLOC_GC_THRESHOLD;
+    fs.header.generation = (generation - 1).into();
+    assert_eq!(fs.header.update(None), generation);
+    assert!(fs.header.valid());
+    let block = fs.block + generation % HEADER_RING;
+    let written = unsafe { fs.disk.write_at(block, &fs.header).unwrap() };
+    assert_eq!(written, fs.header.len());
+    let fs = FileSystem::open(fs.disk, None, None, false).unwrap();
+    assert_eq!(fs.header.generation(), generation);
+    println!("generation {previous} -> {generation}; header block {block}");
+}
