+    let both_on_stdin = key_file.as_deref() == Some("-") && new_key_file.as_deref() == Some("-");
+    let (password, mut stdin_new) = if both_on_stdin {
+        let both = read_secret(Some("-"), "")?;
+        let split = both
+            .0
+            .iter()
+            .position(|&b| b == 0)
+            .ok_or("with --key-file - and --new-key-file -, stdin holds OLD, a NUL byte, then NEW")?;
