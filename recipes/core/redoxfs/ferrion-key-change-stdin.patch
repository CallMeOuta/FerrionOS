+        let new = Secret(both.0[split + 1..].to_vec());
+        if old.0.is_empty() || new.0.is_empty() || new.0.contains(&0) {
+            return Err("passphrase must contain 1 to 4096 bytes".into());
+        }
+        (old, Some(new))
+    } else {
+        (read_secret(key_file.as_deref(), "Current passphrase")?, None)
+    };
     let mut volume = Volume::open(&path, &password.0)?;
