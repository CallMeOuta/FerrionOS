FerrionOS change to upstream RedoxFS (MIT license, kept), made against upstream commit 5ba45a6887374ab425326656a276bb3b62eba7dc after the existing recipe patches.

redoxfs-key with both --key-file - and --new-key-file - reads the current passphrase, a NUL byte and the new passphrase from standard input, so a privileged caller passes both without a file.

diff -r a/src/bin/key.rs b/src/bin/key.rs
--- a/src/bin/key.rs
+++ b/src/bin/key.rs
@@ -1,4 +1,3 @@
-#[cfg(target_os = "redox")]
 use redoxfs::key_tool::Secret;
 use redoxfs::key_tool::{read_secret, recovery_key, require_seeded_random};
 use redoxfs::{DiskFile, FileSystem, Header, KeySlot, Salt};
@@ -101,7 +100,23 @@
