+pub type Fmaps = PageCache<MappedPages>;
+
+pub fn now() -> Time {
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap();
+    (now.as_secs(), now.subsec_nanos())
+}
+
+pub struct MappedPages {
+    base: *mut u8,
+    len: usize,
+}
+
+impl PageMemory for MappedPages {
+    fn allocate(len: usize) -> Result<Self> {
+        let base = unsafe {
+            libredox::call::mmap(MmapArgs {
+                length: len,
+                prot: libredox::flag::PROT_READ | libredox::flag::PROT_WRITE,
+                flags: libredox::flag::MAP_PRIVATE,
+                offset: 0,
+                fd: !0,
+                addr: core::ptr::null_mut(),
+            })? as *mut u8
+        };
+        Ok(Self { base, len })
+    }
+
+    fn grow(&mut self, len: usize) -> Result<()> {
+        let base = unsafe {
+            syscall::syscall5(
+                syscall::SYS_MREMAP,
+                self.base as usize,
+                self.len,
+                0,
+                len,
+                syscall::MremapFlags::empty().bits() | (PROT_READ | PROT_WRITE).bits(),
+            )? as *mut u8
+        };
+        self.base = base;
+        self.len = len;
+        Ok(())
+    }
+
+    fn bytes(&mut self) -> &mut [u8] {
+        unsafe { slice::from_raw_parts_mut(self.base, self.len) }
+    }
+}
+
+impl Drop for MappedPages {
+    fn drop(&mut self) {
+        if let Err(err) = unsafe { libredox::call::munmap(self.base.cast(), self.len) } {
+            log::error!("munmap of mapped file pages failed: {err}");
+        }
+    }
+}
 
