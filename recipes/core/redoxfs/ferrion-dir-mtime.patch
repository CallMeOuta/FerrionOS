+fn touch_dir<D: Disk>(tx: &mut Transaction<D>, dir: TreePtr<Node>) -> Result<()> {
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap();
+    tx.touch_dir(dir, now.as_secs(), now.subsec_nanos())
