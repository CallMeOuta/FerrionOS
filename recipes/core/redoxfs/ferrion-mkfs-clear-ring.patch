+#[test]
+fn create_over_used_disk_opens_new_volume() {
+    use crate::{DiskFile, HEADER_RING};
+    let path = format!("ring-reuse-{}.bin", IMAGE_SEQ.fetch_add(1, Relaxed));
+    let disk = DiskSparse::create(&path, 16 * 1024 * 1024).unwrap();
+    let mut old = FileSystem::create(disk, None, 0, 0).unwrap();
+    // Push the old volume's generation past every slot of the ring
+    for _ in 0..HEADER_RING {
+        old.tx(|tx| {
+            tx.header_changed = true;
+            Ok(())
+        })
+        .unwrap();
+    }
+    let old_uuid = old.header.uuid();
+    drop(old);
+    let new = FileSystem::create(DiskFile::open(&path).unwrap(), Some(b"new"), 0, 0).unwrap();
+    let new_uuid = new.header.uuid();
+    drop(new);
+    assert_ne!(old_uuid, new_uuid);
+    let error = FileSystem::open(DiskFile::open(&path).unwrap(), None, None, false)
+        .err()
+        .expect("the new volume is encrypted and needs its passphrase");
+    assert_eq!(error.errno, syscall::ENOKEY);
+    let opened =
+        FileSystem::open(DiskFile::open(&path).unwrap(), Some(b"new"), None, false).unwrap();
+    assert_eq!(opened.header.uuid(), new_uuid);
+    drop(opened);
+    fs::remove_file(path).unwrap();
+}
