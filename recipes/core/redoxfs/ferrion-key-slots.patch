diff --git a/src/bin/key.rs b/src/bin/key.rs
new file mode 100644
index 0000000..01f3e99
--- /dev/null
+++ b/src/bin/key.rs
@@ -0,0 +1,192 @@
+#[cfg(target_os = "redox")]
+use redoxfs::key_tool::Secret;
+use redoxfs::key_tool::{read_secret, recovery_key, require_seeded_random};
+use redoxfs::{DiskFile, FileSystem, Header, KeySlot, Salt};
+use std::{env, io};
+
+type Result<T, E = Box<dyn std::error::Error>> = std::result::Result<T, E>;
+
+enum Volume {
+    Disk(FileSystem<DiskFile>),
+    #[cfg(target_os = "redox")]
+    Mounted(libredox::Fd),
+}
+
+impl Volume {
+    fn open(path: &str, password: &[u8]) -> Result<Self> {
+        #[cfg(target_os = "redox")]
+        if path == "/" {
+            return Ok(Self::Mounted(libredox::Fd::open(
+                path,
+                libredox::flag::O_RDONLY | libredox::flag::O_DIRECTORY | libredox::flag::O_CLOEXEC,
+                0,
+            )?));
+        }
+        Ok(Self::Disk(FileSystem::open(
+            DiskFile::open(path)?,
+            Some(password),
+            None,
+            false,
+        )?))
+    }
+
+    fn header(&mut self) -> Result<Header> {
+        match self {
+            Self::Disk(fs) => Ok(fs.header),
+            #[cfg(target_os = "redox")]
+            Self::Mounted(fd) => {
+                use redoxfs::key_tool::{KEY_CALL, KEY_HEADER};
+                let mut header = Header::default();
+                let count = fd.call_rw(
+                    &mut header,
+                    syscall::CallFlags::empty(),
+                    &[KEY_CALL, KEY_HEADER, 0],
+                )?;
+                if count != header.len() || !header.valid() {
+                    return Err("invalid header reply".into());
+                }
+                Ok(header)
+            }
+        }
+    }
+
+    fn set(&mut self, index: usize, old: KeySlot, slot: KeySlot, password: &[u8]) -> Result<()> {
+        match self {
+            Self::Disk(fs) => {
+                fs.set_key_slot(index, slot)?;
+                fs.disk.file.sync_all()?;
+            }
+            #[cfg(target_os = "redox")]
+            Self::Mounted(fd) => {
+                use redoxfs::key_tool::{KEY_CALL, KEY_SET};
+                let mut payload = Secret(Vec::with_capacity(96 + password.len()));
+                payload.0.extend_from_slice(&old.to_bytes());
+                payload.0.extend_from_slice(&slot.to_bytes());
+                payload.0.extend_from_slice(password);
+                fd.call_rw(
+                    &mut payload.0,
+                    syscall::CallFlags::empty(),
+                    &[KEY_CALL, KEY_SET, index as u64],
+                )?;
+            }
+        }
+        #[cfg(not(target_os = "redox"))]
+        let _ = (old, password);
+        Ok(())
+    }
+}
+
+fn run() -> Result<()> {
+    let mut args = env::args().skip(1);
+    let operation = args.next().ok_or("usage: redoxfs-key list|add|change|remove [--key-file PATH|-] [--new-key-file PATH] [--slot N] [--recovery] VOLUME")?;
+    let mut key_file = None;
+    let mut new_key_file = None;
+    let mut index = None;
+    let mut recovery = false;
+    let mut path = None;
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--key-file" => key_file = Some(args.next().ok_or("missing key file")?),
+            "--new-key-file" => new_key_file = Some(args.next().ok_or("missing new key file")?),
+            "--slot" => index = Some(args.next().ok_or("missing slot")?.parse::<usize>()?),
+            "--recovery" => recovery = true,
+            _ if !arg.starts_with('-') && path.is_none() => path = Some(arg),
+            _ => return Err("unknown or duplicate argument".into()),
+        }
+    }
+    let path = path.ok_or("missing volume (use / for mounted root)")?;
+    if !matches!(operation.as_str(), "list" | "add" | "change" | "remove")
+        || (recovery && (operation != "add" || new_key_file.is_some()))
+        || (new_key_file.is_some() && !matches!(operation.as_str(), "add" | "change"))
+    {
+        return Err("invalid operation or options".into());
+    }
+    let password = read_secret(key_file.as_deref(), "Current passphrase")?;
+    let mut volume = Volume::open(&path, &password.0)?;
+    let header = volume.header()?;
+    let (unlocked, keys) = header.unlock(&password.0).ok_or("incorrect passphrase")?;
+    if operation == "list" {
+        for (index, slot) in header.key_slots.iter().enumerate() {
+            if !slot.is_empty() {
+                println!("slot {index}: in use");
+            }
+        }
+        return Ok(());
+    }
+    let index = match (operation.as_str(), index) {
+        ("add", None) => header
+            .key_slots
+            .iter()
+            .position(KeySlot::is_empty)
+            .ok_or("no empty slots")?,
+        ("change", None) => unlocked,
+        ("remove", None) => return Err("remove requires --slot".into()),
+        (_, Some(index)) if index < 64 => index,
+        _ => return Err("slot out of range".into()),
+    };
+    let old = header.key_slots[index];
+    if (operation == "add") != old.is_empty() {
+        return Err("slot is not available for this operation".into());
+    }
+    let new_secret;
+    let slot = if operation == "remove" {
+        if header
+            .key_slots
+            .iter()
+            .filter(|slot| !slot.is_empty())
+            .count()
+            < 2
+        {
+            return Err("cannot remove the last slot".into());
+        }
+        KeySlot::default()
+    } else {
+        require_seeded_random()?;
+        new_secret = if recovery {
+            recovery_key()?
+        } else {
+            let value = read_secret(new_key_file.as_deref(), "New passphrase")?;
+            if new_key_file.is_none() {
+                let confirmation = read_secret(None, "Confirm new passphrase")?;
+                if value.0 != confirmation.0 {
+                    return Err("passphrases differ".into());
+                }
+            }
+            value
+        };
+        let slot = KeySlot::new(&new_secret.0, Salt::new().map_err(io::Error::other)?, keys)
+            .map_err(|err| io::Error::other(err.to_string()))?;
+        let mut check = header;
+        check.key_slots = [KeySlot::default(); 64];
+        check.key_slots[index] = slot;
+        if check.unlock(&new_secret.0).is_none() {
+            return Err("new slot verification failed".into());
+        }
+        volume.set(index, old, slot, &password.0)?;
+        if recovery {
+            use std::io::Write;
+            let mut out = io::stdout().lock();
+            out.write_all(b"Recovery key (type all digits without spaces): ")?;
+            for (i, group) in new_secret.0.chunks_exact(6).enumerate() {
+                if i != 0 {
+                    out.write_all(b" ")?;
+                }
+                out.write_all(group)?;
+            }
+            out.write_all(b"\n")?;
+            out.flush()?;
+        }
+        println!("slot {index}: updated; header ring rolled");
+        return Ok(());
+    };
+    volume.set(index, old, slot, &password.0)?;
+    println!("slot {index}: removed; header ring rolled");
+    Ok(())
+}
+
+fn main() {
+    if let Err(error) = run() {
+        eprintln!("redoxfs-key: {error}");
+        std::process::exit(1);
+    }
+}
