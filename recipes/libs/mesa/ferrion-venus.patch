FerrionOS change to Mesa (MIT license, kept), made against Mesa 26.3.1 (fec8830e9c94b1d67f3d8469467d5529fb2978cd): Enable the Venus Vulkan driver on FerrionOS with a process-local thread identifier for vn_gettid and direct render-scheme discovery without udev or sysfs while preserving Venus's DRM version and 3D parameter checks.

diff --git a/src/virtio/vulkan/vn_common.c b/src/virtio/vulkan/vn_common.c
index 1288dad..d74587f 100644
--- a/src/virtio/vulkan/vn_common.c
+++ b/src/virtio/vulkan/vn_common.c
@@ -434,3 +434,21 @@ vn_tls_get(void)
 
    return tls;
 }
+
+#if DETECT_OS_REDOX
+pid_t
+vn_gettid_redox(void)
+{
+   static atomic_int next_tid = 1;
+   static _Thread_local pid_t tid = 0;
+
+   if (unlikely(!tid)) {
+      int id = atomic_fetch_add_explicit(&next_tid, 1, memory_order_relaxed);
+      if (id <= 0)
+         id = 1;
+      tid = (pid_t)id;
+   }
+
+   return tid;
+}
+#endif
