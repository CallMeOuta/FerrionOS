+static bool
+redox_probe_device_sw(_EGLDisplay *disp)
+{
+    struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+    struct _egl_device *device = _eglFindDevice(dri2_dpy->fd_render_gpu, true);
+
+    dri2_dpy->fd_render_gpu = -1;
+
+    if (_eglHasAttrib(disp, EGL_DEVICE_EXT) && disp->Device != device) {
+       return false;
+    }
+
+    disp->Device = device;
+    assert(disp->Device);
+
+    dri2_dpy->driver_name = strdup("swrast");
+    if (!dri2_dpy->driver_name)
+       return false;
+
+    dri2_detect_swrast_kopper(disp);
+    dri2_dpy->loader_funcs = &redox_swrast_loader_funcs;
+
+    return true;
+}
+
+static const struct {
+   int format;
+   int rgba_shifts[4];
+   unsigned int rgba_sizes[4];
+} redox_visuals[] = {
+   {
+      /* DRM_FORMAT_ARGB8888 (0x34325241) */
+      0x34325241,
+      /* Shifts for R, G, B, A */
+      { 16, 8, 0, 24 },
+      /* Sizes for R, G, B, A */
+      { 8, 8, 8, 8 }
+   },
+   {
+      /* DRM_FORMAT_XRGB8888 (0x34325258) */
+      0x34325258,
+      /* Shifts for R, G, B, A */
+      { 16, 8, 0, 24 },
+      /* Sizes for R, G, B, X */
+      { 8, 8, 8, 0 }
+   }
+};
+
+static EGLBoolean
+dri2_add_window_configs_for_visuals(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   unsigned int config_count = 0;
+
+   for (int i = 0; i < ARRAY_SIZE(redox_visuals); i++) {
+
+      for (int j = 0; dri2_dpy->driver_configs[j]; j++) {
+
+         const struct dri_config *dri_conf = dri2_dpy->driver_configs[j];
+
+         int shifts[4];
+         unsigned int sizes[4];
+         dri2_get_shifts_and_sizes(dri_conf, shifts, sizes);
+         if (memcmp(shifts, redox_visuals[i].rgba_shifts, sizeof(shifts)) ||
+             memcmp(sizes, redox_visuals[i].rgba_sizes, sizeof(sizes)))
+             continue;
+
+         const EGLint surface_type = EGL_WINDOW_BIT | EGL_PBUFFER_BIT;
+
+         const EGLint config_attrs[] = {
+            EGL_NATIVE_VISUAL_ID,   redox_visuals[i].format,
+            EGL_NATIVE_VISUAL_TYPE, redox_visuals[i].format,
+            EGL_NONE
+         };
+
+         if (dri2_add_config(disp, dri_conf, surface_type, config_attrs))
+            config_count++;
+
+      }
+   }
+
+   return (config_count != 0);
+}
+
+EGLBoolean
+dri2_initialize_redox(_EGLDisplay *disp)
+{
+    const char *err;
+    bool driver_loaded = false;
+    struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+
+    driver_loaded = redox_probe_device_sw(disp);
+
+    if (!driver_loaded) {
+       err = "DRI2: failed to load driver";
+       goto cleanup;
+    }
+
+    dri2_dpy->fd_display_gpu = dri2_dpy->fd_render_gpu;
+
+    if (!dri2_create_screen(disp)) {
+       err = "DRI2: failed to create screen";
+       goto cleanup;
+    }
+
+    dri2_setup_screen(disp);
+    dri2_add_pbuffer_configs_for_visuals(disp);
+
+    if (!dri2_add_window_configs_for_visuals(disp)) {
+        err = "DRI2: failed to add window configs";
+        goto cleanup;
+    }
+
+    disp->Extensions.KHR_image = EGL_TRUE;
+    disp->Extensions.EXT_buffer_age = EGL_TRUE;
+    disp->Extensions.KHR_partial_update = EGL_TRUE;
+    disp->Extensions.EXT_swap_buffers_with_damage = EGL_TRUE;
+    disp->Extensions.REDOX_image_native_buffer = EGL_TRUE;
+
+    dri2_dpy->vtbl = &dri2_redox_display_vtbl;
+
+    return EGL_TRUE;
+
+cleanup:
+    dri2_display_destroy(disp);
+    return _eglError(EGL_NOT_INITIALIZED, err);
+}
