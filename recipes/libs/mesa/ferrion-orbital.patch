+static void
+redox_swrast_put_image(struct dri_drawable *draw, int op, int x, int y, int w,
+                        int h, char *data, void *loaderPrivate)
+{
+    struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+    if (op != __DRI_SWRAST_IMAGE_OP_SWAP || !dri2_surf || !data) {
+        return;
+    }
+
+    if (x < 0 || y < 0) {
+        _eglError(EGL_BAD_PARAMETER, "Negative software image coordinates");
+        return;
+    }
+
+    char *dst_base = NULL;
+    int dst_width = 0, dst_height = 0;
+
+    if (dri2_surf->orb_window) {
+        dst_base = (char *)orb_window_data(dri2_surf->orb_window);
+        if (!dst_base) {
+            _eglLog(_EGL_WARNING, "redox_swrast_put_image: orb_window_data() returned NULL!");
+            return;
+        }
+        dst_width = orb_window_width(dri2_surf->orb_window);
+        dst_height = orb_window_height(dri2_surf->orb_window);
+    } else if (dri2_surf->orb_surface) {
+        dst_base = (char *)orb_surface_data(dri2_surf->orb_surface);
+        if (!dst_base) {
+            _eglLog(_EGL_WARNING, "redox_swrast_put_image: orb_window_data() returned NULL!");
+            return;
+        }
+        dst_width = orb_surface_width(dri2_surf->orb_surface);
+        dst_height = orb_surface_height(dri2_surf->orb_surface);
+    }
+
+    if (!dst_base || dst_width <= 0 || dst_height <= 0) {
+        return;
+    }
+
+    const int bpp = 4;
+    int src_stride_bytes = w * bpp;
+    int copy_width_bytes = w * bpp;
+    int dst_stride_bytes = dst_width * bpp;
+    int x_offset_bytes = x * bpp;
+
+    char *src_line = data;
+    char *dst_line = dst_base;
+    dst_line += x_offset_bytes;
+    dst_line += y * dst_stride_bytes;
+
+    if (copy_width_bytes > dst_stride_bytes - x_offset_bytes)
+        copy_width_bytes = dst_stride_bytes - x_offset_bytes;
+
+    if (h > dst_height - y)
+        h = dst_height - y;
+
+    if (copy_width_bytes <= 0 || h <= 0) {
+        return;
+    }
+
+    for (; h > 0; h--) {
+        memcpy(dst_line, src_line, copy_width_bytes);
+        src_line += src_stride_bytes;
+        dst_line += dst_stride_bytes;
+    }
+}
+
+static void
+redox_swrast_get_drawable_info(struct dri_drawable *draw, int *x, int *y, int *w, int *h,
+                               void *loaderPrivate)
+{
+    struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+    if (!dri2_surf->orb_window) {
+        *x = *y = *w = *h = 0;
+        return;
+    }
+
+    int cur_w = orb_window_width(dri2_surf->orb_window);
+    int cur_h = orb_window_height(dri2_surf->orb_window);
+
+    dri2_surf->base.Width = cur_w;
+    dri2_surf->base.Height = cur_h;
+
+    *x = orb_window_x(dri2_surf->orb_window);
+    *y = orb_window_y(dri2_surf->orb_window);
+    *w = cur_w;
+    *h = cur_h;
+}
+
+static EGLBoolean
+redox_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw,
+                               const EGLint *rects, EGLint n_rects)
+{
+    struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+    void *orb_window = dri2_surf->orb_window;
+
+    driSwapBuffers(dri2_surf->dri_drawable, n_rects, rects);
+
+    if (!orb_window) {
+        return EGL_TRUE;
+    }
+
+    if (n_rects <= 0 || !rects) {
+        orb_window_sync(orb_window);
+        return EGL_TRUE;
+    }
+
+    int surface_height = orb_window_height(orb_window);
+
+    EGLint *orb_rects = malloc(n_rects * 4 * sizeof(EGLint));
+    if (!orb_rects) {
+        orb_window_sync(orb_window);
+        return EGL_TRUE;
+    }
+
+    for (EGLint i = 0; i < n_rects; i++) {
+        EGLint x = rects[i * 4 + 0];
+        EGLint y = rects[i * 4 + 1];
+        EGLint w = rects[i * 4 + 2];
+        EGLint h = rects[i * 4 + 3];
+
+        // this coordinate is flipped
+        EGLint orb_y = surface_height - (y + h);
+
+        orb_rects[i * 4 + 0] = x;
+        orb_rects[i * 4 + 1] = orb_y;
+        orb_rects[i * 4 + 2] = w;
+        orb_rects[i * 4 + 3] = h;
+    }
+
+    orb_window_update_rects(orb_window, orb_rects, n_rects);
+    free(orb_rects);
+
+    return EGL_TRUE;
+}
+
+static EGLint
+redox_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surface)
+{
+    // liborbital buffers always on screen
+    return 1;
+}
