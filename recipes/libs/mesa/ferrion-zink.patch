+static void
+kopper_present_swrast(struct pipe_context *pipe,
+                      struct dri_drawable *drawable,
+                      struct pipe_resource *ptex)
+{
+   const __DRIswrastLoaderExtension *loader = drawable->screen->loader.swrast;
+   if (!loader || (!loader->putImage2 && !loader->putImage))
+      return;
+
+   struct pipe_transfer *transfer = NULL;
+   void *map = pipe_texture_map(pipe, ptex, 0, 0, PIPE_MAP_READ,
+                                0, 0, ptex->width0, ptex->height0,
+                                &transfer);
+   if (!map)
+      return;
+
+   if (loader->putImage2) {
+      loader->putImage2(drawable, __DRI_SWRAST_IMAGE_OP_SWAP,
+                        0, 0, ptex->width0, ptex->height0,
+                        transfer->stride, map, drawable->loaderPrivate);
+   } else if (transfer->stride == ptex->width0 * 4) {
+      loader->putImage(drawable, __DRI_SWRAST_IMAGE_OP_SWAP,
+                       0, 0, ptex->width0, ptex->height0,
+                       map, drawable->loaderPrivate);
+   }
+   pipe_texture_unmap(pipe, transfer);
+}
