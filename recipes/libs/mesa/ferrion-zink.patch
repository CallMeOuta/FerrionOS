+static bool
+redox_render_scheme_exists(void)
+{
+    DIR *dir = opendir("/scheme");
+    if (!dir)
+        return false;
+    struct dirent *entry;
+    bool found = false;
+    for (unsigned count = 0; count < REDOX_MAX_SCHEME_ENTRIES && (entry = readdir(dir)) != NULL; count++) {
+        if (strncmp(entry->d_name, "gpu.", 4) == 0) {
+            found = true;
+            break;
+        }
+    }
+    closedir(dir);
+    return found;
