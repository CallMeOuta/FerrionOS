+static unsigned
+redox_select_drivers(_EGLDisplay *disp, enum redox_driver out[REDOX_MAX_DRIVER_ATTEMPTS])
+{
+    const char *override = os_get_option("MESA_LOADER_DRIVER_OVERRIDE");
+    bool explicit_zink = override && strcmp(override, "zink") == 0;
+    if (explicit_zink) {
+        if (!disp->Options.Zink)
+            return 0;
+        out[0] = REDOX_DRV_ZINK;
+        return 1;
+    }
+    if (override && override[0] != '\0') {
+        out[0] = REDOX_DRV_SWRAST;
+        return 1;
+    }
+    if (disp->Options.Zink) {
+        out[0] = REDOX_DRV_ZINK;
+        return 1;
+    }
+    if (disp->Options.ForceSoftware) {
+        out[0] = REDOX_DRV_SWRAST;
+        return 1;
+    }
+    if (redox_render_scheme_exists()) {
+        out[0] = REDOX_DRV_ZINK;
+        out[1] = REDOX_DRV_SWRAST;
+        return 2;
+    }
+    out[0] = REDOX_DRV_SWRAST;
+    return 1;
+}
