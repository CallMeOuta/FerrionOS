+		if (!wait_state.infinite) {
+			int next_timeout = sync_wait_remaining_ms(&wait_state, poll_timeout);
+			assert(next_timeout >= 0 && next_timeout <= poll_timeout);
+			if (next_timeout <= 0) {
+				errno = ETIME;
+				return -1;
+			}
+			poll_timeout = next_timeout;
+		}
+	}
 }
 
