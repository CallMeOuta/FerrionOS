FerrionOS change to Mesa (MIT license, kept), made against Mesa 26.3.1: Replace sync_wait's signed remaining-timeout subtraction with an explicit { bool infinite; struct timespec deadline; } wait state so an interrupted finite wait derives remaining time from the monotonic deadline and returns ETIME when expired instead of passing a negative timeout to poll.

--- a/src/util/libsync.h
+++ b/src/util/libsync.h
@@ -31,6 +31,7 @@
 #include <assert.h>
 #include <errno.h>
 #include <poll.h>
+#include <limits.h>
 #include <stdbool.h>
 #include <stdint.h>
 #include <string.h>
@@ -118,19 +119,63 @@
 #endif
 
 
+struct sync_wait_deadline {
+	bool infinite;
+	struct timespec deadline;
+};
+
+static inline struct sync_wait_deadline sync_wait_deadline_init(int timeout)
+{
+	struct sync_wait_deadline state = { .infinite = timeout < 0, .deadline = { 0, 0 } };
+	if (state.infinite)
+		return state;
+
+	clock_gettime(CLOCK_MONOTONIC, &state.deadline);
+	state.deadline.tv_sec += timeout / 1000;
+	state.deadline.tv_nsec += (long)(timeout % 1000) * 1000000L;
+	if (state.deadline.tv_nsec >= 1000000000L) {
+		state.deadline.tv_sec += 1;
+		state.deadline.tv_nsec -= 1000000000L;
+	}
+	return state;
+}
+
+static inline int sync_wait_remaining_ms(const struct sync_wait_deadline *state, int prev_remaining)
+{
+	struct timespec now;
+	int64_t rem_ns;
+	int64_t rem_ms;
+
+	if (state->infinite)
+		return -1;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	rem_ns = (int64_t)(state->deadline.tv_sec - now.tv_sec) * 1000000000LL +
+		(int64_t)(state->deadline.tv_nsec - now.tv_nsec);
+	if (rem_ns <= 0)
+		return 0;
+
+	rem_ms = (rem_ns + 999999LL) / 1000000LL;
+	if (rem_ms > (int64_t)prev_remaining)
+		rem_ms = (int64_t)prev_remaining;
+	if (rem_ms > INT_MAX)
+		rem_ms = INT_MAX;
+	return (int)rem_ms;
+}
+
 static inline int sync_wait(int fd, int timeout)
 {
 	struct pollfd fds = {0};
 	int ret;
-	struct timespec poll_start, poll_end;
+	struct sync_wait_deadline wait_state = sync_wait_deadline_init(timeout);
+	int poll_timeout = wait_state.infinite ? -1 : timeout;
 
 	fds.fd = fd;
 	fds.events = POLLIN;
 
-	do {
-		clock_gettime(CLOCK_MONOTONIC, &poll_start);
-		ret = poll(&fds, 1, timeout);
-		clock_gettime(CLOCK_MONOTONIC, &poll_end);
+	for (;;) {
+		assert(wait_state.infinite || poll_timeout >= 0);
+		ret = poll(&fds, 1, poll_timeout);
 		if (ret > 0) {
 			if (fds.revents & (POLLERR | POLLNVAL)) {
 				errno = EINVAL;
@@ -141,11 +186,18 @@
 			errno = ETIME;
 			return -1;
 		}
-		timeout -= (poll_end.tv_sec - poll_start.tv_sec) * 1000 +
-			(poll_end.tv_nsec - poll_end.tv_nsec) / 1000000;
-	} while (ret == -1 && (errno == EINTR || errno == EAGAIN));
-
-	return ret;
+		if (ret != -1 || (errno != EINTR && errno != EAGAIN))
