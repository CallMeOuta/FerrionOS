+#ifdef __redox__
+#define MPV_WL_SHM_MAX_RETRIES 64
+#define MPV_WL_SHM_MAX_EINTR 16
+
+static bool fill_random_u64(uint64_t *out)
+{
+    uint8_t *dst = (uint8_t *)out;
+    size_t filled = 0;
+    for (int iter = 0; iter < MPV_WL_SHM_MAX_EINTR && filled < sizeof(*out); iter++) {
+        ssize_t n = getrandom(dst + filled, sizeof(*out) - filled, 0);
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            return false;
+        }
+        if (n == 0)
+            return false;
+        filled += (size_t)n;
+    }
+    return filled == sizeof(*out);
+}
+#endif
