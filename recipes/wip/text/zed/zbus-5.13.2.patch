FerrionOS change to zbus 5.13.2 (MIT, kept), applied by the zed recipe's source script to the crate archive from crates.io:
- rustix has no MSG_NOSIGNAL for this target, so messages are sent with no flags, as on macOS.

diff -r a/src/connection/socket/unix.rs b/src/connection/socket/unix.rs
--- a/src/connection/socket/unix.rs
+++ b/src/connection/socket/unix.rs
@@ -325,9 +325,9 @@
         ));
     }
 
-    #[cfg(not(target_os = "macos"))]
+    #[cfg(not(any(target_os = "macos", target_os = "redox")))]
     let flags = SendFlags::NOSIGNAL;
-    #[cfg(target_os = "macos")]
+    #[cfg(any(target_os = "macos", target_os = "redox"))]
     let flags = SendFlags::empty();
 
     let sent = sendmsg(fd, &iov, &mut ancillary, flags)?;
