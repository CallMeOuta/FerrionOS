+# FerrionOS: crates built from patched copies that the recipe's source script puts in
+# ferrion-vendor/: wasmtime and wasmtime-wasi 48.0.7 (trap handling and open flags for this
+# target) and zbus 5.13.2 (no MSG_NOSIGNAL). rustix and cap-primitives come from a third
+# party's forks that add this target, pinned by commit.
+wasmtime = { path = "ferrion-vendor/wasmtime-48.0.7" }
+wasmtime-wasi = { path = "ferrion-vendor/wasmtime-wasi-48.0.7" }
+zbus = { path = "ferrion-vendor/zbus-5.13.2" }
+rustix = { git = "https://github.com/auronandace/rustix", rev = "8f6edcb63120f173e13f8653bb41136713869d81" }
+cap-primitives = { git = "https://github.com/auronandace/cap-std", rev = "b028ed8000355368453f43bebd4cd261275bc9c4" }
 
