+fn build_head(
+    renderer: &mut GlesRenderer,
+    ipc_outputs: &Arc<Mutex<IpcOutputMap>>,
+    info: &OutputInfo,
+) -> anyhow::Result<HeadState> {
+    let mode = DisplayMode::from_output_info(info);
+    let expected_size: Size<i32, _> = (mode.width as i32, mode.height as i32).into();
+    let texture: GlesTexture = renderer.create_buffer(Fourcc::Argb8888, expected_size)?;
+    assert_eq!(texture.size(), expected_size);
+    let physical_mm = (
+        info.mm_width.min(i32::MAX as u32) as i32,
+        info.mm_height.min(i32::MAX as u32) as i32,
+    );
+    let output = Output::new(
+        info.name.clone(),
+        PhysicalProperties {
+            size: physical_mm.into(),
+            subpixel: Subpixel::Unknown,
+            make: "FerrionOS".into(),
+            model: "CPU display".into(),
+            serial_number: String::new(),
+        },
+    );
+    output.user_data().insert_if_missing(|| OutputName {
+        connector: info.name.clone(),
+        make: Some("FerrionOS".into()),
+        model: Some("CPU display".into()),
+        serial: None,
+    });
+    let output_mode = mode.output_mode();
+    output.change_current_state(
+        Some(output_mode),
+        Some(Transform::Normal),
+        None,
+        Some((info.x, info.y).into()),
+    );
+    output.set_preferred(output_mode);
+    let damage = OutputDamageTracker::from_output(&output);
+    let ipc_id = OutputId::next();
+    let ipc_width: u16 = mode.width.try_into()?;
+    let ipc_height: u16 = mode.height.try_into()?;
+    let ipc_refresh = output_mode.refresh as u32;
+    let physical_size = (info.mm_width > 0 && info.mm_height > 0)
+        .then_some((info.mm_width, info.mm_height));
+    let logical = logical_output(&output);
+    ipc_outputs.lock().unwrap().insert(
+        ipc_id,
+        niri_ipc::Output {
+            name: info.name.clone(),
+            make: "FerrionOS".into(),
+            model: "CPU display".into(),
+            serial: None,
+            physical_size,
+            modes: vec![niri_ipc::Mode {
+                width: ipc_width,
+                height: ipc_height,
+                refresh_rate: ipc_refresh,
+                is_preferred: true,
+            }],
+            current_mode: Some(0),
+            is_custom_mode: true,
+            vrr_supported: false,
+            vrr_enabled: false,
+            logical: Some(logical),
+            max_bpc: None,
+        },
+    );
+    Ok(HeadState {
+        id: info.id,
+        crtc: info.crtc,
+        ipc_id,
+        output,
+        mode,
+        texture,
+        damage,
+        buffer_valid: false,
+        cursor: CursorPlane::Unknown,
+        scheduler: FrameScheduler::new(mode.scheduler_period(), FRAME_MARGIN),
+        pacing: Pacing::Idle,
+        consecutive_flip_busy: 0,
+        frame: 0,
+    })
+}
