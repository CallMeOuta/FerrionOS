+    fn init_gbm_device_once(&mut self) {
+        assert!(self.gbm.is_none());
+        assert!(
+            std::env::var_os("WAYLAND_DISPLAY").is_none(),
+            "GBM device must be initialized before WAYLAND_DISPLAY is set"
+        );
+        if self.native.present_mode() != PresentMode::PageFlip {
+            return;
+        }
+        if pick_dmabuf_render_fourcc(&self.renderer).is_none() {
+            return;
+        }
+        let Some(render_path) = find_render_scheme_path() else {
+            return;
+        };
+        match GbmDevice::open(&render_path) {
+            Ok(gbm) => {
+                self.gbm = Some(gbm);
+            }
+            Err(err) => {
+                warn!("GBM device open failed on {}: {err}", render_path);
+            }
+        }
+    }
+
+    fn teardown_all_swapchains(&mut self) {
+        self.native.destroy_all_dmabuf_fbs();
+        for head in &mut self.heads {
+            head.swapchain = None;
+        }
+    }
+
+    fn try_enable_swapchains(&mut self) {
+        self.teardown_all_swapchains();
+        let mode = self.native.present_mode();
+        if mode != PresentMode::PageFlip {
+            info!(
+                "FERRION_PRESENTER mode={} swapchain=cpu reason=dirtyfb_mode",
+                present_mode_name(mode)
+            );
+            return;
+        }
+        let Some(fourcc) = pick_dmabuf_render_fourcc(&self.renderer) else {
+            info!("FERRION_PRESENTER mode=flip swapchain=cpu reason=no_egl_dmabuf_render_format");
+            return;
+        };
+        let Some(gbm) = self.gbm.as_ref() else {
+            let reason = if find_render_scheme_path().is_none() {
+                "no_render_scheme"
+            } else {
+                "gbm_create_device_failed"
+            };
+            info!(
+                "FERRION_PRESENTER mode=flip swapchain=cpu reason={}",
+                reason
+            );
+            return;
+        };
+        self.swapchain_generation = self.swapchain_generation.wrapping_add(1);
+        let generation = self.swapchain_generation;
+        for head in &mut self.heads {
+            match build_head_swapchain(
+                gbm,
+                &mut self.renderer,
+                &mut self.native,
+                head.id,
+                head.mode.width,
+                head.mode.height,
+                fourcc,
+                generation,
+            ) {
+                Ok(swapchain) => {
+                    head.swapchain = Some(swapchain);
+                    head.damage = OutputDamageTracker::from_output(&head.output);
+                    head.buffer_valid = false;
+                }
+                Err(SwapchainSetupErr::ChangePending) => {
+                    self.native.destroy_all_dmabuf_fbs();
+                    for other in &mut self.heads {
+                        other.swapchain = None;
+                    }
+                    self.change_pending = true;
+                    return;
+                }
+                Err(SwapchainSetupErr::Failed(step, detail)) => {
+                    warn!(
+                        "GBM swapchain setup failed on {} at {}: {}",
+                        head.output.name(),
+                        step,
+                        detail
+                    );
+                    self.native.destroy_all_dmabuf_fbs();
+                    for other in &mut self.heads {
+                        other.swapchain = None;
+                    }
+                    info!("FERRION_PRESENTER mode=flip swapchain=cpu reason={}", step);
+                    return;
+                }
+            }
+        }
+        info!(
+            "FERRION_PRESENTER mode=flip swapchain=gbm slots={} fourcc={:?}",
+            SWAPCHAIN_SLOTS, fourcc
+        );
+    }
