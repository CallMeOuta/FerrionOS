+#[link(name = "gbm")]
+extern "C" {
+    fn gbm_create_device(fd: libc::c_int) -> *mut GbmDeviceRaw;
+    fn gbm_device_destroy(gbm: *mut GbmDeviceRaw);
+    fn gbm_bo_create_with_modifiers2(
+        gbm: *mut GbmDeviceRaw,
+        width: u32,
+        height: u32,
+        format: u32,
+        modifiers: *const u64,
+        count: libc::c_uint,
+        flags: u32,
+    ) -> *mut GbmBoRaw;
+    fn gbm_bo_destroy(bo: *mut GbmBoRaw);
+    fn gbm_bo_get_fd(bo: *mut GbmBoRaw) -> libc::c_int;
+    fn gbm_bo_get_stride(bo: *mut GbmBoRaw) -> u32;
+    fn gbm_bo_get_offset(bo: *mut GbmBoRaw, plane: libc::c_int) -> u32;
+    fn gbm_bo_get_modifier(bo: *mut GbmBoRaw) -> u64;
+}
+
+struct GbmDevice {
+    raw: NonNull<GbmDeviceRaw>,
+    _render_fd: File,
+}
+
+impl GbmDevice {
+    fn open(path: &str) -> io::Result<Self> {
+        assert!(
+            std::env::var_os("WAYLAND_DISPLAY").is_none(),
+            "GBM device must be created once before WAYLAND_DISPLAY is set"
+        );
+        let render_fd = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .custom_flags(libc::O_CLOEXEC)
+            .open(path)?;
+        let raw = unsafe { gbm_create_device(render_fd.as_raw_fd()) };
+        let Some(raw) = NonNull::new(raw) else {
+            return Err(io::Error::last_os_error());
+        };
+        Ok(Self {
+            raw,
+            _render_fd: render_fd,
+        })
+    }
+
+    fn create_linear_scanout_bo(
+        &self,
+        width: u32,
+        height: u32,
+        fourcc: u32,
+    ) -> io::Result<(GbmBo, OwnedFd, u32, u32, u64)> {
+        let linear_mod = DRM_FORMAT_MOD_LINEAR;
+        let raw = unsafe {
+            gbm_bo_create_with_modifiers2(
+                self.raw.as_ptr(),
+                width,
+                height,
+                fourcc,
+                &linear_mod,
+                1,
+                GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING,
+            )
+        };
+        let Some(raw) = NonNull::new(raw) else {
+            return Err(io::Error::last_os_error());
+        };
+        let bo = GbmBo { raw };
+        let stride = unsafe { gbm_bo_get_stride(bo.raw.as_ptr()) };
+        let offset = unsafe { gbm_bo_get_offset(bo.raw.as_ptr(), 0) };
+        let modifier = unsafe { gbm_bo_get_modifier(bo.raw.as_ptr()) };
+        let min_stride = width.checked_mul(4).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::InvalidInput, "GBM width overflows stride")
+        })?;
+        if modifier != DRM_FORMAT_MOD_LINEAR || stride < min_stride {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "GBM BO layout is not LINEAR with expected stride",
+            ));
+        }
+        let fd = unsafe { gbm_bo_get_fd(bo.raw.as_ptr()) };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let owned_fd = unsafe { OwnedFd::from_raw_fd(fd as RawFd) };
+        Ok((bo, owned_fd, stride, offset, modifier))
+    }
+}
+
+impl Drop for GbmDevice {
