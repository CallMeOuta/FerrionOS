+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum SlotState {
+    Free,
+    InFlight,
+    OnScreen,
+}
+
+struct GbmSwapSlot {
+    dmabuf: Dmabuf,
+    _bo: GbmBo,
+    fb: DmabufFb,
+    state: SlotState,
+    age: usize,
+}
+
+struct GbmSwapchain {
+    generation: u64,
+    slots: Vec<GbmSwapSlot>,
+}
+
+impl GbmSwapchain {
+    fn assert_invariants(&self) {
+        assert!(self.slots.len() >= 2 && self.slots.len() <= MAX_DMABUF_FBS_PER_HEAD);
+        let in_flight = self
+            .slots
+            .iter()
+            .filter(|slot| slot.state == SlotState::InFlight)
+            .count();
+        let on_screen = self
+            .slots
+            .iter()
+            .filter(|slot| slot.state == SlotState::OnScreen)
+            .count();
+        assert!(in_flight <= MAX_IN_FLIGHT_FLIPS);
+        assert!(on_screen <= 1);
+    }
+
+    fn pick_free_slot(&self) -> usize {
+        self.assert_invariants();
+        let idx = self
+            .slots
+            .iter()
+            .position(|slot| slot.state == SlotState::Free)
+            .expect("swapchain has a free slot when no flip is in flight");
+        assert_eq!(self.slots[idx].state, SlotState::Free);
+        idx
+    }
+
+    fn mark_presented(&mut self, idx: usize) {
+        assert!(idx < self.slots.len());
+        assert_eq!(self.slots[idx].state, SlotState::Free);
+        self.slots[idx].state = SlotState::InFlight;
+        self.slots[idx].age = 1;
+        for (i, slot) in self.slots.iter_mut().enumerate() {
+            if i != idx && slot.age > 0 {
+                slot.age = slot.age.saturating_add(1);
+            }
+        }
+        self.assert_invariants();
+    }
+
+    fn on_flip_complete(&mut self, presented_idx: usize) {
+        assert!(presented_idx < self.slots.len());
+        assert_eq!(self.slots[presented_idx].state, SlotState::InFlight);
+        for (i, slot) in self.slots.iter_mut().enumerate() {
+            if i != presented_idx && slot.state == SlotState::OnScreen {
+                slot.state = SlotState::Free;
+            }
+        }
+        self.slots[presented_idx].state = SlotState::OnScreen;
+        self.assert_invariants();
+    }
+}
+
+fn find_render_scheme_path() -> Option<String> {
+    let entries = fs::read_dir("/scheme").ok()?;
+    let mut best: Option<String> = None;
+    for entry in entries.take(MAX_SCHEME_ENTRIES) {
+        let Ok(entry) = entry else {
+            continue;
+        };
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else {
+            continue;
+        };
+        if name.starts_with("gpu.") && best.as_deref().is_none_or(|cur| name < cur) {
+            best = Some(name.to_owned());
+        }
+    }
+    best.map(|name| format!("/scheme/{name}"))
+}
+
+fn pick_dmabuf_render_fourcc(renderer: &GlesRenderer) -> Option<Fourcc> {
+    let formats = renderer.egl_context().display().dmabuf_render_formats();
+    for fourcc in [Fourcc::Xrgb8888, Fourcc::Argb8888] {
+        if formats.contains(&Format {
+            code: fourcc,
+            modifier: Modifier::Linear,
+        }) {
+            return Some(fourcc);
+        }
+    }
+    None
+}
+
+enum SwapchainSetupErr {
+    ChangePending,
+    Failed(&'static str, String),
+}
+
+fn build_head_swapchain(
+    gbm: &GbmDevice,
+    renderer: &mut GlesRenderer,
+    native: &mut native::Backend,
+    head_id: u32,
+    width: u32,
+    height: u32,
+    fourcc: Fourcc,
+    generation: u64,
+) -> Result<GbmSwapchain, SwapchainSetupErr> {
+    let mut slots: Vec<GbmSwapSlot> = Vec::with_capacity(SWAPCHAIN_SLOTS);
+    for _ in 0..SWAPCHAIN_SLOTS {
+        let (bo, dmabuf_fd, stride, offset, modifier) =
+            match gbm.create_linear_scanout_bo(width, height, fourcc as u32) {
+                Ok(values) => values,
+                Err(err) => {
+                    for slot in &slots {
+                        let _ = native.destroy_dmabuf_fb_for(head_id, slot.fb);
+                    }
+                    return Err(SwapchainSetupErr::Failed(
+                        "gbm_bo_create_failed",
+                        err.to_string(),
+                    ));
+                }
+            };
+        let fb = match native.import_dmabuf_fb_for(
+            head_id,
+            dmabuf_fd.as_fd(),
+            DmabufFbDesc {
+                width,
+                height,
+                fourcc: fourcc as u32,
+                stride,
+                offset,
+                modifier,
+            },
+        ) {
+            Ok(fb) => fb,
+            Err(err) => {
+                for slot in &slots {
+                    let _ = native.destroy_dmabuf_fb_for(head_id, slot.fb);
+                }
+                if is_change_pending(&err) {
+                    return Err(SwapchainSetupErr::ChangePending);
+                }
+                return Err(SwapchainSetupErr::Failed(
+                    "drm_addfb2_failed",
+                    err.to_string(),
+                ));
+            }
+        };
+        let mut builder = Dmabuf::builder(
+            (width as i32, height as i32),
+            fourcc,
+            Modifier::Linear,
+            DmabufFlags::empty(),
+        );
+        if !builder.add_plane(dmabuf_fd, offset, stride) {
+            let _ = native.destroy_dmabuf_fb_for(head_id, fb);
+            for slot in &slots {
+                let _ = native.destroy_dmabuf_fb_for(head_id, slot.fb);
+            }
+            return Err(SwapchainSetupErr::Failed(
+                "dmabuf_plane_failed",
+                String::from("add_plane rejected"),
+            ));
+        }
+        let Some(mut dmabuf) = builder.build() else {
+            let _ = native.destroy_dmabuf_fb_for(head_id, fb);
+            for slot in &slots {
+                let _ = native.destroy_dmabuf_fb_for(head_id, slot.fb);
+            }
+            return Err(SwapchainSetupErr::Failed(
+                "dmabuf_build_failed",
+                String::from("Dmabuf::build returned None"),
+            ));
+        };
+        if let Err(err) = renderer.bind(&mut dmabuf) {
+            let _ = native.destroy_dmabuf_fb_for(head_id, fb);
+            for slot in &slots {
+                let _ = native.destroy_dmabuf_fb_for(head_id, slot.fb);
+            }
+            return Err(SwapchainSetupErr::Failed(
+                "egl_dmabuf_bind_failed",
+                err.to_string(),
+            ));
+        }
+        slots.push(GbmSwapSlot {
+            dmabuf,
+            _bo: bo,
+            fb,
+            state: SlotState::Free,
+            age: 0,
+        });
+    }
+    let swapchain = GbmSwapchain { generation, slots };
+    swapchain.assert_invariants();
+    Ok(swapchain)
+}
