diff --git a/src/backend/ferrion.rs b/src/backend/ferrion.rs
new file mode 100644
index 00000000..0a7f71ca
--- /dev/null
+++ b/src/backend/ferrion.rs
@@ -0,0 +1,767 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Added for FerrionOS on 2026-11-21 to niri's backend interface.
+// Input adapter follows FerrionOS's MIT ferrion-wm-backend; its notices are
+// retained in ferrion-vendor/backend/LICENSE.
+use std::collections::{HashMap, VecDeque};
+use std::io;
+use std::mem;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use anyhow::Context as _;
+use calloop::ping::make_ping;
+use calloop::timer::{TimeoutAction, Timer};
+use calloop::{LoopHandle, RegistrationToken};
+use ferrion_wm_backend::{self as native, BackendEvent, FrameScheduler, Input};
+use niri_config::OutputName;
+use smithay::backend::allocator::dmabuf::Dmabuf;
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::egl::native::EGLSurfacelessDisplay;
+use smithay::backend::egl::{EGLContext, EGLDisplay};
+use smithay::backend::input::{self as sm, InputBackend, InputTime, UnusedEvent};
+use smithay::backend::renderer::damage::OutputDamageTracker;
+use smithay::backend::renderer::gles::{GlesRenderer, GlesTexture};
+use smithay::backend::renderer::{Bind, ExportMem, Offscreen, Texture};
+use smithay::output::{Mode, Output, PhysicalProperties, Subpixel};
+use smithay::reexports::wayland_protocols::wp::presentation_time::server::wp_presentation_feedback;
+use smithay::utils::{Rectangle, Scale, Size, Transform};
+use smithay::wayland::presentation::Refresh;
+
+use super::{IpcOutputMap, OutputId, RenderResult};
+use crate::frame_clock::FrameClock;
+use crate::input::backend_ext::NiriInputDevice;
+use crate::niri::{Niri, RedrawState, State};
+use crate::render_helpers::{
+    render_to_encompassing_texture, resources, shaders, RenderCtx, RenderTarget,
+};
+use crate::utils::{get_monotonic_time, logical_output};
+
+const MAX_EVENTS_PER_DISPATCH: usize = 256;
+const MAX_PENDING_INPUTS: usize = 512;
+const DEFAULT_FRAME_PERIOD: Duration = Duration::from_nanos(16_666_667);
+const FRAME_MARGIN: Duration = Duration::from_micros(500);
+const DISPLAY_CHANGE_PENDING_ERR: &str = "display change pending";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct DisplayMode {
+    width: u32,
+    height: u32,
+    refresh_interval: Option<Duration>,
+}
+
+impl DisplayMode {
+    fn from_native(native: &native::Backend) -> Self {
+        let (width, height) = native.dimensions();
+        Self {
+            width,
+            height,
+            refresh_interval: native.refresh_period(),
+        }
+    }
+
+    fn scheduler_period(self) -> Duration {
+        self.refresh_interval.unwrap_or(DEFAULT_FRAME_PERIOD)
+    }
+
+    fn output_mode(self) -> Mode {
+        let period_us = self.scheduler_period().as_micros().max(1);
+        Mode {
+            size: (self.width as i32, self.height as i32).into(),
+            refresh: (1_000_000_000_u128 / period_us) as i32,
+        }
+    }
+}
+
+#[derive(PartialEq, Eq)]
+enum CursorPlane {
+    Unknown,
+    Hidden,
+    Shown(Vec<u8>, (u32, u32), (i32, i32)),
+}
+
+struct ActiveDisplay {
+    texture: GlesTexture,
+    damage: OutputDamageTracker,
+    buffer_valid: bool,
+    cursor: CursorPlane,
+}
+
+enum Display {
+    Active(ActiveDisplay),
+    ChangePending,
+}
+
+enum DisplayEvent {
+    Changed,
+    Reconfigured(ActiveDisplay),
+}
+
+enum Pacing {
+    Idle,
+    Armed(RegistrationToken),
+    Due,
+}
+
+enum RedrawGate {
+    Render,
+    Wait,
+}
+
+fn is_change_pending(err: &io::Error) -> bool {
+    matches!(err.kind(), io::ErrorKind::WouldBlock | io::ErrorKind::Other)
+        && err.to_string() == DISPLAY_CHANGE_PENDING_ERR
+}
+
+fn anyhow_is_change_pending(err: &anyhow::Error) -> bool {
+    err.chain()
+        .find_map(|cause| cause.downcast_ref::<io::Error>())
+        .is_some_and(is_change_pending)
+}
+
+pub struct Ferrion {
+    native: native::Backend,
+    renderer: GlesRenderer,
+    display: Display,
+    mode: DisplayMode,
+    output: Output,
+    scheduler: FrameScheduler,
+    pacing: Pacing,
+    ipc_outputs: Arc<Mutex<IpcOutputMap>>,
+    input_epoch: u64,
+    pending_inputs: VecDeque<u64>,
+    frame: u64,
+}
+
+impl Ferrion {
+    pub fn new(event_loop: LoopHandle<'static, State>) -> anyhow::Result<Self> {
+        let (ping, source) = make_ping()?;
+        let wakeup = ping.clone();
+        let native = native::Backend::open_with_wakeup(move || wakeup.ping())?;
+        let input_epoch = get_monotonic_time().as_micros() as u64 - native.now_us();
+        let initial_mode = DisplayMode::from_native(&native);
+        let renderer = unsafe {
+            let display =
+                EGLDisplay::new(EGLSurfacelessDisplay).context("surfaceless EGL display")?;
+            let context = EGLContext::new(&display).context("surfaceless EGL context")?;
+            GlesRenderer::new(context).context("GLES renderer")?
+        };
+        let output = Output::new(
+            "ferrion-1".into(),
+            PhysicalProperties {
+                size: (0, 0).into(),
+                subpixel: Subpixel::Unknown,
+                make: "FerrionOS".into(),
+                model: "CPU display".into(),
+                serial_number: String::new(),
+            },
+        );
+        output.user_data().insert_if_missing(|| OutputName {
+            connector: output.name(),
+            make: Some("FerrionOS".into()),
+            model: Some("CPU display".into()),
+            serial: None,
+        });
+        let ipc_outputs = Arc::new(Mutex::new(HashMap::from([(
+            OutputId::next(),
+            niri_ipc::Output {
+                name: output.name(),
+                make: "FerrionOS".into(),
+                model: "CPU display".into(),
+                serial: None,
+                physical_size: None,
+                modes: vec![niri_ipc::Mode {
+                    width: initial_mode.width.try_into()?,
+                    height: initial_mode.height.try_into()?,
+                    refresh_rate: initial_mode.output_mode().refresh as u32,
+                    is_preferred: true,
+                }],
+                current_mode: Some(0),
+                is_custom_mode: true,
+                vrr_supported: false,
+                vrr_enabled: false,
+                logical: None,
+                max_bpc: None,
+            },
+        )])));
+        let mut backend = Self {
+            native,
+            renderer,
+            display: Display::ChangePending,
+            mode: initial_mode,
+            output,
+            scheduler: FrameScheduler::new(initial_mode.scheduler_period(), FRAME_MARGIN),
+            pacing: Pacing::Idle,
+            ipc_outputs,
+            input_epoch,
+            pending_inputs: VecDeque::new(),
+            frame: 0,
+        };
+        let active = backend.apply_mode(None, initial_mode)?;
+        backend.transition_display(DisplayEvent::Reconfigured(active));
+
+        let reping = ping;
+        event_loop.insert_source(source, move |_, _, state| {
+            let mut drained = false;
+            for _ in 0..MAX_EVENTS_PER_DISPATCH {
+                let event = state.backend.ferrion().native.try_event();
+                match event {
+                    Ok(Some(BackendEvent::Input(input))) => {
+                        let backend = state.backend.ferrion();
+                        let time_us = match input {
+                            Input::Key(e) => e.time_us,
+                            Input::Motion(e) => e.time_us,
+                            Input::Button(e) => e.time_us,
+                            Input::Axis(e) => e.time_us,
+                        };
+                        if backend.pending_inputs.len() == MAX_PENDING_INPUTS {
+                            backend.pending_inputs.pop_front();
+                            warn!("input timing sample dropped: output stalled");
+                        }
+                        backend.pending_inputs.push_back(time_us);
+                        if let Input::Key(event) = &input {
+                            if event.pressed {
+                                info!(
+                                    "FERRION_KEY code={} read_ns={}",
+                                    event.code,
+                                    (backend.input_epoch + time_us) * 1000
+                                );
+                            }
+                        }
+                        let time = InputTime::from_micros(backend.input_epoch + time_us);
+                        state.process_input_event(into_smithay(input, time));
+                    }
+                    Ok(Some(BackendEvent::CursorTiming(t))) => {
+                        info!(
+                            "FERRION_CURSOR read_us={} completed_us={} x={} y={}",
+                            t.read_us, t.completed_us, t.x, t.y
+                        );
+                    }
+                    Ok(Some(BackendEvent::DisplayChanged)) => {
+                        let ferrion = state.backend.ferrion();
+                        ferrion.transition_display(DisplayEvent::Changed);
+                        if let Err(err) = ferrion.reconfigure(&mut state.niri) {
+                            error!("display handoff failed: {err:#}");
+                            state.niri.stop_signal.stop();
+                            drained = true;
+                            break;
+                        }
+                    }
+                    Ok(None) => {
+                        drained = true;
+                        break;
+                    }
+                    Err(err) => {
+                        error!("input reader failed: {err}");
+                        state.niri.stop_signal.stop();
+                        drained = true;
+                        break;
+                    }
+                }
+            }
+            if !drained {
+                reping.ping();
+            }
+        })?;
+        info!(
+            "FERRION_READY width={} height={} vt={}",
+            initial_mode.width,
+            initial_mode.height,
+            backend.native.vt()
+        );
+        Ok(backend)
+    }
+
+    pub fn init(&mut self, niri: &mut Niri) {
+        resources::init(&mut self.renderer);
+        shaders::init(&mut self.renderer);
+        niri.add_output(self.output.clone(), self.mode.refresh_interval, false);
+        assert_eq!(
+            niri.output_state
+                .get(&self.output)
+                .unwrap()
+                .frame_clock
+                .refresh_interval(),
+            self.mode.refresh_interval
+        );
+        niri.update_shaders();
+    }
+
+    pub fn seat_name(&self) -> String {
+        "inputd".into()
+    }
+    pub fn with_primary_renderer<T>(
+        &mut self,
+        f: impl FnOnce(&mut GlesRenderer) -> T,
+    ) -> Option<T> {
+        Some(f(&mut self.renderer))
+    }
+    pub fn ipc_outputs(&self) -> Arc<Mutex<IpcOutputMap>> {
+        self.ipc_outputs.clone()
+    }
+    pub fn import_dmabuf(&mut self, _: &Dmabuf) -> bool {
+        false
+    }
+
+    fn transition_display(&mut self, event: DisplayEvent) {
+        match event {
+            DisplayEvent::Changed => {
+                self.display = Display::ChangePending;
+            }
+            DisplayEvent::Reconfigured(active) => {
+                assert!(matches!(self.display, Display::ChangePending));
+                self.display = Display::Active(active);
+            }
+        }
+    }
+
+    fn apply_mode(
+        &mut self,
+        niri: Option<&mut Niri>,
+        mode: DisplayMode,
+    ) -> anyhow::Result<ActiveDisplay> {
+        assert_eq!(self.native.dimensions(), (mode.width, mode.height));
+        let expected_size: Size<i32, _> = (mode.width as i32, mode.height as i32).into();
+        let texture: GlesTexture = self.renderer.create_buffer(Fourcc::Argb8888, expected_size)?;
+        assert_eq!(texture.size(), expected_size);
+        let output_mode = mode.output_mode();
+        self.output
+            .change_current_state(Some(output_mode), Some(Transform::Normal), None, None);
+        self.output.set_preferred(output_mode);
+        let damage = OutputDamageTracker::from_output(&self.output);
+        let ipc_width: u16 = mode.width.try_into()?;
+        let ipc_height: u16 = mode.height.try_into()?;
+        let ipc_refresh = output_mode.refresh as u32;
+        let logical = logical_output(&self.output);
+        {
+            let mut ipc_outputs = self.ipc_outputs.lock().unwrap();
+            let entry = ipc_outputs.values_mut().next().unwrap();
+            entry.modes[0] = niri_ipc::Mode {
+                width: ipc_width,
+                height: ipc_height,
+                refresh_rate: ipc_refresh,
+                is_preferred: true,
+            };
+            entry.current_mode = Some(0);
+            entry.logical = Some(logical);
+            assert_eq!(entry.modes[0].width, ipc_width);
+            assert_eq!(entry.modes[0].height, ipc_height);
+            assert_eq!(entry.modes[0].refresh_rate, ipc_refresh);
+        }
+        self.scheduler = FrameScheduler::new(mode.scheduler_period(), FRAME_MARGIN);
+        self.mode = mode;
+        assert_eq!(self.output.current_mode(), Some(output_mode));
+        assert_eq!(self.mode, mode);
+        if let Some(niri) = niri {
+            niri.ipc_outputs_changed = true;
+            if let Some(output_state) = niri.output_state.get_mut(&self.output) {
+                let vrr = output_state.frame_clock.vrr();
+                output_state.frame_clock = FrameClock::new(mode.refresh_interval, vrr);
+                assert_eq!(
+                    output_state.frame_clock.refresh_interval(),
+                    mode.refresh_interval
+                );
+            }
+            niri.output_resized(&self.output);
+        }
+        Ok(ActiveDisplay {
+            texture,
+            damage,
+            buffer_valid: false,
+            cursor: CursorPlane::Unknown,
+        })
+    }
+
+    fn on_redraw_request(&mut self, niri: &Niri) -> RedrawGate {
+        match self.pacing {
+            Pacing::Due => {
+                self.pacing = Pacing::Idle;
+                RedrawGate::Render
+            }
+            Pacing::Armed(_) => RedrawGate::Wait,
+            Pacing::Idle => {
+                let now = self.native.now_us();
+                let start = self.scheduler.next_start(now);
+                let token = niri
+                    .event_loop
+                    .insert_source(
+                        Timer::from_duration(Duration::from_micros(start - now)),
+                        |_, _, state| {
+                            let backend = state.backend.ferrion();
+                            assert!(matches!(backend.pacing, Pacing::Armed(_)));
+                            backend.pacing = Pacing::Due;
+                            TimeoutAction::Drop
+                        },
+                    )
+                    .expect("register frame deadline");
+                self.pacing = Pacing::Armed(token);
+                RedrawGate::Wait
+            }
+        }
+    }
+
+    pub fn defer_redraw(&mut self, niri: &Niri) -> bool {
+        matches!(self.on_redraw_request(niri), RedrawGate::Wait)
+    }
+
+    fn reconfigure(&mut self, niri: &mut Niri) -> anyhow::Result<()> {
+        assert!(matches!(self.display, Display::ChangePending));
+        if let Pacing::Armed(token) = mem::replace(&mut self.pacing, Pacing::Idle) {
+            niri.event_loop.remove(token);
+        }
+        self.native.reconfigure()?;
+        let mode = DisplayMode::from_native(&self.native);
+        let active = self.apply_mode(Some(niri), mode)?;
+        let (width, height) = self.native.dimensions();
+        assert_eq!(active.texture.size(), (width as i32, height as i32).into());
+        self.transition_display(DisplayEvent::Reconfigured(active));
+        Ok(())
+    }
+
+    fn update_cursor(&mut self, niri: &Niri) -> anyhow::Result<bool> {
+        let mut elements = Vec::new();
+        if niri.pointer_visibility.is_visible() {
+            niri.render_pointer(&mut self.renderer, &self.output, &mut |e| elements.push(e));
+        }
+        if elements.is_empty() {
+            let needs_hide = match &self.display {
+                Display::Active(active) => !matches!(active.cursor, CursorPlane::Hidden),
+                Display::ChangePending => unreachable!("update_cursor requires Active"),
+            };
+            if needs_hide {
+                self.native.set_cursor(None, (0, 0), (0, 0))?;
+                if let Display::Active(active) = &mut self.display {
+                    active.cursor = CursorPlane::Hidden;
+                }
+            }
+            return Ok(false);
+        }
+        let scale = Scale::from(self.output.current_scale().fractional_scale());
+        let (mut texture, sync, geo) = render_to_encompassing_texture(
+            &mut self.renderer,
+            scale,
+            Transform::Normal,
+            Fourcc::Argb8888,
+            &elements,
+        )?;
+        let position = niri
+            .seat
+            .get_pointer()
+            .unwrap()
+            .current_location()
+            .to_physical_precise_round(scale);
+        let hotspot = position - geo.loc;
+        let size = (geo.size.w as u32, geo.size.h as u32);
+        let capacity = self.native.cursor_size()?;
+        if size.0 > capacity.0
+            || size.1 > capacity.1
+            || hotspot.x < 0
+            || hotspot.y < 0
+            || hotspot.x >= geo.size.w
+            || hotspot.y >= geo.size.h
+        {
+            let needs_hide = match &self.display {
+                Display::Active(active) => !matches!(active.cursor, CursorPlane::Hidden),
+                Display::ChangePending => unreachable!("update_cursor requires Active"),
+            };
+            if needs_hide {
+                self.native.set_cursor(None, (0, 0), (0, 0))?;
+                if let Display::Active(active) = &mut self.display {
+                    active.cursor = CursorPlane::Hidden;
+                }
+            }
+            return Ok(true);
+        }
+        sync.wait()?;
+        let texture_size = texture.size();
+        let target = self.renderer.bind(&mut texture)?;
+        let mapping = self.renderer.copy_framebuffer(
+            &target,
+            Rectangle::from_size(texture_size),
+            Fourcc::Argb8888,
+        )?;
+        let pixels = self.renderer.map_texture(&mapping)?.to_vec();
+        let next = CursorPlane::Shown(pixels, size, (hotspot.x, hotspot.y));
+        let changed = match &self.display {
+            Display::Active(active) => active.cursor != next,
+            Display::ChangePending => unreachable!("update_cursor requires Active"),
+        };
+        if changed {
+            if let CursorPlane::Shown(ref bytes, sz, hs) = next {
+                self.native.set_cursor(Some(bytes), sz, hs)?;
+            }
+            if let Display::Active(active) = &mut self.display {
+                active.cursor = next;
+            }
+        }
+        Ok(false)
+    }
+
+    pub fn render(&mut self, niri: &mut Niri, output: &Output) -> RenderResult {
+        assert!(!matches!(self.pacing, Pacing::Armed(_)));
+        {
+            let output_state = niri.output_state.get(output).unwrap();
+            assert!(matches!(
+                output_state.redraw_state,
+                RedrawState::Queued | RedrawState::WaitingForEstimatedVBlankAndQueued(_)
+            ));
+        }
+        if matches!(self.display, Display::ChangePending) {
+            let output_state = niri.output_state.get_mut(output).unwrap();
+            output_state.redraw_state = RedrawState::Queued;
+            return RenderResult::Skipped;
+        }
+        let started = Instant::now();
+        let result = self.render_frame(niri, output);
+        match result {
+            Ok(result) => {
+                self.scheduler.record_render(started.elapsed());
+                let output_state = niri.output_state.get_mut(output).unwrap();
+                output_state.redraw_state = if output_state.unfinished_animations_remain {
+                    RedrawState::Queued
+                } else {
+                    RedrawState::Idle
+                };
+                output_state.frame_callback_sequence =
+                    output_state.frame_callback_sequence.wrapping_add(1);
+                result
+            }
+            Err(err) if anyhow_is_change_pending(&err) => {
+                self.transition_display(DisplayEvent::Changed);
+                let output_state = niri.output_state.get_mut(output).unwrap();
+                output_state.redraw_state = RedrawState::Queued;
+                RenderResult::Skipped
+            }
+            Err(err) => {
+                let output_state = niri.output_state.get_mut(output).unwrap();
+                output_state.redraw_state = RedrawState::Idle;
+                error!("frame presentation failed: {err:#}");
+                niri.stop_signal.stop();
+                RenderResult::Skipped
+            }
+        }
+    }
+
+    fn render_frame(&mut self, niri: &mut Niri, output: &Output) -> anyhow::Result<RenderResult> {
+        assert!(matches!(self.display, Display::Active(_)));
+        let software_cursor = self.update_cursor(niri)?;
+        let elements = niri.render_to_vec(
+            RenderCtx {
+                renderer: &mut self.renderer,
+                target: RenderTarget::Output,
+                xray: None,
+            },
+            output,
+            software_cursor,
+        );
+        let Display::Active(active) = &mut self.display else {
+            unreachable!("render_frame requires Active");
+        };
+        let mut target = self.renderer.bind(&mut active.texture)?;
+        let result = active.damage.render_output(
+            &mut self.renderer,
+            &mut target,
+            usize::from(active.buffer_valid),
+            &elements,
+            [0.; 4],
+        )?;
+        niri.update_primary_scanout_output(output, &result.states);
+        if result.damage.is_none() {
+            self.pending_inputs.clear();
+            return Ok(RenderResult::NoDamage);
+        }
+        result.sync.wait()?;
+        let (width, height) = self.native.dimensions();
+        let mapping = self.renderer.copy_framebuffer(
+            &target,
+            Rectangle::from_size((width as i32, height as i32).into()),
+            Fourcc::Argb8888,
+        )?;
+        let pixels = self.renderer.map_texture(&mapping)?;
+        let stride = self.native.stride() as usize;
+        let buffer = self.native.framebuffer_mut();
+        let row_bytes = width as usize * 4;
+        for (row, source) in pixels
+            .chunks_exact(row_bytes)
+            .take(height as usize)
+            .enumerate()
+        {
+            buffer[row * stride..row * stride + row_bytes].copy_from_slice(source);
+        }
+        let presented = self.native.present()?;
+        let presentation_time = get_monotonic_time();
+        active.buffer_valid = true;
+        self.frame += 1;
+        info!(
+            "FERRION_FRAME frame={} started_us={} completed_us={}",
+            self.frame, presented.started_us, presented.completed_us
+        );
+        for read_us in self.pending_inputs.drain(..) {
+            info!(
+                "FERRION_INPUT frame={} read_us={} presented_us={}",
+                self.frame, read_us, presented.completed_us
+            );
+        }
+        niri.take_presentation_feedbacks(output, &result.states)
+            .presented::<_, smithay::utils::Monotonic>(
+                presentation_time,
+                Refresh::Unknown,
+                self.frame,
+                wp_presentation_feedback::Kind::empty(),
+            );
+        Ok(RenderResult::Submitted)
+    }
+}
