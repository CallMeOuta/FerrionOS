@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Added for FerrionOS on 2026-11-21, alongside niri's backend dispatch.
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use calloop::LoopHandle;
+use niri_config::{Config, OutputName};
+use smithay::output::Output;
+
+use super::{Backend, Headless};
+use crate::niri::State;
+
+impl Backend {
+    pub fn select(
+        config: Rc<RefCell<Config>>,
+        event_loop: LoopHandle<'static, State>,
+        headless: bool,
+    ) -> Result<Self, Box<dyn std::error::Error>> {
+        if headless {
+            return Ok(Self::Headless(Headless::new()));
+        }
+        #[cfg(feature = "ferrion")]
+        return Ok(Self::Ferrion(super::Ferrion::new(event_loop)?));
+        #[cfg(feature = "winit")]
+        if ["WAYLAND_DISPLAY", "WAYLAND_SOCKET", "DISPLAY"]
+            .iter()
+            .any(|key| std::env::var_os(key).is_some())
+        {
+            return Ok(Self::Winit(super::Winit::new(config, event_loop)?));
+        }
+        #[cfg(feature = "tty")]
+        {
+            return Ok(Self::Tty(super::Tty::new(config, event_loop)?));
+        }
+        #[cfg(not(feature = "tty"))]
+        Err("no native display backend enabled".into())
+    }
+
+    #[cfg(feature = "ferrion")]
+    pub fn ferrion(&mut self) -> &mut super::Ferrion {
+        match self {
+            Self::Ferrion(backend) => backend,
+            _ => panic!("native backend required"),
+        }
+    }
+
+    pub fn defer_redraw(&mut self, _niri: &crate::niri::Niri) -> bool {
+        #[cfg(feature = "ferrion")]
+        if let Self::Ferrion(backend) = self {
+            return backend.defer_redraw(_niri);
+        }
+        false
+    }
+
+    pub fn is_tty(&self) -> bool {
+        #[cfg(feature = "tty")]
+        if matches!(self, Self::Tty(_)) {
+            return true;
+        }
+        false
+    }
+
+    pub fn disconnected_connector_name(&mut self, name: &str) -> Option<OutputName> {
+        #[cfg(feature = "tty")]
+        if let Some(tty) = self.tty_checked() {
+            return tty.disconnected_connector_name_by_name_match(name);
+        }
+        None
+    }
+
+    pub fn gamma_size(&mut self, output: &Output) -> anyhow::Result<u32> {
+        #[cfg(feature = "tty")]
+        if let Some(tty) = self.tty_checked() {
+            return tty.get_gamma_size(output);
+        }
+        Ok(0)
+    }
+
+    pub fn gamma_ramp(&mut self, output: &Output, ramp: Option<Vec<u16>>) -> anyhow::Result<()> {
+        #[cfg(feature = "tty")]
+        if let Some(tty) = self.tty_checked() {
+            return tty.set_gamma(output, ramp);
+        }
+        anyhow::bail!("gamma control is unavailable on this backend")
+    }
+}
