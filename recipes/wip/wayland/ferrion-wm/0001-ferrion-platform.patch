+
+pub struct Inputd;
+macro_rules! event {
+    ($name:ident) => {
+        pub struct $name {
+            event: native::$name,
+            time: InputTime,
+        }
+        impl sm::Event<Inputd> for $name {
+            fn time(&self) -> InputTime {
+                self.time
+            }
+            fn device(&self) -> InputdDevice {
+                InputdDevice
+            }
+        }
+    };
+}
+event!(KeyEvent);
+event!(MotionEvent);
+event!(ButtonEvent);
+event!(AxisEvent);
+impl sm::KeyboardKeyEvent<Inputd> for KeyEvent {
+    fn key_code(&self) -> sm::Keycode {
+        (self.event.code + 8).into()
+    }
+    fn state(&self) -> sm::KeyState {
+        if self.event.pressed {
+            sm::KeyState::Pressed
+        } else {
+            sm::KeyState::Released
+        }
+    }
+    fn count(&self) -> u32 {
+        self.event.count
+    }
+}
+impl sm::PointerButtonEvent<Inputd> for ButtonEvent {
+    fn button_code(&self) -> u32 {
+        self.event.code
+    }
+    fn state(&self) -> sm::ButtonState {
+        if self.event.pressed {
+            sm::ButtonState::Pressed
+        } else {
+            sm::ButtonState::Released
+        }
+    }
+}
+impl sm::AbsolutePositionEvent<Inputd> for MotionEvent {
+    fn x(&self) -> f64 {
+        f64::from(self.event.x)
+    }
+    fn y(&self) -> f64 {
+        f64::from(self.event.y)
+    }
+    fn x_transformed(&self, width: i32) -> f64 {
+        f64::from(self.event.x) * f64::from(width.max(0)) / f64::from(self.event.width.max(1))
+    }
+    fn y_transformed(&self, height: i32) -> f64 {
+        f64::from(self.event.y) * f64::from(height.max(0)) / f64::from(self.event.height.max(1))
+    }
+}
+impl sm::PointerMotionAbsoluteEvent<Inputd> for MotionEvent {}
+impl sm::PointerAxisEvent<Inputd> for AxisEvent {
+    fn amount(&self, _: sm::Axis) -> Option<f64> {
+        None
+    }
+    fn amount_v120(&self, axis: sm::Axis) -> Option<f64> {
+        Some(
+            f64::from(match axis {
+                sm::Axis::Horizontal => self.event.horizontal,
+                sm::Axis::Vertical => self.event.vertical,
+            }) * 120.,
+        )
+    }
+    fn source(&self) -> sm::AxisSource {
+        sm::AxisSource::Wheel
+    }
+    fn relative_direction(&self, _: sm::Axis) -> sm::AxisRelativeDirection {
+        sm::AxisRelativeDirection::Identical
+    }
+}
+fn into_smithay(input: Input, time: InputTime) -> sm::InputEvent<Inputd> {
+    match input {
+        Input::Key(event) => sm::InputEvent::Keyboard {
+            event: KeyEvent { event, time },
+        },
+        Input::Motion(event) => sm::InputEvent::PointerMotionAbsolute {
+            event: MotionEvent { event, time },
+        },
+        Input::Button(event) => sm::InputEvent::PointerButton {
+            event: ButtonEvent { event, time },
+        },
+        Input::Axis(event) => sm::InputEvent::PointerAxis {
+            event: AxisEvent { event, time },
+        },
+    }
+}
+impl InputBackend for Inputd {
+    type Device = InputdDevice;
+    type KeyboardKeyEvent = KeyEvent;
+    type PointerAxisEvent = AxisEvent;
+    type PointerButtonEvent = ButtonEvent;
+    type PointerMotionEvent = UnusedEvent;
+    type PointerMotionAbsoluteEvent = MotionEvent;
+    type GestureSwipeBeginEvent = UnusedEvent;
+    type GestureSwipeUpdateEvent = UnusedEvent;
+    type GestureSwipeEndEvent = UnusedEvent;
+    type GesturePinchBeginEvent = UnusedEvent;
+    type GesturePinchUpdateEvent = UnusedEvent;
+    type GesturePinchEndEvent = UnusedEvent;
+    type GestureHoldBeginEvent = UnusedEvent;
+    type GestureHoldEndEvent = UnusedEvent;
+    type TouchDownEvent = UnusedEvent;
+    type TouchUpEvent = UnusedEvent;
+    type TouchMotionEvent = UnusedEvent;
+    type TouchCancelEvent = UnusedEvent;
+    type TouchFrameEvent = UnusedEvent;
+    type TabletToolAxisEvent = UnusedEvent;
+    type TabletToolProximityEvent = UnusedEvent;
+    type TabletToolTipEvent = UnusedEvent;
+    type TabletToolButtonEvent = UnusedEvent;
+    type SwitchToggleEvent = UnusedEvent;
+    type SpecialEvent = UnusedEvent;
+}
