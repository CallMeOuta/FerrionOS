+    /// Cascades a window that has no place of its own: a title strip lower and to the right of the
+    /// window on top, or at the top left of the working area when it would leave it there. The
+    /// first window is left to niri, which centers it.
+    fn place_new_floating_tile(&self, tile: &mut Tile<W>) {
+        let win = tile.window();
+        if tile.floating_pos.is_some()
+            || win.rules().default_floating_position.is_some()
+            || !win.pending_sizing_mode().is_normal()
+        {
+            return;
+        }
+
+        let Some((_, anchor)) = self.floating.tiles_with_offsets().next() else {
+            return;
+        };
+
+        let area = self.floating.working_area();
+        let size = tile.tile_size();
+        let mut pos = anchor + Point::from((CASCADE_STEP, CASCADE_STEP));
+        if pos.x + size.w > area.loc.x + area.size.w || pos.y + size.h > area.loc.y + area.size.h {
+            pos = area.loc;
+        }
+        tile.floating_pos = Some(self.floating.logical_to_size_frac(pos));
+    }
