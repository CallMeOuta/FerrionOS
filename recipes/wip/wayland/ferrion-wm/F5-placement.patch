     ) {
-        // ferrion-wm 2026-11-21 (F4): a free workspace opens every window floating.
-        let (target, is_floating) = self.free_add_target(target, is_floating);
+        // ferrion-wm 2026-11-21 (F4, F5): a free workspace opens every window floating, placed.
+        let (target, is_floating) = self.free_add_target(target, is_floating, &mut tile);
 
