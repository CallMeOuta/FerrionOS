+#[test]
+fn first_free_window_opens_centered_then_they_cascade() {
+    let layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            add_sized(1, 400, 300),
+            add_sized(2, 400, 300),
+            add_sized(3, 400, 300),
+        ],
+    );
+
+    let ws = active_ws(&layout);
+    assert_pos(floating_pos(ws, 1), 440., 210.);
+    assert_pos(floating_pos(ws, 2), 472., 242.);
+    assert_pos(floating_pos(ws, 3), 504., 274.);
+}
+
+#[test]
+fn cascade_returns_to_the_top_left() {
+    let layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            add_sized(1, 1000, 600),
+            add_sized(2, 1000, 600),
+            add_sized(3, 1000, 600),
+            add_sized(4, 1000, 600),
+        ],
+    );
+
+    let ws = active_ws(&layout);
+    // Centered at (140, 60); the next fits at (172, 92); the one after would leave the screen.
+    assert_pos(floating_pos(ws, 1), 140., 60.);
+    assert_pos(floating_pos(ws, 2), 172., 92.);
+    assert_pos(floating_pos(ws, 3), 0., 0.);
+    assert_pos(floating_pos(ws, 4), 32., 32.);
+}
+
+#[test]
+fn cascade_follows_the_window_in_use() {
+    let layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            add_sized(1, 400, 300),
+            add_sized(2, 400, 300),
+            Op::FocusWindow(1),
+            add_sized(3, 400, 300),
+        ],
+    );
+
+    let ws = active_ws(&layout);
+    let pos = floating_pos(ws, 2);
+    assert_pos(floating_pos(ws, 3), pos.x, pos.y);
+}
+
+#[test]
+fn columns_workspace_keeps_niri_placement() {
+    let mut dialog = TestWindowParams::new(2);
+    dialog.is_floating = true;
+    dialog.bbox = Rectangle::from_size(Size::from((400, 300)));
+
+    let layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow { params: dialog },
+    ]);
+
+    // niri centers a new floating window.
+    assert_pos(floating_pos(active_ws(&layout), 2), 440., 210.);
+}
