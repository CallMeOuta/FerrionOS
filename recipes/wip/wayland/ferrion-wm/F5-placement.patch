+/// Adds a window as [`Op::AddWindow`] does, and checks the placement of a free workspace: the
+/// first window opens centered, each next one a title strip lower and to the right of the one on
+/// top, and back at the top left of the working area when it would leave it.
+pub(super) fn add_window_and_check_placement(
+    layout: &mut Layout<TestWindow>,
+    mut params: TestWindowParams,
+) {
+    if layout.has_window(&params.id) {
+        return;
+    }
+    // A window with a parent is placed over the parent instead.
+    params.parent_id = None;
+    let id = params.id;
+
+    let before = layout
+        .active_workspace()
+        .filter(|ws| ws.is_free())
+        .map(|ws| {
+            let floating = ws.floating();
+            let anchor = floating.tiles_with_offsets().next().map(|(_, pos)| pos);
+            (ws.id(), floating.working_area(), anchor)
+        });
+
+    Op::AddWindow { params }.apply(layout);
+
+    let Some((ws_id, area, anchor)) = before else {
+        return;
+    };
+    let Some((_, ws)) = layout.find_workspace_by_id(ws_id) else {
+        return;
+    };
+    let Some((tile, pos)) = ws
+        .floating()
+        .tiles_with_offsets()
+        .find(|(tile, _)| *tile.window().id() == id)
+    else {
+        return;
+    };
+
+    let size = tile.tile_size();
+    let expected = match anchor {
+        None => crate::utils::center_preferring_top_left_in_area(area, size),
+        Some(anchor) => {
+            let step = crate::layout::free::CASCADE_STEP;
+            let pos = anchor + Point::from((step, step));
+            if pos.x + size.w > area.loc.x + area.size.w
+                || pos.y + size.h > area.loc.y + area.size.h
+            {
+                area.loc
+            } else {
+                pos
+            }
+        }
+    };
+    approx::assert_abs_diff_eq!(pos.x, expected.x, epsilon = 1e-3);
+    approx::assert_abs_diff_eq!(pos.y, expected.y, epsilon = 1e-3);
+}
