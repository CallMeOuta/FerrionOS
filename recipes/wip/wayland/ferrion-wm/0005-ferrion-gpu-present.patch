+
+fn query_gl_renderer(renderer: &mut GlesRenderer) -> String {
+    renderer
+        .with_context(|gl| unsafe {
+            let ptr = gl.GetString(gles_ffi::RENDERER) as *const c_char;
+            if ptr.is_null() {
+                String::from("unknown")
+            } else {
+                CStr::from_ptr(ptr).to_string_lossy().into_owned()
+            }
+        })
+        .unwrap_or_else(|_| String::from("unknown"))
+}
+
 fn is_change_pending(err: &io::Error) -> bool {
