 }
 
+fn is_flip_busy(err: &io::Error) -> bool {
+    err.kind() == io::ErrorKind::WouldBlock && !is_change_pending(err)
+}
+
+fn anyhow_is_flip_busy(err: &anyhow::Error) -> bool {
+    err.chain()
+        .find_map(|cause| cause.downcast_ref::<io::Error>())
+        .is_some_and(is_flip_busy)
+}
