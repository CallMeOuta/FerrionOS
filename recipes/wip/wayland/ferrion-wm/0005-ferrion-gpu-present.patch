+    fn on_flip_complete(&mut self, flip: FlipCompletion) -> anyhow::Result<()> {
+        assert!(matches!(self.display, Display::Active(_)));
+        self.native.complete_flip()?;
+        let Pacing::FlipPending(mut pending) = mem::replace(&mut self.pacing, Pacing::Idle) else {
+            unreachable!("flip completion without pending flip");
+        };
+        self.consecutive_flip_busy = 0;
+        let present_us = flip.completed_us.saturating_sub(pending.started_us);
+        info!(
+            "FERRION_FRAME frame={} started_us={} completed_us={} mode=flip composite_us={} sync_wait_us={} copy_us={} readback_us={} present_us={}",
+            pending.frame,
+            pending.started_us,
+            flip.completed_us,
+            pending.composite_us,
+            pending.sync_wait_us,
+            pending.copy_us,
+            pending.readback_us,
+            present_us
+        );
+        for read_us in pending.inputs {
+            info!(
+                "FERRION_INPUT frame={} read_us={} presented_us={}",
+                pending.frame, read_us, flip.completed_us
+            );
+        }
+        let presentation_time = Duration::from_micros(flip.tv_us);
+        pending
+            .feedbacks
+            .presented::<_, smithay::utils::Monotonic>(
+                presentation_time,
+                self.mode
+                    .refresh_interval
+                    .map(Refresh::Fixed)
+                    .unwrap_or(Refresh::Unknown),
+                pending.frame,
+                wp_presentation_feedback::Kind::HwCompletion,
+            );
+        self.scheduler.record_render(pending.started.elapsed());
+        Ok(())
+    }
