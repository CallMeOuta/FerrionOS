         let hotspot = position - geo.loc;
         let size = (geo.size.w as u32, geo.size.h as u32);
-        let capacity = self.native.cursor_size()?;
         if size.0 > capacity.0
             || size.1 > capacity.1
             || hotspot.x < 0
@@ -464,7 +477,11 @@
                 Display::ChangePending => unreachable!("update_cursor requires Active"),
             };
             if needs_hide {
-                self.native.set_cursor(None, (0, 0), (0, 0))?;
+                match self.native.set_cursor(None, (0, 0), (0, 0)) {
+                    Ok(()) => {}
+                    Err(err) if err.kind() == io::ErrorKind::Unsupported => {}
+                    Err(err) => return Err(err.into()),
+                }
                 if let Display::Active(active) = &mut self.display {
                     active.cursor = CursorPlane::Hidden;
                 }
@@ -487,7 +504,16 @@
         };
         if changed {
             if let CursorPlane::Shown(ref bytes, sz, hs) = next {
-                self.native.set_cursor(Some(bytes), sz, hs)?;
+                match self.native.set_cursor(Some(bytes), sz, hs) {
