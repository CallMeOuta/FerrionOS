--- /dev/null
+++ b/src/layout/free.rs
@@ -0,0 +1,23 @@
+//! The actions of the free mode on the layout as a whole.
+// Part of ferrion-wm, a fork of niri. Written on 2026-11-21.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use niri_ipc::WorkspaceMode;
+
+use super::{Layout, LayoutElement};
+
+impl<W: LayoutElement> Layout<W> {
+    /// Switches the focused workspace between arranging its windows freely and in columns.
+    pub fn toggle_workspace_mode(&mut self) {
+        if let Some(ws) = self.active_workspace_mut() {
+            ws.toggle_mode();
+        }
+    }
+
+    /// Sets how the focused workspace arranges its windows.
+    pub fn set_workspace_mode(&mut self, mode: WorkspaceMode) {
+        if let Some(ws) = self.active_workspace_mut() {
+            ws.set_mode(mode);
+        }
+    }
+}
