@@ -0,0 +1,435 @@
+// Tests of the free mode of ferrion-wm, a fork of niri. Written on 2026-11-21.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use niri_ipc::WorkspaceMode;
+
+use super::*;
+
+fn options_with_mode(mode: WorkspaceMode) -> Options {
+    Options {
+        layout: niri_config::Layout {
+            workspace_mode: mode,
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+}
+
+fn free_options() -> Options {
+    options_with_mode(WorkspaceMode::Free)
+}
+
+fn layout_part_with_mode(mode: WorkspaceMode) -> Box<niri_config::LayoutPart> {
+    Box::new(niri_config::LayoutPart {
+        workspace_mode: Some(mode),
+        ..Default::default()
+    })
+}
+
+fn active_ws(layout: &Layout<TestWindow>) -> &Workspace<TestWindow> {
+    layout.active_workspace().unwrap()
+}
+
+/// Ids of the windows in the scrolling layout, column by column from left to right.
+fn column_ids(ws: &Workspace<TestWindow>) -> Vec<usize> {
+    ws.scrolling()
+        .tiles()
+        .map(|tile| *tile.window().id())
+        .collect()
+}
+
+/// Ids of the windows in the floating layout, sorted.
+fn floating_ids(ws: &Workspace<TestWindow>) -> Vec<usize> {
+    let mut ids: Vec<usize> = ws
+        .floating()
+        .tiles()
+        .map(|tile| *tile.window().id())
+        .collect();
+    ids.sort_unstable();
+    ids
+}
+
+fn floating_pos(ws: &Workspace<TestWindow>, id: usize) -> Point<f64, Logical> {
+    ws.floating()
+        .tiles_with_offsets()
+        .find(|(tile, _)| *tile.window().id() == id)
+        .map(|(_, pos)| pos)
+        .unwrap()
+}
+
+fn window_size(layout: &Layout<TestWindow>, id: usize) -> Size<i32, Logical> {
+    let (_, win) = layout.windows().find(|(_, win)| *win.id() == id).unwrap();
+    win.size()
+}
+
+fn requested_size(layout: &Layout<TestWindow>, id: usize) -> Option<Size<i32, Logical>> {
+    let (_, win) = layout.windows().find(|(_, win)| *win.id() == id).unwrap();
+    win.requested_size()
+}
+
+fn move_to_x(id: usize, x: f64) -> Op {
+    Op::MoveFloatingWindow {
+        id: Some(id),
+        x: PositionChange::SetFixed(x),
+        y: PositionChange::SetFixed(50.),
+        animate: false,
+    }
+}
+
+#[test]
+fn new_window_opens_floating_on_free_workspace() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+    ];
+
+    let layout = check_ops_with_options(free_options(), ops);
+    let ws = active_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Free);
+    assert_eq!(floating_ids(ws), [1, 2]);
+    assert!(column_ids(ws).is_empty());
+    assert_eq!(layout.focus().map(|win| *win.id()), Some(2));
+}
+
+#[test]
+fn new_window_opens_as_column_on_columns_workspace() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+    ];
+
+    let layout = check_ops(ops);
+    let ws = active_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Columns);
+    assert_eq!(column_ids(ws), [1, 2]);
+    assert!(floating_ids(ws).is_empty());
+}
+
+#[test]
+fn switching_moves_every_window_across_and_keeps_its_size() {
+    let mut layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(3),
+        },
+        Op::Communicate(1),
+        Op::Communicate(2),
+        Op::Communicate(3),
+    ]);
+    let column_sizes: Vec<_> = (1..=3).map(|id| window_size(&layout, id)).collect();
+
+    // To free: every window floats, at the size it had as a column.
+    check_ops_on_layout(&mut layout, [Op::ToggleWorkspaceMode]);
+    let ws = active_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Free);
+    assert_eq!(floating_ids(ws), [1, 2, 3]);
+    assert!(column_ids(ws).is_empty());
+    for (id, size) in (1..=3).zip(&column_sizes) {
+        assert_eq!(requested_size(&layout, id), Some(*size));
+    }
+    // The focused window stays focused.
+    assert_eq!(layout.focus().map(|win| *win.id()), Some(3));
+
+    // Place them from right to left, and give one a size of its own.
+    check_ops_on_layout(
+        &mut layout,
+        [
+            move_to_x(1, 800.),
+            move_to_x(2, 400.),
+            move_to_x(3, 0.),
+            Op::SetWindowWidth {
+                id: Some(2),
+                change: SizeChange::SetFixed(300),
+            },
+            Op::Communicate(1),
+            Op::Communicate(2),
+            Op::Communicate(3),
+        ],
+    );
+    let free_positions: Vec<_> = (1..=3)
+        .map(|id| floating_pos(active_ws(&layout), id))
+        .collect();
+    let free_sizes: Vec<_> = (1..=3).map(|id| window_size(&layout, id)).collect();
+
+    // To columns: they line up in the order they sit from left to right.
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::ToggleWorkspaceMode,
+            Op::Communicate(1),
+            Op::Communicate(2),
+            Op::Communicate(3),
+        ],
+    );
+    let ws = active_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Columns);
+    assert_eq!(column_ids(ws), [3, 2, 1]);
+    assert!(floating_ids(ws).is_empty());
+    // A column keeps the window's width.
+    assert_eq!(window_size(&layout, 2).w, 300);
+
+    // Back to free: each window returns to the place and size it last had when free.
+    check_ops_on_layout(&mut layout, [Op::ToggleWorkspaceMode]);
+    let ws = active_ws(&layout);
+    assert_eq!(floating_ids(ws), [1, 2, 3]);
+    for id in 1..=3 {
+        assert_eq!(floating_pos(ws, id), free_positions[id - 1]);
+        assert_eq!(requested_size(&layout, id), Some(free_sizes[id - 1]));
+    }
+}
+
+#[test]
+fn switching_to_columns_keeps_a_dialog_floating() {
+    let mut dialog = TestWindowParams::new(2);
+    dialog.parent_id = Some(1);
+
+    let mut layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::AddWindow { params: dialog },
+        ],
+    );
+    check_ops_on_layout(&mut layout, [Op::ToggleWorkspaceMode]);
+
+    let ws = active_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Columns);
+    assert_eq!(column_ids(ws), [1]);
+    assert_eq!(floating_ids(ws), [2]);
+}
+
+#[test]
+fn fixed_height_window_stays_floating_in_columns() {
+    let mut fixed = TestWindowParams::new(2);
+    fixed.min_max_size = (Size::from((0, 300)), Size::from((0, 300)));
+
+    let layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::AddWindow { params: fixed },
+            Op::ToggleWorkspaceMode,
+        ],
+    );
+
+    let ws = active_ws(&layout);
+    assert_eq!(column_ids(ws), [1]);
+    assert_eq!(floating_ids(ws), [2]);
+}
+
+#[test]
+fn fullscreen_window_on_free_workspace_returns_to_floating() {
+    let layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::FullscreenWindow(1),
+        ],
+    );
+    let ws = active_ws(&layout);
+    assert_eq!(column_ids(ws), [1]);
+
+    let mut layout = layout;
+    check_ops_on_layout(
+        &mut layout,
+        [Op::SetFullscreenWindow {
+            window: 1,
+            is_fullscreen: false,
+        }],
+    );
+    assert_eq!(floating_ids(active_ws(&layout)), [1]);
+}
+
+#[test]
+fn fullscreen_column_returns_to_floating_after_switch_to_free() {
+    let layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+        Op::FullscreenWindow(1),
+        Op::ToggleWorkspaceMode,
+        Op::FullscreenWindow(1),
+    ]);
+    let ws = active_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Free);
+    assert_eq!(floating_ids(ws), [1, 2]);
+    assert!(column_ids(ws).is_empty());
+}
+
+#[test]
+fn floating_window_cannot_join_the_columns_of_a_free_workspace() {
+    let layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::ToggleWindowFloating { id: None },
+            Op::SetWindowFloating {
+                id: Some(1),
+                floating: false,
+            },
+        ],
+    );
+    assert_eq!(floating_ids(active_ws(&layout)), [1]);
+}
+
+#[test]
+fn column_moved_to_free_workspace_floats() {
+    let layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::FocusWorkspaceDown,
+        Op::SetWorkspaceMode(WorkspaceMode::Free),
+        Op::FocusWorkspaceUp,
+        Op::MoveColumnToWorkspaceDown(true),
+    ]);
+
+    let ws = active_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Free);
+    assert_eq!(floating_ids(ws), [1]);
+}
+
+#[test]
+fn named_workspace_takes_the_mode_of_its_own_layout() {
+    let layout = check_ops_with_options(
+        free_options(),
+        [
+            Op::AddOutput(1),
+            Op::AddNamedWorkspace {
+                ws_name: 1,
+                output_names: vec![1],
+                layout_config: Some(layout_part_with_mode(WorkspaceMode::Columns)),
+            },
+        ],
+    );
+
+    let modes: Vec<_> = layout
+        .workspaces()
+        .map(|(_, _, ws)| (ws.name().cloned(), ws.mode()))
+        .collect();
+    assert_eq!(
+        modes,
+        [
+            (Some(String::from("ws1")), WorkspaceMode::Columns),
+            (None, WorkspaceMode::Free),
+        ]
+    );
+}
+
+#[test]
+fn changing_the_default_rearranges_no_window() {
+    let layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::UpdateConfig {
+            layout_config: layout_part_with_mode(WorkspaceMode::Free),
+        },
+    ]);
+
+    // The workspace with a window keeps its columns; the empty one at the end takes the default.
+    let modes: Vec<_> = layout.workspaces().map(|(_, _, ws)| ws.mode()).collect();
+    assert_eq!(modes, [WorkspaceMode::Columns, WorkspaceMode::Free]);
+    assert_eq!(column_ids(active_ws(&layout)), [1]);
+}
+
+fn named_ws(layout: &Layout<TestWindow>) -> &Workspace<TestWindow> {
+    layout
+        .workspaces()
+        .map(|(_, _, ws)| ws)
+        .find(|ws| ws.name().is_some())
+        .unwrap()
+}
+
+#[test]
+fn own_mode_of_a_named_workspace_follows_a_reload_unless_switched_by_hand() {
+    let mut layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddNamedWorkspace {
+            ws_name: 1,
+            output_names: vec![1],
+            layout_config: None,
+        },
+        Op::AddWindowToNamedWorkspace {
+            params: TestWindowParams::new(1),
+            ws_name: 1,
+        },
+        Op::UpdateWorkspaceLayoutConfig {
+            ws_name: 1,
+            layout_config: Some(layout_part_with_mode(WorkspaceMode::Free)),
+        },
+    ]);
+    let ws = named_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Free);
+    assert_eq!(floating_ids(ws), [1]);
+
+    // Switched by hand, the workspace keeps its mode through a reload of its own option.
+    let mut part = layout_part_with_mode(WorkspaceMode::Free);
+    part.gaps = Some(FloatOrInt(4.));
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::FocusWindow(1),
+            Op::ToggleWorkspaceMode,
+            Op::UpdateWorkspaceLayoutConfig {
+                ws_name: 1,
+                layout_config: Some(part),
+            },
+        ],
+    );
+    let ws = named_ws(&layout);
+    assert_eq!(ws.mode(), WorkspaceMode::Columns);
+    assert_eq!(column_ids(ws), [1]);
+}
+
+#[test]
+fn new_workspace_follows_the_default() {
+    let layout = check_ops_with_options(
+        options_with_mode(WorkspaceMode::Free),
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::ToggleWorkspaceMode,
+            Op::FocusWorkspaceDown,
+        ],
+    );
+
+    let modes: Vec<_> = layout.workspaces().map(|(_, _, ws)| ws.mode()).collect();
+    assert_eq!(modes, [WorkspaceMode::Columns, WorkspaceMode::Free]);
+}
