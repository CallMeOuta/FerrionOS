+//! The free mode of a workspace.
+//!
+//! A workspace arranges its windows in columns, niri's scrolling layout, or freely, in the
+//! floating layout ([`WorkspaceMode`]). In a free workspace every window floats, except one that
+//! is fullscreen or maximized: niri keeps those in the scrolling layout, and they return to
+//! floating when they leave that state.
+//!
+//! Switching the mode moves every window across and keeps its size. Going to columns lines the
+//! windows up in the order they sit from left to right, except the ones niri floats by itself
+//! (dialogs, fixed-height windows, `open-floating true`). Going back to free gives each window
+//! the place and size it last had when free, or its place on the strip the first time.
+//!
+//! The mode set in the config's `layout`, globally or for an output, is the default for new
+//! workspaces: a config reload gives it to the workspaces that have no window, and leaves the
+//! others as they are, so changing the default rearranges no window. The same option in a named
+//! workspace's own `layout` is that workspace's, and follows a reload. The action wins over both.
+// Part of ferrion-wm, a fork of niri. Written on 2026-11-21.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use niri_ipc::WorkspaceMode;
+use smithay::utils::{Logical, Point};
+
+use super::{FloatingActive, Workspace, WorkspaceAddWindowTarget};
+use crate::layout::{LayoutElement, Options};
+use crate::utils::transaction::Transaction;
+
+/// The free-mode state of a workspace.
+#[derive(Debug)]
+pub(super) struct FreeState {
+    /// How the windows are arranged now.
+    mode: WorkspaceMode,
+    /// The mode chosen with the action, which wins over the configured one.
+    chosen: Option<WorkspaceMode>,
+    /// The default mode the workspace took: when it was created, or at a config change while it
+    /// had no window.
+    default: WorkspaceMode,
+}
+
+impl FreeState {
+    /// The state of a new workspace, from the options it inherits and its own layout config.
+    pub(super) fn new(base_options: &Options, own: Option<&niri_config::LayoutPart>) -> Self {
+        let default = base_options.layout.workspace_mode;
+        Self {
+            mode: own.and_then(|part| part.workspace_mode).unwrap_or(default),
+            chosen: None,
+            default,
+        }
+    }
+}
+
+/// Whether niri would float this window by itself, also in columns: a window with a parent, a
+/// window of fixed height, and a window whose rules say so (`compute_open_floating`).
+fn floats_by_itself<'a, W: LayoutElement + 'a>(
+    win: &W,
+    mut others: impl Iterator<Item = &'a W>,
+) -> bool {
+    if let Some(open_floating) = win.rules().open_floating {
+        return open_floating;
+    }
+
+    if others.any(|other| win.is_child_of(other)) {
+        return true;
+    }
+
+    let (min_size, max_size) = (win.min_size(), win.max_size());
+    min_size.h > 0 && min_size.h == max_size.h
+}
+
+impl<W: LayoutElement> Workspace<W> {
+    /// How the workspace arranges its windows.
+    pub fn mode(&self) -> WorkspaceMode {
+        self.free.mode
+    }
+
+    /// Whether the workspace arranges its windows freely.
+    pub fn is_free(&self) -> bool {
+        self.free.mode == WorkspaceMode::Free
+    }
+
+    /// The mode chosen with the action, or else the workspace's own option, or else the default
+    /// it took.
+    fn wanted_mode(&self) -> WorkspaceMode {
+        let own = self
+            .layout_config
+            .as_ref()
+            .and_then(|part| part.workspace_mode);
+        self.free.chosen.or(own).unwrap_or(self.free.default)
+    }
+
+    /// Chooses how the workspace arranges its windows, as the action does.
+    pub fn set_mode(&mut self, mode: WorkspaceMode) {
+        self.free.chosen = Some(mode);
+        self.apply_mode();
+    }
+
+    pub fn toggle_mode(&mut self) {
+        let mode = match self.free.mode {
+            WorkspaceMode::Columns => WorkspaceMode::Free,
+            WorkspaceMode::Free => WorkspaceMode::Columns,
+        };
+        self.set_mode(mode);
+    }
+
+    /// Arranges the windows in the wanted mode, after the choice or the options changed. A
+    /// workspace without windows takes the current default.
+    pub(super) fn apply_mode(&mut self) {
+        if !self.has_windows() {
+            self.free.default = self.base_options.layout.workspace_mode;
+        }
+
+        let mode = self.wanted_mode();
+        if self.free.mode == mode {
+            return;
+        }
+
+        self.free.mode = mode;
+        match mode {
+            WorkspaceMode::Free => self.float_columns(),
+            WorkspaceMode::Columns => self.tile_floating_into_columns(),
+        }
+    }
+
+    /// Whether a new window opens floating: always on a free workspace, and otherwise as niri
+    /// decided (`compute_open_floating`).
+    pub fn opens_floating(&self, niri_decision: bool) -> bool {
+        niri_decision || self.is_free()
+    }
+
+    /// Where a window added to a free workspace goes: always to the floating layout, which niri's
+    /// `add_tile()` turns into the scrolling layout only for a fullscreen or maximized window.
+    pub(super) fn free_add_target<'a>(
+        &self,
+        target: WorkspaceAddWindowTarget<'a, W>,
+        is_floating: bool,
+    ) -> (WorkspaceAddWindowTarget<'a, W>, bool) {
+        if !self.is_free() {
+            return (target, is_floating);
+        }
+
+        let target = match target {
+            WorkspaceAddWindowTarget::NewColumnAt(_) => WorkspaceAddWindowTarget::Auto,
+            target => target,
+        };
+        (target, true)
+    }
+
+    /// Floats the windows that arrived in the columns of a free workspace as a column.
+    pub(super) fn free_after_adding_to_columns(&mut self) {
+        if self.is_free() {
+            self.float_columns();
+        }
+    }
+
+    /// Whether moving a window from the floating layout to the columns is refused: on a free
+    /// workspace, where only fullscreen and maximized windows live in columns.
+    pub fn refuses_columns_for(&self, id: Option<&W::Id>) -> bool {
+        self.is_free()
+            && id.map_or(self.floating_is_active.get(), |id| {
+                self.floating.has_window(id)
+            })
+    }
+
+    /// Whether an operation on a column is refused: on a free workspace, whose columns hold only
+    /// fullscreen and maximized windows, which a change of the column's size would make normal.
+    pub(super) fn free_refuses_column_op(&self, window: Option<&W::Id>) -> bool {
+        self.is_free()
+            && !window.map_or(self.floating_is_active.get(), |id| {
+                self.floating.has_window(id)
+            })
+    }
+
+    /// Moves every window of normal size from the columns to the floating layout, and makes the
+    /// fullscreen and maximized ones return there when they leave that state.
+    fn float_columns(&mut self) {
+        for tile in self.scrolling.tiles_mut() {
+            tile.restore_to_floating = true;
+        }
+
+        let mut ids: Vec<W::Id> = self
+            .scrolling
+            .tiles()
+            .filter(|tile| tile.window().pending_sizing_mode().is_normal())
+            .map(|tile| tile.window().id().clone())
+            .collect();
+        if ids.is_empty() {
+            return;
+        }
+
+        let scrolling_was_active = !self.floating_is_active.get();
+        let active = self.scrolling.active_window().map(|win| win.id().clone());
+        // Add the active window last, which puts it on top.
+        if let Some(active) = &active {
+            if let Some(idx) = ids.iter().position(|id| id == active) {
+                let id = ids.remove(idx);
+                ids.push(id);
+            }
+        }
+
+        for id in ids {
+            let render_pos = self
+                .scrolling
+                .tiles_with_render_positions()
+                .find(|(tile, _, _)| *tile.window().id() == id)
+                .map(|(_, pos, _)| pos)
+                .unwrap();
+
+            let mut removed = self.scrolling.remove_tile(&id, Transaction::new());
+            removed.tile.stop_move_animations();
+
+            // The first time, the window floats where it sat on the strip.
+            if self
+                .floating
+                .stored_or_default_tile_pos(&removed.tile)
+                .is_none()
+            {
+                let size = removed.tile.tile_size();
+                let pos = self.floating.clamp_within_working_area(render_pos, size);
+                removed.tile.floating_pos = Some(self.floating.logical_to_size_frac(pos));
+            }
+
+            let activate = scrolling_was_active && active.as_ref() == Some(&id);
+            self.floating.add_tile(removed.tile, activate);
+            if activate {
+                self.floating_is_active = FloatingActive::Yes;
+            }
+
+            self.animate_tile_from(&id, render_pos);
+        }
+
+        if self.scrolling.is_empty() && !self.floating.is_empty() {
+            self.floating_is_active = FloatingActive::Yes;
+        }
+    }
+
+    /// Moves the floating windows into columns, in the order they sit from left to right, except
+    /// the ones niri floats by itself.
+    fn tile_floating_into_columns(&mut self) {
+        let mut moving: Vec<(W::Id, f64, f64)> = self
+            .floating
+            .tiles_with_offsets()
+            .filter(|(tile, _)| {
+                let others = self.floating.tiles().chain(self.scrolling.tiles());
+                !floats_by_itself(tile.window(), others.map(|tile| tile.window()))
+            })
+            .map(|(tile, pos)| (tile.window().id().clone(), pos.x, pos.y))
+            .collect();
+        if moving.is_empty() {
+            return;
+        }
+        moving.sort_by(|a, b| f64::total_cmp(&a.1, &b.1).then(f64::total_cmp(&a.2, &b.2)));
+
+        let floating_was_active = self.floating_is_active.get();
+        let active = self.floating.active_window().map(|win| win.id().clone());
+
+        for (id, _, _) in &moving {
+            let render_pos = self
+                .floating
+                .tiles_with_render_positions()
+                .find(|(tile, _)| tile.window().id() == id)
+                .map(|(_, pos)| pos)
+                .unwrap();
+
+            let mut removed = self.floating.remove_tile(id);
+            removed.tile.stop_move_animations();
+
+            let col_idx = self.scrolling.columns().count();
+            self.scrolling.add_tile(
+                Some(col_idx),
+                removed.tile,
+                false,
+                removed.width,
+                removed.is_full_width,
+                None,
+            );
+
+            self.animate_tile_from(id, render_pos);
+        }
+
+        if let Some(active) = active.filter(|active| moving.iter().any(|(id, ..)| id == active)) {
+            if floating_was_active {
+                self.scrolling.activate_window(&active);
+                self.floating_is_active = FloatingActive::No;
+            }
+        }
+
+        if self.floating.is_empty() {
+            self.floating_is_active = FloatingActive::No;
+        }
+    }
+
+    /// Animates a tile from where it was drawn before it moved between the two layouts.
+    fn animate_tile_from(&mut self, id: &W::Id, old_render_pos: Point<f64, Logical>) {
+        if let Some((tile, new_render_pos)) = self
+            .tiles_with_render_positions_mut(false)
+            .find(|(tile, _)| tile.window().id() == id)
+        {
+            tile.animate_move_from(old_render_pos - new_render_pos);
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn free_verify_invariants(&self) {
+        assert_eq!(
+            self.free.mode,
+            self.wanted_mode(),
+            "a workspace must be arranged in the chosen mode, its own or its default"
+        );
+
+        if self.is_free() {
+            for tile in self.scrolling.tiles() {
+                assert!(
+                    !tile.window().pending_sizing_mode().is_normal(),
+                    "a free workspace keeps only fullscreen or maximized windows in columns"
+                );
+                assert!(
+                    tile.restore_to_floating,
+                    "a fullscreen or maximized window of a free workspace must return to floating"
+                );
+            }
+        }
+    }
+}
