From 28107d33d549bdc285b50234e77fcb5c43cb863a Mon Sep 17 00:00:00 2001
From: FerrionOS contributors <contributors@ferrion.invalid>
Date: Sat, 21 Nov 2026 15:05:40 -0800
Subject: [PATCH] smithay: Gate unavailable platform interfaces for FerrionOS

Make input emulation optional, reject unsupported dma-buf synchronization,
and use the target siginfo layout. Keep niri's pinned Smithay API and MIT
license. The native compositor cook and shared-memory clients exercise
this graph; Linux default-feature compositor tests cover the host path.
---
 Cargo.toml                      | 5 +++--
 src/backend/allocator/dmabuf.rs | 6 ++++++
 src/reexports.rs                | 2 ++
 src/wayland/shm/pool.rs         | 5 +++--
 4 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 7a4dbfbe..2155979a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,4 @@
+# Modified for FerrionOS on 2026-11-21; MIT license retained.
 [package]
 name = "smithay"
 version = "0.7.0"
@@ -74,7 +75,7 @@ pixman = { version = "0.2.1", features = ["drm-fourcc", "sync"], optional = true
 aliasable = { version = "0.1.3", optional = true }
 portable-atomic = { version = "1", features = ["float"] }
 tracy-client = { version = "0.18.4", default-features = false, optional = true }
-reis = { version = "0.7.0", features = ["calloop"] }
+reis = { version = "0.7.0", features = ["calloop"], optional = true }
 glam = { version = "0.33.2", default-features = false, features = ["std"] }
 
 [dev-dependencies]
@@ -102,7 +103,7 @@ backend_session = []
 backend_udev = ["udev", "input/udev"]
 backend_vulkan = ["ash", "scopeguard"]
 backend_session_libseat = ["backend_session", "libseat"]
-backend_libei = ["wayland_frontend"]
+backend_libei = ["wayland_frontend", "dep:reis"]
 desktop = []
 renderer_gl = ["gl_generator", "backend_egl"]
 renderer_glow = ["renderer_gl", "glow"]
diff --git a/src/backend/allocator/dmabuf.rs b/src/backend/allocator/dmabuf.rs
index 405e544b..e0dce9cb 100644
--- a/src/backend/allocator/dmabuf.rs
+++ b/src/backend/allocator/dmabuf.rs
@@ -1,3 +1,4 @@
+// Modified for FerrionOS on 2026-11-21; MIT license retained.
 //! Module for [dmabuf](https://docs.kernel.org/driver-api/dma-buf.html) buffers.
 //!
 //! `Dmabuf`s act alike to smart pointers and can be freely cloned and passed around.
@@ -321,8 +322,12 @@ impl Dmabuf {
             .planes
             .get(idx)
             .ok_or(DmabufSyncFailed::PlaneIndexOutOfBound)?;
+        #[cfg(not(target_os = "redox"))]
         unsafe { rustix::ioctl::ioctl(&plane.fd, Setter::<DMA_BUF_SYNC, _>::new(dma_buf_sync { flags })) }
             .map_err(std::io::Error::from)?;
+        #[cfg(target_os = "redox")]
+        return Err(std::io::Error::from(std::io::ErrorKind::Unsupported).into());
+        #[cfg(not(target_os = "redox"))]
         Ok(())
     }
 }
@@ -399,6 +404,7 @@ struct dma_buf_sync {
     flags: DmabufSyncFlags,
 }
 
+#[cfg(not(target_os = "redox"))]
 const DMA_BUF_SYNC: rustix::ioctl::Opcode = rustix::ioctl::opcode::write::<dma_buf_sync>(b'b', 0);
 
 /// A mapping into a [`Dmabuf`]
diff --git a/src/reexports.rs b/src/reexports.rs
index 59cc60ff..abcc99a3 100644
--- a/src/reexports.rs
+++ b/src/reexports.rs
@@ -1,3 +1,4 @@
+// Modified for FerrionOS on 2026-11-21; MIT license retained.
 //! Reexports of crates, that are part of the public api, for convenience
 
 #[cfg(feature = "backend_vulkan")]
@@ -13,6 +14,7 @@ pub use glow;
 pub use input;
 #[cfg(feature = "renderer_pixman")]
 pub use pixman;
+#[cfg(feature = "backend_libei")]
 pub use reis;
 pub use rustix;
 #[cfg(feature = "tracy_gpu_profiling")]
diff --git a/src/wayland/shm/pool.rs b/src/wayland/shm/pool.rs
index b52e731b..70a4fccd 100644
--- a/src/wayland/shm/pool.rs
+++ b/src/wayland/shm/pool.rs
@@ -1,3 +1,4 @@
+// Modified for FerrionOS on 2026-11-21; MIT license retained.
 use std::{
     cell::Cell,
     mem,
@@ -350,7 +351,7 @@ extern "C" fn sigbus_handler(_signum: libc::c_int, info: *mut libc::siginfo_t, _
 /// SAFETY:
 /// The returned pointer points to a struct. Make sure that you use it
 /// appropriately.
-#[cfg(any(target_os = "linux", target_os = "android"))]
+#[cfg(any(target_os = "linux", target_os = "android", target_os = "redox"))]
 unsafe fn siginfo_si_addr(info: *mut libc::siginfo_t) -> *mut libc::c_void {
     #[repr(C)]
     #[allow(non_camel_case_types)]
@@ -362,7 +363,7 @@ unsafe fn siginfo_si_addr(info: *mut libc::siginfo_t) -> *mut libc::c_void {
     unsafe { (*(info as *const siginfo_t)).si_addr }
 }
 
-#[cfg(not(any(target_os = "linux", target_os = "android")))]
+#[cfg(not(any(target_os = "linux", target_os = "android", target_os = "redox")))]
 unsafe fn siginfo_si_addr(info: *mut libc::siginfo_t) -> *mut libc::c_void {
     unsafe { (*info).si_addr as _ }
 }
-- 
2.56.1

