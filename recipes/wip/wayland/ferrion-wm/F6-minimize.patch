@@ -0,0 +1,32 @@
+//! The requests of the free mode from clients: minimize, from an app and from a dock.
+// Part of ferrion-wm, a fork of niri. Written on 2026-11-21 (F6).
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use smithay::reexports::wayland_protocols::xdg::shell::server::xdg_toplevel::WmCapabilities;
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::wayland::shell::xdg::ToplevelSurface;
+
+use crate::niri::State;
+
+/// Advertises the minimize capability to a toplevel, or withdraws it. A configure carries it.
+pub fn set_minimize_capability(toplevel: &ToplevelSurface, can_minimize: bool) {
+    toplevel.with_pending_state(|state| {
+        if can_minimize {
+            state.capabilities.set(WmCapabilities::Minimize);
+        } else {
+            state.capabilities.unset(WmCapabilities::Minimize);
+        }
+    });
+}
+
+impl State {
+    /// Minimizes a window at the request of its app (xdg-shell) or of a dock (foreign toplevel).
+    /// Only a floating window of a free workspace minimizes.
+    pub fn minimize_request_for(&mut self, wl_surface: &WlSurface) {
+        if let Some((mapped, _)) = self.niri.layout.find_window_and_output(wl_surface) {
+            let window = mapped.window.clone();
+            self.niri.layout.minimize_window(Some(&window));
+            self.niri.queue_redraw_all();
+        }
+    }
+}
