diff --git a/src/layout/floating/stacking.rs b/src/layout/floating/stacking.rs
new file mode 100644
index 00000000..242d411f
--- /dev/null
+++ b/src/layout/floating/stacking.rs
@@ -0,0 +1,91 @@
+//! The stacking additions of the free mode to the floating layout.
+//!
+//! A minimized window stays a tile of the floating layout, parked: it keeps its place and size
+//! and every operation on it, but it is not drawn, cannot be hit by the pointer, and never has
+//! the focus. Activating it again unparks it on top.
+// Part of ferrion-wm, a fork of niri. Written on 2026-11-21 (F6).
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use std::iter::zip;
+
+use smithay::utils::{Logical, Point};
+
+use super::FloatingSpace;
+use crate::layout::tile::Tile;
+use crate::layout::LayoutElement;
+
+impl<W: LayoutElement> FloatingSpace<W> {
+    /// Whether this window is minimized.
+    pub fn is_parked(&self, id: &W::Id) -> bool {
+        self.idx_of(id).is_some_and(|idx| self.data[idx].parked)
+    }
+
+    /// Whether any window is not minimized.
+    pub fn has_unparked(&self) -> bool {
+        self.data.iter().any(|data| !data.parked)
+    }
+
+    /// The windows that are not minimized, from the top, with their positions.
+    pub fn unparked_tiles_with_offsets(
+        &self,
+    ) -> impl Iterator<Item = (&Tile<W>, Point<f64, Logical>)> + '_ {
+        zip(&self.tiles, &self.data)
+            .filter(|(_, data)| !data.parked)
+            .map(|(tile, data)| (tile, data.logical_pos))
+    }
+
+    /// Whether the active window is minimized, which happens only when every window is.
+    pub(super) fn active_is_parked(&self) -> bool {
+        self.active_window_id
+            .as_ref()
+            .is_some_and(|id| self.is_parked(id))
+    }
+
+    /// The window to make active after the active one went: the top one that is not minimized,
+    /// or else the top one.
+    pub(super) fn next_active_id(&self) -> W::Id {
+        let tile = self
+            .unparked_tiles_with_offsets()
+            .next()
+            .map(|(tile, _)| tile)
+            .unwrap_or(&self.tiles[0]);
+        tile.window().id().clone()
+    }
+
+    /// Unparks a window before it is activated.
+    pub(super) fn unpark_idx(&mut self, idx: usize) {
+        self.data[idx].parked = false;
