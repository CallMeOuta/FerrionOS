diff --git a/src/tests/free_mode.rs b/src/tests/free_mode.rs
new file mode 100644
index 00000000..5df3aebf
--- /dev/null
+++ b/src/tests/free_mode.rs
@@ -0,0 +1,70 @@
+// Client tests of the free mode of ferrion-wm, a fork of niri. Written on 2026-11-21 (F6).
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use client::ClientId;
+use niri_config::Config;
+use niri_ipc::WorkspaceMode;
+use smithay::reexports::wayland_protocols::xdg::shell::server::xdg_toplevel::WmCapabilities;
+use wayland_client::protocol::wl_surface::WlSurface;
+
+use super::*;
+
+fn set_up(mode: WorkspaceMode) -> (Fixture, ClientId, WlSurface) {
+    let mut config = Config::default();
+    config.layout.workspace_mode = mode;
+
+    let mut f = Fixture::with_config(config);
+    f.add_output(1, (1920, 1080));
+
+    let id = f.add_client();
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.set_size(100, 100);
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+
+    (f, id, surface)
+}
+
+/// Whether the window floats, whether it was offered minimize, and whether it is minimized.
+fn state(f: &mut Fixture) -> (bool, bool, bool) {
+    let niri = f.niri();
+    let (_, mapped) = niri.layout.windows().next().unwrap();
+    let can_minimize = mapped
+        .toplevel()
+        .with_pending_state(|state| state.capabilities.contains(WmCapabilities::Minimize));
+    let ws = niri.layout.active_workspace().unwrap();
+    (
+        ws.is_floating(&mapped.window),
+        can_minimize,
+        mapped.is_minimized(),
+    )
+}
+
+#[test]
+fn free_window_floats_and_minimizes_at_its_request() {
+    let (mut f, id, surface) = set_up(WorkspaceMode::Free);
+    assert_eq!(state(&mut f), (true, true, false));
+
+    f.client(id).window(&surface).xdg_toplevel.set_minimized();
+    f.double_roundtrip(id);
+
+    assert_eq!(state(&mut f), (true, true, true));
+    assert!(f.niri().layout.focus().is_none());
+}
+
+#[test]
+fn columns_window_is_not_offered_minimize() {
+    let (mut f, id, surface) = set_up(WorkspaceMode::Columns);
+    assert_eq!(state(&mut f), (false, false, false));
+
+    f.client(id).window(&surface).xdg_toplevel.set_minimized();
+    f.double_roundtrip(id);
+
+    assert_eq!(state(&mut f), (false, false, false));
+}
