+
+    /// Tells every window whether it can be minimized, and whether it is: a floating window of
+    /// a free workspace can.
+    pub(super) fn free_refresh(&mut self) {
+        let is_free = self.is_free();
+        for tile in self.scrolling.tiles_mut() {
+            tile.window_mut().set_free_state(false, false);
+        }
+        let parked: Vec<bool> = self
+            .floating
+            .tiles()
+            .map(|tile| self.floating.is_parked(tile.window().id()))
+            .collect();
+        for (tile, parked) in self.floating.tiles_mut().zip(parked) {
+            tile.window_mut().set_free_state(is_free, parked);
+        }
+    }
 }
