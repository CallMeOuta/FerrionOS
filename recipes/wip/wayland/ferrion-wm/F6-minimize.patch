diff --git a/src/layout/floating/stacking.rs b/src/layout/floating/stacking.rs
new file mode 100644
index 00000000..e2858841
--- /dev/null
+++ b/src/layout/floating/stacking.rs
@@ -0,0 +1,148 @@
+// Part of ferrion-wm, a fork of niri. Written on 2026-11-21 (F6).
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use std::iter::zip;
+
+use smithay::utils::{Logical, Point};
+
+use super::FloatingSpace;
+use crate::layout::tile::Tile;
+use crate::layout::LayoutElement;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Visibility {
+    Shown,
+    Minimized,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) enum FloatActive<Id> {
+    Window(Id),
+    NoneShown,
+}
+
+impl<Id> FloatActive<Id> {
+    pub(super) fn as_id(&self) -> Option<&Id> {
+        match self {
+            Self::Window(id) => Some(id),
+            Self::NoneShown => None,
+        }
+    }
+}
+
+pub(super) enum MinimizeEvent<Id> {
+    Minimize(Id),
+    Activate(Id),
+    Removed(Id),
+    Added { id: Id, activate: bool },
+    EnterFree,
+    LeaveFree,
+}
+
+impl<W: LayoutElement> FloatingSpace<W> {
+    pub fn is_free_mode(&self) -> bool {
+        self.workspace_is_free
+    }
+
+    pub fn is_parked(&self, id: &W::Id) -> bool {
+        self.idx_of(id)
+            .is_some_and(|idx| self.data[idx].visibility == Visibility::Minimized)
+    }
+
+    pub fn has_unparked(&self) -> bool {
+        self.data
+            .iter()
+            .any(|data| data.visibility == Visibility::Shown)
+    }
+
+    pub fn unparked_tiles_with_offsets(
+        &self,
+    ) -> impl Iterator<Item = (&Tile<W>, Point<f64, Logical>)> + '_ {
+        zip(&self.tiles, &self.data)
+            .filter(|(_, data)| data.visibility == Visibility::Shown)
+            .map(|(tile, data)| (tile, data.logical_pos))
+    }
+
+    fn first_shown_id(&self) -> FloatActive<W::Id> {
+        match self.unparked_tiles_with_offsets().next() {
+            Some((tile, _)) => FloatActive::Window(tile.window().id().clone()),
+            None => FloatActive::NoneShown,
+        }
+    }
+
+    pub(super) fn apply_minimize(&mut self, event: MinimizeEvent<W::Id>) {
+        match event {
+            MinimizeEvent::Minimize(id) => {
+                assert!(self.workspace_is_free);
+                let Some(idx) = self.idx_of(&id) else {
+                    return;
+                };
+                self.data[idx].visibility = Visibility::Minimized;
+                self.tiles[idx].window_mut().set_free_state(true, true);
+                if self.active.as_id() == Some(&id) {
+                    self.active = self.first_shown_id();
+                }
+                self.interactive_resize_end(Some(&id));
+            }
+            MinimizeEvent::Activate(id) => {
+                let Some(idx) = self.idx_of(&id) else {
+                    return;
+                };
+                self.data[idx].visibility = Visibility::Shown;
+                self.tiles[idx]
+                    .window_mut()
+                    .set_free_state(self.workspace_is_free, false);
+                self.raise_window(idx, 0);
+                self.active = FloatActive::Window(id);
+                self.bring_up_descendants_of(0);
+            }
+            MinimizeEvent::Removed(id) => {
+                if self.tiles.is_empty() {
+                    self.active = FloatActive::NoneShown;
+                } else if self.active.as_id() == Some(&id) {
+                    self.active = self.first_shown_id();
+                }
+            }
+            MinimizeEvent::Added { id, activate } => {
+                if let Some(idx) = self.idx_of(&id) {
+                    self.data[idx].visibility = Visibility::Shown;
+                    self.tiles[idx]
+                        .window_mut()
+                        .set_free_state(self.workspace_is_free, false);
+                }
+                if activate || matches!(self.active, FloatActive::NoneShown) {
+                    self.active = FloatActive::Window(id);
+                }
+            }
+            MinimizeEvent::EnterFree => {
+                self.workspace_is_free = true;
+                for (tile, data) in zip(&mut self.tiles, &self.data) {
+                    tile.window_mut()
+                        .set_free_state(true, data.visibility == Visibility::Minimized);
+                }
+            }
+            MinimizeEvent::LeaveFree => {
+                self.workspace_is_free = false;
+                for (tile, data) in zip(&mut self.tiles, &mut self.data) {
+                    data.visibility = Visibility::Shown;
+                    tile.window_mut().set_free_state(false, false);
+                }
+                if matches!(self.active, FloatActive::NoneShown) {
+                    self.active = self.first_shown_id();
+                }
+            }
+        }
+    }
+
+    pub fn park(&mut self, id: &W::Id) {
+        self.apply_minimize(MinimizeEvent::Minimize(id.clone()));
+    }
+
+    pub fn enter_free(&mut self) {
+        self.apply_minimize(MinimizeEvent::EnterFree);
+    }
+
+    pub fn unpark_all(&mut self) {
+        self.apply_minimize(MinimizeEvent::LeaveFree);
+    }
+}
