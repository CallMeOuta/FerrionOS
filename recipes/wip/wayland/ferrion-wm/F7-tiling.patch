+
+    pub fn tile_rect(
+        &self,
+        target: WindowTile,
+        size: Size<f64, Logical>,
+    ) -> Rectangle<f64, Logical> {
+        let area = self.working_area;
+        let (w, h) = (area.size.w, area.size.h);
+        let (x, y, tile_w, tile_h) = match target {
+            WindowTile::LeftHalf => (0., 0., w / 2., h),
+            WindowTile::RightHalf => (w / 2., 0., w / 2., h),
+            WindowTile::TopHalf => (0., 0., w, h / 2.),
+            WindowTile::BottomHalf => (0., h / 2., w, h / 2.),
+            WindowTile::TopLeft => (0., 0., w / 2., h / 2.),
+            WindowTile::TopRight => (w / 2., 0., w / 2., h / 2.),
+            WindowTile::BottomLeft => (0., h / 2., w / 2., h / 2.),
+            WindowTile::BottomRight => (w / 2., h / 2., w / 2., h / 2.),
+            WindowTile::Fill => (0., 0., w, h),
+            WindowTile::Center => {
+                let loc = center_preferring_top_left_in_area(area, size);
+                return Rectangle::new(loc, size);
+            }
+        };
+        Rectangle::new(area.loc + Point::from((x, y)), Size::from((tile_w, tile_h)))
+    }
+
+    pub fn tile_of(&self, id: &W::Id) -> Option<WindowTile> {
+        let idx = self.idx_of(id)?;
+        match self.tiles[idx].free_geometry {
+            FreeGeometry::Placed => None,
+            FreeGeometry::Tiled { target, .. } => Some(target),
+        }
+    }
+
+    fn apply_tile_target(&mut self, idx: usize, id: &W::Id, target: WindowTile, animate: bool) {
+        let rect = self.tile_rect(target, self.data[idx].size);
+        if target != WindowTile::Center {
+            let area = self.working_area.size;
+            let width = rect.size.w / f64::max(area.w, 1.) * 100.;
+            let height = rect.size.h / f64::max(area.h, 1.) * 100.;
+            self.set_window_width_raw(id, SizeChange::SetProportion(width), animate);
+            self.set_window_height_raw(id, SizeChange::SetProportion(height), animate);
+        }
+        self.move_to(idx, rect.loc, animate);
+    }
+
+    pub(super) fn transition_geometry(&mut self, id: &W::Id, event: GeomEvent) {
+        let Some(idx) = self.idx_of(id) else {
+            return;
+        };
+        match event {
+            GeomEvent::Tile(target) => {
+                let restore = match self.tiles[idx].free_geometry {
+                    FreeGeometry::Tiled { restore, .. } => restore,
+                    FreeGeometry::Placed => {
+                        let win = self.tiles[idx].window();
+                        TileRestore {
+                            pos: self.data[idx].pos,
+                            size: win.expected_size().unwrap_or_else(|| win.size()),
+                        }
+                    }
+                };
+                self.tiles[idx].free_geometry = FreeGeometry::Tiled { target, restore };
+                self.apply_tile_target(idx, id, target, true);
+            }
+            GeomEvent::Untile => {
+                let FreeGeometry::Tiled { restore, .. } = self.tiles[idx].free_geometry else {
+                    return;
+                };
+                self.tiles[idx].free_geometry = FreeGeometry::Placed;
+                self.tiles[idx]
+                    .window_mut()
+                    .request_size_once(restore.size, true);
+                let pos = self.scale_by_working_area(restore.pos);
+                self.move_to(idx, pos, true);
+            }
+            GeomEvent::UserMovedOrResized => {
+                self.tiles[idx].free_geometry = FreeGeometry::Placed;
+            }
+            GeomEvent::WorkingAreaChanged => {
+                if let FreeGeometry::Tiled { target, .. } = self.tiles[idx].free_geometry {
+                    self.apply_tile_target(idx, id, target, false);
+                }
+            }
+        }
+    }
+
+    pub fn tile_window(&mut self, id: &W::Id, target: WindowTile) {
+        self.transition_geometry(id, GeomEvent::Tile(target));
+    }
+
+    pub fn untile_window(&mut self, id: &W::Id) {
+        self.transition_geometry(id, GeomEvent::Untile);
+    }
 }
