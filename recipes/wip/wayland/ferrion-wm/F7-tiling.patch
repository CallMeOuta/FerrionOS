+// ferrion-wm 2026-11-21 (F7): where a window of a free workspace is tiled.
+/// Where a window of a free workspace is tiled, in its working area.
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq)]
+#[cfg_attr(feature = "json-schema", derive(schemars::JsonSchema))]
+pub enum WindowTile {
+    /// The left half.
+    LeftHalf,
+    /// The right half.
+    RightHalf,
+    /// The top half.
+    TopHalf,
+    /// The bottom half.
+    BottomHalf,
+    /// The top left quarter.
+    TopLeft,
+    /// The top right quarter.
+    TopRight,
+    /// The bottom left quarter.
+    BottomLeft,
+    /// The bottom right quarter.
+    BottomRight,
+    /// The whole working area, which leaves the bar and the dock.
+    Fill,
+    /// The middle, at the window's own size.
+    Center,
+}
+
+impl FromStr for WindowTile {
+    type Err = &'static str;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "left-half" => Ok(Self::LeftHalf),
+            "right-half" => Ok(Self::RightHalf),
+            "top-half" => Ok(Self::TopHalf),
+            "bottom-half" => Ok(Self::BottomHalf),
+            "top-left" => Ok(Self::TopLeft),
+            "top-right" => Ok(Self::TopRight),
+            "bottom-left" => Ok(Self::BottomLeft),
+            "bottom-right" => Ok(Self::BottomRight),
+            "fill" => Ok(Self::Fill),
+            "center" => Ok(Self::Center),
+            _ => Err(
+                r#"invalid window tile, can be "left-half", "right-half", "top-half", "bottom-half", "top-left", "top-right", "bottom-left", "bottom-right", "fill" or "center""#,
+            ),
+        }
+    }
+}
