+/// Tiles a floating window of a free workspace and returns it, and checks that it went to the
+/// target's place and came back to the place and size it had.
+pub(super) fn tile_and_return_check(
+    layout: &mut Layout<TestWindow>,
+    id: usize,
+    target: niri_ipc::WindowTile,
+) {
+    let Some(ws) = layout
+        .workspaces()
+        .map(|(_, _, ws)| ws)
+        .find(|ws| ws.has_window(&id))
+    else {
+        return;
+    };
+    let floating = ws.floating();
+    if !ws.is_free() || floating.is_parked(&id) || floating.tile_of(&id).is_some() {
+        return;
+    }
+    let Some((tile, pos)) = floating
+        .tiles_with_offsets()
+        .find(|(tile, _)| *tile.window().id() == id)
+    else {
+        return;
+    };
+    let ws_id = ws.id();
+    let rect = floating.tile_rect(target, tile.tile_size());
+    let win = tile.window();
+    let size = win.expected_size().unwrap_or_else(|| win.size());
+
+    let floating_pos_of = |layout: &Layout<TestWindow>| {
+        let (_, ws) = layout.find_workspace_by_id(ws_id).unwrap();
+        floating_pos(ws, id)
+    };
+
+    layout.tile_floating_window(Some(&id), target);
+    layout.verify_invariants();
+    let tiled = floating_pos_of(layout);
+    approx::assert_abs_diff_eq!(tiled.x, rect.loc.x, epsilon = 1e-3);
+    approx::assert_abs_diff_eq!(tiled.y, rect.loc.y, epsilon = 1e-3);
+
+    layout.untile_floating_window(Some(&id));
+    let back = floating_pos_of(layout);
+    approx::assert_abs_diff_eq!(back.x, pos.x, epsilon = 1e-3);
+    approx::assert_abs_diff_eq!(back.y, pos.y, epsilon = 1e-3);
+    let (_, win) = layout.windows().find(|(_, win)| *win.id() == id).unwrap();
+    assert_eq!(win.expected_size(), Some(size));
+}
