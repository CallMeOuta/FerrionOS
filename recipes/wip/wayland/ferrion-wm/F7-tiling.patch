+    /// Where a window of this tile size tiles to in the working area.
+    pub fn tile_rect(
+        &self,
+        target: WindowTile,
+        size: Size<f64, Logical>,
+    ) -> Rectangle<f64, Logical> {
+        let area = self.working_area;
+        let (w, h) = (area.size.w, area.size.h);
+        let (x, y, tile_w, tile_h) = match target {
+            WindowTile::LeftHalf => (0., 0., w / 2., h),
+            WindowTile::RightHalf => (w / 2., 0., w / 2., h),
+            WindowTile::TopHalf => (0., 0., w, h / 2.),
+            WindowTile::BottomHalf => (0., h / 2., w, h / 2.),
+            WindowTile::TopLeft => (0., 0., w / 2., h / 2.),
+            WindowTile::TopRight => (w / 2., 0., w / 2., h / 2.),
+            WindowTile::BottomLeft => (0., h / 2., w / 2., h / 2.),
+            WindowTile::BottomRight => (w / 2., h / 2., w / 2., h / 2.),
+            WindowTile::Fill => (0., 0., w, h),
+            WindowTile::Center => {
+                let loc = center_preferring_top_left_in_area(area, size);
+                return Rectangle::new(loc, size);
+            }
+        };
+        Rectangle::new(area.loc + Point::from((x, y)), Size::from((tile_w, tile_h)))
+    }
+
+    /// Where a window is tiled, if it is.
+    pub fn tile_of(&self, id: &W::Id) -> Option<WindowTile> {
+        let idx = self.idx_of(id)?;
+        self.data[idx].tiled.map(|tiled| tiled.target)
+    }
+
+    /// Tiles a window, and the first time remembers the place and size it had.
+    pub fn tile_window(&mut self, id: &W::Id, target: WindowTile) {
+        let Some(idx) = self.idx_of(id) else {
+            return;
+        };
+
+        let data = self.data[idx];
+        let win = self.tiles[idx].window();
+        let tiled = match data.tiled {
+            Some(tiled) => Tiled { target, ..tiled },
+            None => Tiled {
+                target,
+                pos: data.pos,
+                size: win.expected_size().unwrap_or_else(|| win.size()),
+            },
+        };
+        self.data[idx].tiled = Some(tiled);
+
+        let rect = self.tile_rect(target, data.size);
+        if target != WindowTile::Center {
+            let area = self.working_area.size;
+            let width = rect.size.w / f64::max(area.w, 1.) * 100.;
+            let height = rect.size.h / f64::max(area.h, 1.) * 100.;
+            self.set_window_width(Some(id), SizeChange::SetProportion(width), true);
+            self.set_window_height(Some(id), SizeChange::SetProportion(height), true);
+        }
+        self.move_to(idx, rect.loc, true);
+    }
+
+    /// Returns a tiled window to the place and size it had.
+    pub fn untile_window(&mut self, id: &W::Id) {
+        let Some(idx) = self.idx_of(id) else {
+            return;
+        };
+        let Some(tiled) = self.data[idx].tiled.take() else {
+            return;
+        };
+
+        self.tiles[idx]
+            .window_mut()
+            .request_size_once(tiled.size, true);
+        let pos = self.scale_by_working_area(tiled.pos);
+        self.move_to(idx, pos, true);
+    }
