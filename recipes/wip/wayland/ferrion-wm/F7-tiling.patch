+    /// The floating window of a free workspace that a tiling action means, unless minimized.
+    fn free_tiling_target(&self, id: Option<&W::Id>) -> Option<W::Id> {
+        if !self.is_free() {
+            return None;
+        }
+        let id = match id {
+            Some(id) => id.clone(),
+            None if self.floating_is_active.get() => self.floating.active_window()?.id().clone(),
+            None => return None,
+        };
+        (self.floating.has_window(&id) && !self.floating.is_parked(&id)).then_some(id)
+    }
+
+    /// Tiles a floating window of a free workspace.
+    pub fn tile_window(&mut self, id: Option<&W::Id>, target: WindowTile) {
+        if let Some(id) = self.free_tiling_target(id) {
+            self.floating.tile_window(&id, target);
+        }
+    }
+
+    /// Returns a tiled window of a free workspace to the place and size it had.
+    pub fn untile_window(&mut self, id: Option<&W::Id>) {
+        if let Some(id) = self.free_tiling_target(id) {
+            self.floating.untile_window(&id);
+        }
+    }
+
+    /// The move keys of a free workspace, with the floating window focused: tile to a target, or
+    /// with `None` return. Gives `None` back where niri's own move applies.
+    pub(super) fn free_move(&mut self, tile: Option<WindowTile>) -> Option<bool> {
+        if !self.is_free() || !self.floating_is_active.get() {
+            return None;
+        }
+        match tile {
+            Some(target) => self.tile_window(None, target),
+            None => self.untile_window(None),
+        }
