input {
    keyboard { xkb { layout "us"; }; }
}
output "Virtual-1" { scale 1; }
output "Virtual-2" { scale 1; }
output "Unknown-1" { scale 1; }
layout {
    workspace-mode "columns"
    gaps 12
    center-focused-column "never"
    focus-ring { off; }
    border {
        on
        width 1
        active-color "#7e7c7a"
        inactive-color "#2e2d2b"
    }
    shadow { off; }
    background-color "#0f0e0c"
    struts { top 44; }
}
animations { off; }
hotkey-overlay { skip-at-startup; }
prefer-no-csd
xwayland-satellite { off; }
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}
window-rule {
    match app-id="^ferrion-desktop-files$"
    default-column-width { fixed 409; }
}
window-rule {
    match app-id="^ferrion-desktop-editor$"
    default-column-width { fixed 620; }
}
window-rule {
    match app-id="^ferrion-desktop-terminal$"
    default-column-width { fixed 209; }
}
binds {
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit skip-confirmation=true; }
}
