From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FerrionOS contributors <contributors@ferrion.invalid>
Date: Sun, 22 Nov 2026 22:27:00 -0800
Subject: [PATCH] spawning: Scrub inherited fds and env from children

Ensure children spawned by key bindings, IPC or autostart never inherit
FERRION_INPUT_CONSUMER_FD, INIT_NOTIFY or any non-CLOEXEC descriptor
above stderr.
---
diff --git a/src/utils/spawning.rs b/src/utils/spawning.rs
index 5573308..e5c78e7 100644
--- a/src/utils/spawning.rs
+++ b/src/utils/spawning.rs
@@ -1,3 +1,4 @@
+// Modified for FerrionOS on 2026-11-22; GPL-3.0-or-later (niri).
 use std::ffi::OsStr;
 use std::os::unix::process::CommandExt;
 use std::path::Path;
@@ -17,6 +18,7 @@ pub static REMOVE_ENV_RUST_BACKTRACE: AtomicBool = AtomicBool::new(false);
 pub static REMOVE_ENV_RUST_LIB_BACKTRACE: AtomicBool = AtomicBool::new(false);
 pub static CHILD_ENV: RwLock<Environment> = RwLock::new(Environment(Vec::new()));
 pub static CHILD_DISPLAY: RwLock<Option<String>> = RwLock::new(None);
+const MAX_SCRUB_FD: libc::c_int = 1024;
 
 static ORIGINAL_NOFILE_RLIMIT_CUR: Atomic<rlim_t> = Atomic::new(0);
 static ORIGINAL_NOFILE_RLIMIT_MAX: Atomic<rlim_t> = Atomic::new(0);
@@ -148,13 +150,26 @@ fn spawn_sync(
         }
     }
     drop(env);
+    process.env_remove("INIT_NOTIFY");
+    process.env_remove("FERRION_INPUT_CONSUMER_FD");
 
     if let Some(token) = token.as_ref() {
         process.env("XDG_ACTIVATION_TOKEN", token.as_str());
         process.env("DESKTOP_STARTUP_ID", token.as_str());
     }
 
-    unsafe { process.pre_exec(crate::utils::signals::unblock_all) };
+    unsafe {
+        process.pre_exec(|| {
+            crate::utils::signals::unblock_all()?;
+            for fd in 3..MAX_SCRUB_FD {
+                let flags = libc::fcntl(fd, libc::F_GETFD);
+                if flags >= 0 && (flags & libc::FD_CLOEXEC) == 0 {
+                    let _ = libc::fcntl(fd, libc::F_SETFD, flags | libc::FD_CLOEXEC);
+                }
+            }
+            Ok(())
+        });
+    }
 
     let Some(mut child) = do_spawn(command, process) else {
         return;
