FerrionOS: Link desktop OpenGL and EGL after the SDL2 migration.
Source: https://github.com/sezero/quakespasm at cc32abe09ed417ce3be10af300d2dc2f686349ba, after redox.patch.

--- a/Makefile
+++ b/Makefile
@@ -179,7 +179,7 @@
 ifeq ($(HOST_OS),haiku)
 COMMON_LIBS= -lGL
 else ifeq ($(HOST_OS),redox)
-COMMON_LIBS= -lorbital $(shell $(PKG_CONFIG) --libs osmesa zlib)
+COMMON_LIBS= -lorbital $(shell $(PKG_CONFIG) --libs opengl egl zlib)
 else
 COMMON_LIBS= -lGL -lm
 endif
