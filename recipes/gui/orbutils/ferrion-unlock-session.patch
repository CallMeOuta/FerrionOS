+fn unlocked_login(launcher_cmd: &str, launcher_args: &[String]) -> Option<(Command, String)> {
+    let output = Command::new("unlock-session").output().ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    let username = str::from_utf8(&output.stdout).ok()?.trim().to_string();
+    let sys_users = AllUsers::authenticator(Config::default()).ok()?;
+    let user = sys_users.get_by_name(&username)?;
+    let mut command = user.login_cmd(launcher_cmd);
+    command.args(launcher_args);
+    Some((command, user.user.clone()))
+}
